<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>

		<key>LSRequiresIPhoneOS</key>
		<true/>

		<key>UIDeviceFamily</key>
		<array>
			<integer>1</integer>
			<integer>2</integer>
		</array>

		<key>UIRequiredDeviceCapabilities</key>
		<array>
			<string>arm64</string>
		</array>

		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>

		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>

		<key>XSAppIconAssets</key>
		<string>Assets.xcassets/appicon.appiconset</string>

		<key>NSBluetoothAlwaysUsageDescription</key>
		<string>Bluetooth is used to discover and connect to a compatible BLE OBD-II adapter.</string>

		<key>NSBluetoothPeripheralUsageDescription</key>
		<string>Bluetooth is used to communicate with a compatible BLE OBD-II adapter.</string>

		<key>NSLocationWhenInUseUsageDescription</key>
		<string>GPS speed is compared with the car's speed while you measure 0–100, 0–60 or ¼ mile, so ranking results can be trusted. While a fuel/energy trip is recording, location keeps the trip running when the app is in the background.</string>
		<key>NSCameraUsageDescription</key>
		<string>The camera is used to scan a VIN and record verified acceleration videos.</string>

		<key>NSMicrophoneUsageDescription</key>
		<string>The microphone can record sound when the user records an acceleration video.</string>

		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>Finished acceleration videos are saved to the photo library when the user requests it.</string>

		<key>NSLocalNetworkUsageDescription</key>
		<string>The local network is used to connect directly to a Wi-Fi OBD-II adapter.</string>

		<key>UIBackgroundModes</key>
		<array>
			<string>bluetooth-central</string>
			<string>location</string>
		</array>

		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>

	</dict>
</plist>
