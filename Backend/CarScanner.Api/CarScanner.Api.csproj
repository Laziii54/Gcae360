<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.14.0" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- One rule set for what may be collected: the phone and the server use the same sanitizer. -->
    <Compile Include="../../Services/DataCollection/CollectionSanitizer.cs" Link="Shared/CollectionSanitizer.cs" />
    <Compile Include="../../Services/OBD/ObdExchangeTap.cs" Link="Shared/ObdExchangeTap.cs" />
    <Compile Include="../../Services/EmailAddressRules.cs" Link="Shared/EmailAddressRules.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same bundled catalog the app ships (Brotli-compressed); unpacked once on first request
         into the durable data directory, read-only, never rewritten here. -->
    <Content Include="../../Resources/Raw/DtcCatalog.sqlite.br" Link="DtcCatalog.sqlite.br" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CarScanner.Tests" />
  </ItemGroup>
</Project>
