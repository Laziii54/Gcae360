<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- One rule set for what may be collected: the phone and the server use the same sanitizer. -->
    <Compile Include="../../Services/DataCollection/CollectionSanitizer.cs" Link="Shared/CollectionSanitizer.cs" />
    <Compile Include="../../Services/OBD/ObdExchangeTap.cs" Link="Shared/ObdExchangeTap.cs" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CarScanner.Tests" />
  </ItemGroup>
</Project>
