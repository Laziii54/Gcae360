<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CarScanner.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- Ranking review videos (up to 80 MB); IIS allows 30 MB by default. -->
          <requestLimits maxAllowedContentLength="88080384" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
