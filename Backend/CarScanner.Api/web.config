<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\CarScanner.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <!-- IIS ceiling for every request: 84 MB, so the ranking review videos
               (up to 80 MB + form overhead, POST /api/acceleration/leaderboard/{id}/video)
               get through. A separate <location> for that path made IIS answer 404
               for /api/acceleration/leaderboard before the app was reached, so the
               limit lives here. Other routes keep ASP.NET Core's own 30 MB default
               body limit; only the video route raises it in code. -->
          <requestLimits maxAllowedContentLength="88080384" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
