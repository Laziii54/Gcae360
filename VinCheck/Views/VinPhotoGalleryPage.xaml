<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="CarScanner.VinCheck.Views.VinPhotoGalleryPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CarScanner.Controls" BackgroundColor="#050505" xmlns:vc="clr-namespace:CarScanner.VinCheck" Shell.NavBarIsVisible="False">
<ContentPage.Resources>
<vc:VinCheckResources />
</ContentPage.Resources>
<Grid RowDefinitions="64,*,64">
<Grid Padding="12" ColumnDefinitions="Auto,*">
<controls:IconButton Kind="close" Tint="White" Clicked="CloseClicked" BackgroundColor="#44000000" StrokeThickness="0" StrokeShape="RoundRectangle 20" WidthRequest="42" HeightRequest="42" IconSize="18" SemanticProperties.Description="Close" />
<Label x:Name="Counter" Grid.Column="1" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontAttributes="Bold"/>
</Grid>
<CarouselView x:Name="Gallery" Grid.Row="1" PositionChanged="PositionChanged" Loop="False">
<CarouselView.ItemTemplate>
<DataTemplate>
<Grid>
<Image Source="{Binding}" Aspect="AspectFit">
<Image.GestureRecognizers>
<PinchGestureRecognizer PinchUpdated="PinchUpdated"/>
<TapGestureRecognizer NumberOfTapsRequired="2" Tapped="DoubleTapped"/>
</Image.GestureRecognizers>
</Image>
</Grid>
</DataTemplate>
</CarouselView.ItemTemplate>
</CarouselView>
<Grid Grid.Row="2" ColumnDefinitions="*,*" Padding="18,6" ColumnSpacing="18">
<controls:IconButton Kind="chevron-left" Tint="White" Clicked="PreviousClicked" BackgroundColor="#33222222" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="40" HeightRequest="40" SemanticProperties.Description="Previous photo" />
<controls:IconButton Grid.Column="1" Kind="chevron-right" Tint="White" Clicked="NextClicked" BackgroundColor="#33222222" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="40" HeightRequest="40" SemanticProperties.Description="Next photo" />
</Grid>
</Grid>
</ContentPage>
