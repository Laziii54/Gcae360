<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="CarScanner.VinCheck.Views.VinScanPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CarScanner.Controls"
             Shell.NavBarIsVisible="False"
             BackgroundColor="Black">

    <Grid>
        <!-- Live camera -->
        <controls:PerformanceCameraView x:Name="CameraView" />

        <!-- Dim everything except the VIN frame -->
        <Grid RowDefinitions="*,110,*" ColumnDefinitions="20,*,20" InputTransparent="True">
            <BoxView Grid.ColumnSpan="3" Color="#99000000" />
            <BoxView Grid.Row="1" Color="#99000000" />
            <BoxView Grid.Row="1" Grid.Column="2" Color="#99000000" />
            <BoxView Grid.Row="2" Grid.ColumnSpan="3" Color="#99000000" />
            <Border x:Name="ScanFrame" Grid.Row="1" Grid.Column="1" Stroke="White" StrokeThickness="3"
                    StrokeShape="RoundRectangle 12" BackgroundColor="Transparent" />
        </Grid>

        <!-- Top bar -->
        <Grid RowDefinitions="Auto,*,Auto" Padding="18,48,18,40">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Text="✕" Clicked="OnCloseClicked" BackgroundColor="#66000000" TextColor="White"
                        FontSize="18" CornerRadius="22" WidthRequest="44" HeightRequest="44" Padding="0" />
                <Label x:Name="TitleLabel" Grid.Column="1" TextColor="White" FontSize="17" FontAttributes="Bold"
                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                <Grid Grid.Column="2" WidthRequest="44" HeightRequest="44">
                    <Button x:Name="TorchButton" Text="" Clicked="OnTorchClicked" BackgroundColor="#66000000"
                            CornerRadius="22" WidthRequest="44" HeightRequest="44" Padding="0" />
                    <Path Data="M7,2 L17,2 L17,6 L14,11 L14,22 L10,22 L10,11 L7,6 Z M7,6 L17,6 M12,14 L12,16" Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="20" HeightRequest="20" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"
                          IsVisible="{Binding IsVisible, Source={x:Reference TorchButton}}" />
                </Grid>
            </Grid>

            <!-- Hint + status under the frame -->
            <VerticalStackLayout Grid.Row="2" Spacing="10" HorizontalOptions="Center">
                <Border x:Name="StatusPill" BackgroundColor="#CC0B1F44" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        Padding="16,8" HorizontalOptions="Center">
                    <HorizontalStackLayout Spacing="8">
                        <ActivityIndicator x:Name="Spinner" IsRunning="True" Color="White" WidthRequest="18" HeightRequest="18" />
                        <Label x:Name="StatusLabel" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
                <Label x:Name="HintLabel" TextColor="#E2E8F0" FontSize="13" HorizontalTextAlignment="Center" Margin="12,0" />
                <Button x:Name="SettingsButton" IsVisible="False" Clicked="OnSettingsClicked" BackgroundColor="#1D5BD6"
                        TextColor="White" CornerRadius="14" HeightRequest="46" Padding="18,0" />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
