<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="CarScanner.VinCheck.Views.VinHistoryPage" x:Name="Page" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:controls="clr-namespace:CarScanner.Controls" xmlns:vc="clr-namespace:CarScanner.VinCheck" Shell.NavBarIsVisible="False" BackgroundColor="{DynamicResource PageBg}">
<ContentPage.Resources>
<vc:VinCheckResources />
</ContentPage.Resources>
<Grid RowDefinitions="Auto,*">
<!-- Top bar -->
<Grid Padding="16,12,16,4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
<controls:IconButton Kind="chevron-left" Clicked="BackClicked" WidthRequest="40" HeightRequest="40" IconSize="20" StrokeShape="RoundRectangle 12" SemanticProperties.Description="Back" />
<Label Grid.Column="1" Text="{Binding Title}" Style="{StaticResource PageTitleStyle}" FontSize="19" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"/>
<Border Grid.Column="2" WidthRequest="40" HeightRequest="40" Padding="0" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
<Border.GestureRecognizers>
<TapGestureRecognizer Command="{Binding ClearCommand}"/>
</Border.GestureRecognizers>
<Path Data="M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 L17,20 L18,7 M10,11 L10,16 M14,11 L14,16" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" InputTransparent="True"/>
</Border>
</Grid>
<ScrollView Grid.Row="1">
<VerticalStackLayout Padding="16,8,16,36" Spacing="10">
<!-- Favorites -->
<Label Text="{Binding FavoritesText}" Style="{StaticResource SectionCaptionStyle}"/>
<FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding Favorites}">
<BindableLayout.ItemTemplate>
<DataTemplate>
<Border Style="{StaticResource ListCardStyle}" Margin="0,0,10,10" WidthRequest="160">
<Grid RowDefinitions="96,Auto">
<Image Source="{Binding ImageUrl}" Aspect="AspectFill"/>
<VerticalStackLayout Grid.Row="1" Padding="12,10,12,12" Spacing="1">
<Label Text="{Binding Make}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation"/>
<Label Text="{Binding Model}" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation"/>
<Label Text="{Binding Vin}" FontSize="12" FontFamily="monospace" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation"/>
<Button Text="{Binding Source={x:Reference Page},Path=BindingContext.OpenText}" Command="{Binding Source={x:Reference Page},Path=BindingContext.OpenFavoriteCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="10" HeightRequest="36" MinimumHeightRequest="36" Padding="0" FontSize="13" Margin="0,8,0,0"/>
</VerticalStackLayout>
</Grid>
</Border>
</DataTemplate>
</BindableLayout.ItemTemplate>
</FlexLayout>
<!-- History list -->
<Label Text="{Binding Title}" Style="{StaticResource SectionCaptionStyle}"/>
<Border Style="{StaticResource ListCardStyle}">
<Border.Triggers>
<DataTrigger TargetType="Border" Binding="{Binding History.Count}" Value="0">
<Setter Property="IsVisible" Value="False"/>
</DataTrigger>
</Border.Triggers>
<VerticalStackLayout BindableLayout.ItemsSource="{Binding History}" Spacing="0" Margin="0,-1,0,0">
<BindableLayout.ItemTemplate>
<DataTemplate>
<VerticalStackLayout Spacing="0">
<BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" Margin="14,0,0,0"/>
<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="14,10,6,10">
<Border WidthRequest="56" HeightRequest="48" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="{DynamicResource PageBg}" VerticalOptions="Center">
<Image Source="{Binding ThumbnailUrl}" HeightRequest="48" WidthRequest="56" Aspect="AspectFill"/>
</Border>
<VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
<Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="14" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation"/>
<Label Text="{Binding Year}" FontSize="12" TextColor="{DynamicResource SubTextColor}"/>
<Label Text="{Binding Vin}" FontSize="12" FontFamily="monospace" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation"/>
<Label Text="{Binding DateText}" FontSize="12" TextColor="{DynamicResource SubTextColor}"/>
</VerticalStackLayout>
<controls:IconButton Grid.Column="2" Kind="close" Plain="True" Tint="#B3361F" Command="{Binding Source={x:Reference Page},Path=BindingContext.DeleteCommand}" CommandParameter="{Binding .}" WidthRequest="36" HeightRequest="40" IconSize="16" VerticalOptions="Center" SemanticProperties.Description="Delete" />
<controls:IconButton Grid.Column="3" Kind="chevron-right" Plain="True" Tint="{DynamicResource SubTextColor}" Command="{Binding Source={x:Reference Page},Path=BindingContext.OpenHistoryCommand}" CommandParameter="{Binding .}" WidthRequest="36" HeightRequest="40" IconSize="16" VerticalOptions="Center" SemanticProperties.Description="Open" />
</Grid>
</VerticalStackLayout>
</DataTemplate>
</BindableLayout.ItemTemplate>
</VerticalStackLayout>
</Border>
</VerticalStackLayout>
</ScrollView>
</Grid>
</ContentPage>
