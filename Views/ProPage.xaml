<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.ProPage"
    x:DataType="vm:ProViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding PageTitleText}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">

            <!-- Intro card -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,13">
                <VerticalStackLayout Spacing="4">
                    <Label Text="GCar360 PRO" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                    <Label Text="{Binding ProSubtitleText}" FontSize="13" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Current plan -->
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M6,11 L18,11 L18,21 L6,21 Z M8.5,11 L8.5,7.5 C8.5,3.5 15.5,3.5 15.5,7.5 L15.5,11" Style="{StaticResource RowIconStyle}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding CurrentPlanTitleText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                            <Label Text="{Binding CurrentPlanText}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding VinQuotaText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Button
                        x:Name="AccountButton"
                        Clicked="OnAccountClicked"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}"
                        BorderWidth="0"
                        FontAttributes="Bold"
                        FontSize="14"
                        CornerRadius="0"
                        HeightRequest="46" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding PlansTitleText}" Style="{StaticResource SectionCaptionStyle}" />

            <!-- PLANS: OBD PRO / VIN PRO / FULL PRO -->
            <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Plans}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProPlanItem">
                        <!-- Stroke stays bound: highlights the selected / recommended plan -->
                        <Border
                            Padding="14,13"
                            BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{Binding StrokeColor}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                <Path Data="M5,12 L9,16 L19,6" Style="{StaticResource RowIconStyle}" VerticalOptions="Start" Margin="0,2,0,0" />
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End" VerticalOptions="Center">
                                    <Border IsVisible="{Binding HasBadge}" Style="{StaticResource ProBadgeStyle}" HorizontalOptions="End">
                                        <Label Text="{Binding BadgeText}" Style="{StaticResource ProBadgeTextStyle}" />
                                    </Border>
                                    <Label Text="{Binding ButtonText}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End" TextColor="{DynamicResource Primary}" />
                                </VerticalStackLayout>
                                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Features}" FontSize="12" LineHeight="1.25" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Restore purchase -->
            <Button
                Text="{Binding RestorePurchaseText}"
                Command="{Binding RestoreCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource TextColor}"
                BorderColor="{DynamicResource TextColor}"
                BorderWidth="1.5"
                CornerRadius="12"
                HeightRequest="48"
                FontAttributes="Bold" />

            <!-- Promo code -->
            <Label Text="{Binding PromoTitleText}" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}" Padding="14,4">
                <Entry
                    Text="{Binding Promo}"
                    Placeholder="{Binding PromoPlaceholderText}"
                    TextColor="{DynamicResource TextColor}"
                    PlaceholderColor="{DynamicResource SubTextColor}"
                    BackgroundColor="Transparent"
                    FontSize="14" />
            </Border>
            <Button
                Text="{Binding ActivatePromoText}"
                Command="{Binding RedeemCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource TextColor}"
                BorderColor="{DynamicResource TextColor}"
                BorderWidth="1.5"
                CornerRadius="12"
                HeightRequest="48"
                FontAttributes="Bold" />

            <!-- Loading / status -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" HorizontalOptions="Center" />
            <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="12" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

            <!-- Subscription information -->
            <Label Text="{Binding SubscriptionInfoText}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="4,4,4,0" />

            <!-- Privacy / terms -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{Binding PrivacyPolicyText}" Command="{Binding PrivacyPolicyCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" FontSize="11" />
                <Button Grid.Column="1" Text="{Binding TermsOfUseText}" Command="{Binding TermsOfUseCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" FontSize="11" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
