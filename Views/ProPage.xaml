<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.ProPage"
    x:DataType="vm:ProViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding PageTitleText}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="10">

            <!-- Plans, one per row: PRO · VIN PRO · Full PRO · Free. Tap a card to buy (iPhone) or sign in (Android). -->
            <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Plans}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProPlanItem">
                        <Border
                            Padding="14,13"
                            BackgroundColor="{DynamicResource CardBg}"
                            Stroke="{Binding StrokeColor}"
                            StrokeThickness="1.5"
                            StrokeShape="RoundRectangle 16">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding x:DataType=vm:ProViewModel, Source={RelativeSource AncestorType={x:Type vm:ProViewModel}}, Path=OpenPlanCommand}" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                                    <Border IsVisible="{Binding HasTag}" BackgroundColor="{Binding TagBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,2" VerticalOptions="Center">
                                        <Label Text="{Binding TagText}" TextColor="{Binding TagTextColor}" FontSize="12" FontAttributes="Bold" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding PriceText}" IsVisible="{Binding ShowPrice}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                                <Grid Grid.Row="1" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Features}" FontSize="12" LineHeight="1.3" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                    <controls:Icon Grid.Column="1" Kind="chevron-right" IsVisible="{Binding CanOpen}" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" VerticalOptions="End" />
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Monthly automatic payment bought on the website (BOG): status + cancel -->
            <Border IsVisible="{Binding ShowWebSubscription}" Padding="14,13" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Border IsVisible="{Binding ShowWebSubAlert}" Padding="11,9" BackgroundColor="{DynamicResource ErrBg}" Stroke="{DynamicResource ErrStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Label Text="{Binding WebSubAlertText}" FontSize="12" TextColor="{DynamicResource ErrText}" LineBreakMode="WordWrap" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding WebSubTitleText}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Border Grid.Column="1" BackgroundColor="{Binding WebSubStateBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="8,2" VerticalOptions="Center">
                            <Label Text="{Binding WebSubStateText}" TextColor="{Binding WebSubStateColor}" FontSize="12" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding WebSubDetailsText}" FontSize="12" LineHeight="1.3" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    <Button
                        IsVisible="{Binding CanCancelWebSub}"
                        Text="{Binding CancelWebSubText}"
                        Command="{Binding CancelWebSubscriptionCommand}"
                        BackgroundColor="Transparent"
                        TextColor="#B3361F"
                        BorderColor="{DynamicResource ErrStroke}"
                        BorderWidth="1.5"
                        CornerRadius="10"
                        HeightRequest="44"
                        FontAttributes="Bold"
                        FontSize="13" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding VinQuotaText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

            <!-- Loading / status -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" HorizontalOptions="Center" />
            <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="12" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

            <!-- Extra VIN checks: iPhone only, for VIN PRO / Full PRO -->
            <VerticalStackLayout IsVisible="{Binding ShowPacks}" Spacing="8">
                <Label Text="{Binding PacksTitleText}" Style="{StaticResource SectionCaptionStyle}" />
                <Label Text="{Binding PacksHintText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Packs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProPackItem">
                            <Button Text="{Binding ButtonText}" Command="{Binding x:DataType=vm:ProViewModel, Source={RelativeSource AncestorType={x:Type vm:ProViewModel}}, Path=BuyPackCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="10" HeightRequest="44" FontAttributes="Bold" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- Restore (iPhone) / refresh status (Android) -->
            <Button
                Text="{Binding RestorePurchaseText}"
                Command="{Binding RestoreCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource Primary}"
                BorderWidth="0"
                FontAttributes="Bold"
                FontSize="13"
                HeightRequest="40" />

            <!-- Account (sign in / signed-in email) -->
            <Button
                x:Name="AccountButton"
                Clicked="OnAccountClicked"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource Primary}"
                BorderWidth="0"
                FontAttributes="Bold"
                FontSize="13"
                HeightRequest="40" />

            <Label Text="{Binding SubscriptionInfoText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" Margin="4,0" />

            <!-- Privacy / terms -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="{Binding PrivacyPolicyText}" Command="{Binding PrivacyPolicyCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" FontSize="12" />
                <Button Grid.Column="1" Text="{Binding TermsOfUseText}" Command="{Binding TermsOfUseCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" FontSize="12" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
