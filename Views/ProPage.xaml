<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.ProPage"
    x:DataType="vm:ProViewModel"
    Title="{Binding PageTitleText}"
    BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <!--
            Responsive PRO page.

            The breakpoints live in ProViewModel.ApplyLayout (called from the page's
            SizeChanged): the paddings, the content column width, the price and title
            sizes and whether the three plan cards sit in a row or stack all follow the
            real page width. That covers a 320pt iPhone SE, a 430pt Pro Max, a 390pt
            landscape phone and an 820pt iPad without a separate tablet XAML.
        -->
        <VerticalStackLayout
            Padding="{Binding PagePadding}"
            Spacing="{Binding SectionSpacing}"
            MaximumWidthRequest="{Binding PageMaxWidth}"
            HorizontalOptions="Center">

            <Label
                Text="{Binding ProSubtitleText}"
                FontSize="12"
                TextColor="{DynamicResource SubTextColor}"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap" />

            <!-- PRO introduction: tasteful badge, title, short benefit line. -->
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Border
                    WidthRequest="52"
                    HeightRequest="52"
                    Padding="0"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 26"
                    BackgroundColor="{DynamicResource ProBadgeBg}"
                    HorizontalOptions="Center">
                    <controls:Icon
                        Kind="star"
                        Tint="{DynamicResource ProBadgeText}"
                        WidthRequest="24"
                        HeightRequest="24"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
                <Label
                    Text="{Binding ProIntroTitleText}"
                    FontSize="{Binding IntroTitleFontSize}"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextColor}"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    SemanticProperties.HeadingLevel="Level1" />
                <Label
                    Text="{Binding ProIntroDescriptionText}"
                    FontSize="13.5"
                    TextColor="{DynamicResource SubTextColor}"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="WordWrap"
                    MaximumWidthRequest="420" />
            </VerticalStackLayout>

            <!-- ============================================================
                 Plan selector: VIN PRO · OBD PRO · Full PRO (three plans only,
                 no billing-period toggle anywhere on this screen).

                 Regular and wide screens: the three cards share a row.
                 Narrow screens (below ProViewModel.CompactWidth): one full-width
                 row per plan, icon left, name/subtitle in the middle, tick right —
                 the same content, readable at 320pt.
                 ============================================================ -->

            <Grid
                ColumnDefinitions="*,*,*"
                ColumnSpacing="8"
                IsVisible="{Binding IsCompactLayout, Converter={StaticResource InverseBoolConverter}}">

                <Border
                    Grid.Column="0"
                    Padding="8,14,8,12"
                    StrokeThickness="1.5"
                    Stroke="{Binding PaidPlans[0].StrokeColor}"
                    BackgroundColor="{Binding PaidPlans[0].PickerBackground}"
                    StrokeShape="RoundRectangle 16"
                    SemanticProperties.Description="{Binding PaidPlans[0].Title}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPlanCommand}" CommandParameter="{Binding PaidPlans[0]}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="{Binding PaidPlans[0].IconImageSource}" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,0,0,2" IsVisible="{Binding PaidPlans[0].HasIconImage}" />
                        <controls:Icon Kind="{Binding PaidPlans[0].IconKind}" Tint="{Binding PaidPlans[0].IconTint}" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" Margin="0,0,0,2" IsVisible="{Binding PaidPlans[0].HasIconGlyph}" />
                        <controls:Icon Kind="check" Tint="{Binding PaidPlans[0].IconTint}" WidthRequest="13" HeightRequest="13" HorizontalOptions="Center" IsVisible="{Binding PaidPlans[0].IsSelected}" />
                        <Label Text="{Binding PaidPlans[0].Title}" FontSize="13.5" FontAttributes="Bold" TextColor="{Binding PaidPlans[0].CardTitleColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        <Label Text="{Binding PaidPlans[0].Subtitle}" FontSize="12" TextColor="{Binding PaidPlans[0].CardSubtitleColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        <Border IsVisible="{Binding PaidPlans[0].HasTag}" BackgroundColor="{Binding PaidPlans[0].TagBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="7,3" HorizontalOptions="Center" Margin="0,2,0,0">
                            <Label Text="{Binding PaidPlans[0].TagText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding PaidPlans[0].TagTextColor}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="8,14,8,12"
                    StrokeThickness="1.5"
                    Stroke="{Binding PaidPlans[1].StrokeColor}"
                    BackgroundColor="{Binding PaidPlans[1].PickerBackground}"
                    StrokeShape="RoundRectangle 16"
                    SemanticProperties.Description="{Binding PaidPlans[1].Title}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPlanCommand}" CommandParameter="{Binding PaidPlans[1]}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="{Binding PaidPlans[1].IconImageSource}" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,0,0,2" IsVisible="{Binding PaidPlans[1].HasIconImage}" />
                        <controls:Icon Kind="{Binding PaidPlans[1].IconKind}" Tint="{Binding PaidPlans[1].IconTint}" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" Margin="0,0,0,2" IsVisible="{Binding PaidPlans[1].HasIconGlyph}" />
                        <controls:Icon Kind="check" Tint="{Binding PaidPlans[1].IconTint}" WidthRequest="13" HeightRequest="13" HorizontalOptions="Center" IsVisible="{Binding PaidPlans[1].IsSelected}" />
                        <Label Text="{Binding PaidPlans[1].Title}" FontSize="13.5" FontAttributes="Bold" TextColor="{Binding PaidPlans[1].CardTitleColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        <Label Text="{Binding PaidPlans[1].Subtitle}" FontSize="12" TextColor="{Binding PaidPlans[1].CardSubtitleColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        <Border IsVisible="{Binding PaidPlans[1].HasTag}" BackgroundColor="{Binding PaidPlans[1].TagBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="7,3" HorizontalOptions="Center" Margin="0,2,0,0">
                            <Label Text="{Binding PaidPlans[1].TagText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding PaidPlans[1].TagTextColor}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="8,14,8,12"
                    StrokeThickness="1.5"
                    Stroke="{Binding PaidPlans[2].StrokeColor}"
                    BackgroundColor="{Binding PaidPlans[2].PickerBackground}"
                    StrokeShape="RoundRectangle 16"
                    SemanticProperties.Description="{Binding PaidPlans[2].Title}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectPlanCommand}" CommandParameter="{Binding PaidPlans[2]}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="{Binding PaidPlans[2].IconImageSource}" WidthRequest="22" HeightRequest="22" Aspect="AspectFit" HorizontalOptions="Center" Margin="0,0,0,2" IsVisible="{Binding PaidPlans[2].HasIconImage}" />
                        <controls:Icon Kind="{Binding PaidPlans[2].IconKind}" Tint="{Binding PaidPlans[2].IconTint}" WidthRequest="22" HeightRequest="22" HorizontalOptions="Center" Margin="0,0,0,2" IsVisible="{Binding PaidPlans[2].HasIconGlyph}" />
                        <controls:Icon Kind="check" Tint="{Binding PaidPlans[2].IconTint}" WidthRequest="13" HeightRequest="13" HorizontalOptions="Center" IsVisible="{Binding PaidPlans[2].IsSelected}" />
                        <Label Text="{Binding PaidPlans[2].Title}" FontSize="13.5" FontAttributes="Bold" TextColor="{Binding PaidPlans[2].CardTitleColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        <Label Text="{Binding PaidPlans[2].Subtitle}" FontSize="12" TextColor="{Binding PaidPlans[2].CardSubtitleColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                        <Border IsVisible="{Binding PaidPlans[2].HasTag}" BackgroundColor="{Binding PaidPlans[2].TagBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="7,3" HorizontalOptions="Center" Margin="0,2,0,0">
                            <Label Text="{Binding PaidPlans[2].TagText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding PaidPlans[2].TagTextColor}" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <!-- Narrow screens: the same three plans, one readable row each. -->
            <VerticalStackLayout
                Spacing="8"
                IsVisible="{Binding IsCompactLayout}"
                BindableLayout.ItemsSource="{Binding PaidPlans}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProPlanItem">
                        <Border
                            Padding="14,12"
                            StrokeThickness="1.5"
                            Stroke="{Binding StrokeColor}"
                            BackgroundColor="{Binding PickerBackground}"
                            StrokeShape="RoundRectangle 16"
                            SemanticProperties.Description="{Binding Title}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding x:DataType=vm:ProViewModel, Source={RelativeSource AncestorType={x:Type vm:ProViewModel}}, Path=SelectPlanCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                <Image
                                    Grid.Column="0"
                                    Source="{Binding IconImageSource}"
                                    WidthRequest="26"
                                    HeightRequest="26"
                                    Aspect="AspectFit"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasIconImage}" />
                                <controls:Icon
                                    Grid.Column="0"
                                    Kind="{Binding IconKind}"
                                    Tint="{Binding IconTint}"
                                    WidthRequest="26"
                                    HeightRequest="26"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding HasIconGlyph}" />

                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Title}" FontSize="15" FontAttributes="Bold" TextColor="{Binding CardTitleColor}" LineBreakMode="WordWrap" />
                                    <Label Text="{Binding Subtitle}" FontSize="12" TextColor="{Binding CardSubtitleColor}" LineBreakMode="WordWrap" IsVisible="{Binding HasSubtitle}" />
                                    <Border IsVisible="{Binding HasTag}" BackgroundColor="{Binding TagBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="7,3" HorizontalOptions="Start" Margin="0,2,0,0">
                                        <Label Text="{Binding TagText}" FontSize="11.5" FontAttributes="Bold" TextColor="{Binding TagTextColor}" />
                                    </Border>
                                </VerticalStackLayout>

                                <controls:Icon
                                    Grid.Column="2"
                                    Kind="check"
                                    Tint="{Binding IconTint}"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding IsSelected}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Price: the App Store's own localized monthly price for the selected plan.
                 There is no Monthly/Yearly selector, no annual card, no strike-through
                 "was" price and no percentage discount badge on this screen. -->
            <Border
                Padding="18,16"
                StrokeThickness="1"
                Stroke="{DynamicResource BorderColor}"
                BackgroundColor="{DynamicResource CardBg}"
                StrokeShape="RoundRectangle 18">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Label
                        Text="{Binding DisplayPriceText}"
                        FontSize="{Binding PriceFontSize}"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource TextColor}"
                        VerticalOptions="Center"
                        LineBreakMode="WordWrap"
                        HorizontalTextAlignment="Center"
                        Margin="0,-2,0,-4" />
                    <Label
                        Text="{Binding DisplayPeriodText}"
                        FontSize="13"
                        TextColor="{DynamicResource SubTextColor}"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        MaximumWidthRequest="360" />
                    <Label
                        Text="{Binding SelectedPlan.BadgeText}"
                        IsVisible="{Binding SelectedPlan.HasBadge}"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="{DynamicResource ProBadgeText}"
                        HorizontalTextAlignment="Center"
                        Margin="0,2,0,0" />

                    <ActivityIndicator IsRunning="{Binding IsLoadingPrices}" IsVisible="{Binding IsLoadingPrices}" Color="{DynamicResource Primary}" HeightRequest="18" Margin="0,4,0,0" />
                    <Button Text="{Binding RetryPricesText}" Command="{Binding RetryPricesCommand}" IsVisible="{Binding ShowPriceRetry}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderWidth="0" FontAttributes="Bold" FontSize="12.5" HeightRequest="36" />
                </VerticalStackLayout>
            </Border>

            <!-- Benefits for the selected plan -->
            <VerticalStackLayout Spacing="12">
                <Label Text="{Binding PlansTitleText}" Style="{StaticResource SectionTitleStyle}" FontSize="16" />
                <VerticalStackLayout Spacing="11" BindableLayout.ItemsSource="{Binding SelectedPlan.FeatureList}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <HorizontalStackLayout Spacing="10">
                                <Border WidthRequest="22" HeightRequest="22" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 7" BackgroundColor="{DynamicResource InfoBg}" VerticalOptions="Start">
                                    <controls:Icon Kind="check" Tint="{DynamicResource Primary}" WidthRequest="12" HeightRequest="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{Binding .}" FontSize="14" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <!-- CTA -->
            <VerticalStackLayout Spacing="10">
                <Button
                    Text="{Binding CtaButtonText}"
                    Command="{Binding OpenPlanCommand}"
                    CommandParameter="{Binding SelectedPlan}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                    MinimumHeightRequest="{Binding CtaMinHeight}"
                    Padding="16,0"
                    LineBreakMode="WordWrap"
                    CornerRadius="27"
                    BackgroundColor="{DynamicResource Primary}"
                    TextColor="White"
                    FontSize="{Binding CtaFontSize}"
                    FontAttributes="Bold" />

                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" HorizontalOptions="Center" />
                <Label Text="{Binding Status}" TextColor="{Binding StatusColor}" FontSize="12.5" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- Monthly automatic payment bought on the website (BOG): status + cancel -->
            <Border IsVisible="{Binding ShowWebSubscription}" Style="{StaticResource CardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="10">
                    <Border IsVisible="{Binding ShowWebSubAlert}" Padding="12,10" BackgroundColor="{DynamicResource ErrBg}" Stroke="{DynamicResource ErrStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                        <Label Text="{Binding WebSubAlertText}" FontSize="12.5" TextColor="{DynamicResource ErrText}" LineBreakMode="WordWrap" />
                    </Border>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding WebSubTitleText}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Border Grid.Column="1" BackgroundColor="{Binding WebSubStateBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 8" Padding="9,3" VerticalOptions="Center">
                            <Label Text="{Binding WebSubStateText}" TextColor="{Binding WebSubStateColor}" FontSize="12" FontAttributes="Bold" />
                        </Border>
                    </Grid>
                    <Label Text="{Binding WebSubDetailsText}" FontSize="12.5" LineHeight="1.3" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    <Button
                        IsVisible="{Binding CanCancelWebSub}"
                        Text="{Binding CancelWebSubText}"
                        Command="{Binding CancelWebSubscriptionCommand}"
                        BackgroundColor="Transparent"
                        TextColor="{DynamicResource ErrStroke}"
                        BorderColor="{DynamicResource ErrStroke}"
                        BorderWidth="1.5"
                        CornerRadius="10"
                        HeightRequest="46"
                        FontAttributes="Bold"
                        FontSize="13.5" />
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding VinQuotaText}" FontSize="12.5" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

            <!-- Extra VIN checks: iPhone only, for VIN PRO / Full PRO -->
            <VerticalStackLayout IsVisible="{Binding ShowPacks}" Spacing="10">
                <Label Text="{Binding PacksTitleText}" FontSize="13.5" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" />
                <Label Text="{Binding PacksHintText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Packs}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProPackItem">
                            <Button Text="{Binding ButtonText}" Command="{Binding x:DataType=vm:ProViewModel, Source={RelativeSource AncestorType={x:Type vm:ProViewModel}}, Path=BuyPackCommand}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="10" HeightRequest="46" FontAttributes="Bold" LineBreakMode="WordWrap" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

            <!-- Restore (iPhone) / refresh status (Android) -->
            <Button
                Text="{Binding RestorePurchaseText}"
                Command="{Binding RestoreCommand}"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource Primary}"
                BorderWidth="0"
                FontAttributes="Bold"
                FontSize="13.5"
                HeightRequest="46" />

            <!-- Account (sign in / signed-in email) -->
            <Button
                x:Name="AccountButton"
                Text="{Binding AccountButtonText}"
                Clicked="OnAccountClicked"
                BackgroundColor="Transparent"
                TextColor="{DynamicResource Primary}"
                BorderWidth="0"
                FontAttributes="Bold"
                FontSize="13.5"
                HeightRequest="46" />

            <Label Text="{Binding SubscriptionInfoText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

            <!-- Privacy / terms: two columns normally, stacked on a narrow phone
                 where a single Georgian word would not fit in half the width. -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding IsCompactLayout, Converter={StaticResource InverseBoolConverter}}">
                <Button Text="{Binding PrivacyPolicyText}" Command="{Binding PrivacyPolicyCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" FontSize="12" LineBreakMode="WordWrap" />
                <Button Grid.Column="1" Text="{Binding TermsOfUseText}" Command="{Binding TermsOfUseCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" FontSize="12" LineBreakMode="WordWrap" />
            </Grid>

            <VerticalStackLayout Spacing="0" IsVisible="{Binding IsCompactLayout}">
                <Button Text="{Binding PrivacyPolicyText}" Command="{Binding PrivacyPolicyCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" FontSize="12" LineBreakMode="WordWrap" HeightRequest="34" />
                <Button Text="{Binding TermsOfUseText}" Command="{Binding TermsOfUseCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" FontSize="12" LineBreakMode="WordWrap" HeightRequest="34" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
