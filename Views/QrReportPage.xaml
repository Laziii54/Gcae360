<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CarScanner.Controls"
             xmlns:vm="clr-namespace:CarScanner.ViewModels"
             x:Class="CarScanner.Views.QrReportPage"
             x:DataType="vm:QrReportViewModel"
             BackgroundColor="{DynamicResource PageBg}"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">
            <Label Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" />
            <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{DynamicResource SubTextColor}" Margin="2,-7,2,4" LineBreakMode="WordWrap" />

            <Border IsVisible="{Binding HasQr}" Style="{StaticResource ListCardStyle}" Padding="18">
                <VerticalStackLayout Spacing="10" HorizontalOptions="Fill">
                    <Border BackgroundColor="White" StrokeThickness="0" StrokeShape="RoundRectangle 14" Padding="12" WidthRequest="280" HeightRequest="280" HorizontalOptions="Center">
                        <Image Source="{Binding QrImageUrl}" Aspect="AspectFit" WidthRequest="256" HeightRequest="256" />
                    </Border>
                    <Label Text="{Binding ExpiryText}" FontSize="14" FontAttributes="Bold" TextColor="#22C55E" HorizontalTextAlignment="Center" />
                    <Label Text="{Binding PublicUrl}" FontSize="11" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" />
            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            <Button Text="{Binding CreateButtonText}" Command="{Binding CreateCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PrimaryButtonStyle}" />

            <Grid IsVisible="{Binding HasQr}" ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button Text="{Binding ShareButtonText}" Command="{Binding ShareCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="14" HeightRequest="48" FontSize="12" FontAttributes="Bold" />
                <Button Grid.Column="1" Text="{Binding OpenButtonText}" Command="{Binding OpenCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="14" HeightRequest="48" FontSize="12" FontAttributes="Bold" />
            </Grid>

            <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <controls:Icon Kind="info" Tint="{DynamicResource Primary}" WidthRequest="18" HeightRequest="18" VerticalOptions="Start" />
                    <Label Grid.Column="1" Text="{Binding PrivacyText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
