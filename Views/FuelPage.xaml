<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    x:Class="CarScanner.Views.FuelPage"
    x:DataType="vm:FuelViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="საწვავის ხარჯი">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">
            <Label Text="საწვავის ხარჯი" Style="{StaticResource PageTitleStyle}" />

            <!-- Fuel / hybrid / electric -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                <Button Text="ბენზინი" Command="{Binding SetModeCommand}" CommandParameter="Fuel" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="18" HeightRequest="38" MinimumHeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="5,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsFuelMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="ჰიბრიდი" Command="{Binding SetModeCommand}" CommandParameter="Hybrid" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="18" HeightRequest="38" MinimumHeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="5,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsHybridMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="ელექტრო" Command="{Binding SetModeCommand}" CommandParameter="Electric" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="18" HeightRequest="38" MinimumHeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="5,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsElectricMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Headline numbers -->
            <Border Style="{StaticResource ListCardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="{Binding HeadLeftCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                            <Label AutomationId="DynamicTextFuelInstant" Text="{Binding HeadLeftValue}" TextColor="{DynamicResource TextColor}" FontSize="26" FontAttributes="Bold" />
                            <Label Text="{Binding HeadLeftUnit}" IsVisible="{Binding HasHeadUnits}" TextColor="{DynamicResource SubTextColor}" FontSize="11" FontAttributes="Bold" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="{Binding HeadRightCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                            <Label AutomationId="DynamicTextFuelAverage" Text="{Binding HeadRightValue}" TextColor="{DynamicResource TextColor}" FontSize="26" FontAttributes="Bold" />
                            <Label Text="{Binding HeadRightUnit}" IsVisible="{Binding HasHeadUnits}" TextColor="{DynamicResource SubTextColor}" FontSize="11" FontAttributes="Bold" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Battery power: regeneration left | consumption right -->
                    <VerticalStackLayout IsVisible="{Binding ShowPower}" Spacing="5">
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid ColumnDefinitions="*,*">
                            <Label Text="◀ რეკუპერაცია" TextColor="{DynamicResource SubTextColor}" FontSize="11" />
                            <Label Grid.Column="1" Text="ხარჯი ▶" TextColor="{DynamicResource SubTextColor}" FontSize="11" HorizontalTextAlignment="End" />
                        </Grid>
                        <controls:PowerBarView PowerKw="{Binding PowerKw}" HeightRequest="10" TrackColor="{DynamicResource BorderColor}" MarkColor="{DynamicResource SubTextColor}" />
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                            <Label Text="{Binding PowerText}" TextColor="{Binding PowerColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                            <Label Text="{Binding PowerCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="11" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label AutomationId="DynamicTextFuelStatus" Text="{Binding Status}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="დაწყება" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="48" />
                <Button Grid.Column="1" Text="პაუზა" Command="{Binding PauseCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" />
                <Button Grid.Column="2" Text="გაჩერება" Command="{Binding StopCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" />
            </Grid>

            <!-- Battery energy (hybrid / electric) -->
            <Label Text="ბატარეის ენერგია" Style="{StaticResource SectionCaptionStyle}" IsVisible="{Binding ShowEnergy}" />
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding ShowEnergy}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M3,8 L19,8 L19,17 L3,17 Z M21,11 L21,14 M7,12.5 L11,12.5 M9,10.5 L9,14.5 M14,12.5 L17,12.5" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="{Binding EnergyUsedCaption}" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextEnergyUsed" Text="{Binding EnergyUsedText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,12 A8,8 0 1 0 8,5 M4,4 L4,9 L9,9" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="{Binding EnergyRegenCaption}" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextEnergyRegen" Text="{Binding EnergyRegenText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M3,12 L7,12 L10,5 L14,19 L17,12 L21,12" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="ბატარეის ძაბვა" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="{Binding BatteryVoltageText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M13,3 L6,13 L11,13 L10,21 L18,10 L13,10 Z" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="დენი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="{Binding BatteryCurrentText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M8,4 L16,4 L16,21 L8,21 Z M10,2 L14,2 M8,14 L16,14" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="დამუხტვა (SoC)" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="{Binding SocText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,6">
                        <Path Data="M12,3 L12,21 M16,7 C16,5 14,4.5 12,4.5 C9.5,4.5 8,6 8,7.5 C8,11 16,10 16,14.5 C16,16.5 14.5,18 12,18 C9.5,18 8,17 8,15" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="ფასი 1 kWh (₾)" Style="{StaticResource RowTitleStyle}" />
                        <Entry Grid.Column="2" Text="{Binding ElectricityPriceText}" Keyboard="Numeric" Placeholder="0.30" WidthRequest="90" HorizontalTextAlignment="End" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,7 L20,7 L20,18 L4,18 Z M4,11 L20,11 M7,15 L10,15" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="ღირებულება" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="{Binding EnergyCostText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Where the battery data comes from -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12" IsVisible="{Binding ShowEnergy}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{Binding EnergySourceTitle}" TextColor="{Binding EnergySourceColor}" FontSize="13" FontAttributes="Bold" />
                    <Label Text="{Binding EnergySourceText}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                    <Button Text="ლოგის კოპირება" Command="{Binding CopyEnergyLogCommand}" IsVisible="{Binding HasEnergyLog}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="10" HeightRequest="36" FontSize="12" HorizontalOptions="Start" Padding="12,0" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Estimate from state of charge when current cannot be read -->
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding ShowSocFallback}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,6">
                        <Path Data="M3,8 L19,8 L19,17 L3,17 Z M21,11 L21,14 M7,12.5 L11,12.5 M9,10.5 L9,14.5 M14,12.5 L17,12.5" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="ბატარეის ტევადობა (kWh)" Style="{StaticResource RowTitleStyle}" />
                        <Entry Grid.Column="2" Text="{Binding BatteryCapacityText}" Keyboard="Numeric" Placeholder="64" WidthRequest="90" HorizontalTextAlignment="End" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M8,4 L16,4 L16,21 L8,21 Z M10,2 L14,2 M8,14 L16,14" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="დამუხტვა" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="{Binding SocFallbackText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,12 A8,8 0 1 0 8,5 M4,4 L4,9 L9,9" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მიახლოებითი ხარჯი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="{Binding ApproxConsumptionText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Trip analytics -->
            <Label Text="Trip Analytics" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,18 L20,18 M6,18 C6,12 9,9 12,9 C15,9 18,12 18,18 M12,9 L12,5 M9,5 L15,5" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მანძილი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelDistance" Text="{Binding Distance}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" IsVisible="{Binding ShowFuel}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13" IsVisible="{Binding ShowFuel}">
                        <Path Data="M5,20 L5,5 L13,5 L13,20 Z M5,11 L13,11 M13,8 L17,11 L17,17 C17,19 19,19 19,17 L19,9" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="დახარჯული საწვავი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelUsed" Text="{Binding FuelUsed}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" IsVisible="{Binding ShowFuel}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13" IsVisible="{Binding ShowFuel}">
                        <Path Data="M12,4 C12,4 6,11 6,15 C6,18 9,20 12,20 C15,20 18,18 18,15 C18,11 12,4 12,4 Z" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="Fuel Rate" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelRate" Text="{Binding FuelRate}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" IsVisible="{Binding ShowFuel}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13" IsVisible="{Binding ShowFuel}">
                        <Path Data="M7,3 L17,3 L17,21 L7,21 Z M7,13 L17,13" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="საწვავის დონე" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelLevel" Text="{Binding FuelLevel}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 M12,8 L12,12 L15,14" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მოძრაობის დრო" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelMoving" Text="{Binding MovingTime}" TextColor="{DynamicResource TextColor}" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,16 A8,8 0 1 1 20,16 M12,16 L16,10" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მაქსიმალური სიჩქარე" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelMaxSpeed" Text="{Binding MaximumSpeed}" TextColor="{DynamicResource TextColor}" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Saved trips (fuel, hybrid and electric) -->
            <Label Text="მოგზაურობების ისტორია" Style="{StaticResource SectionCaptionStyle}" />
            <Label Text="{Binding TripHistorySummary}" TextColor="{DynamicResource SubTextColor}" FontSize="12" LineBreakMode="WordWrap" />
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasTripHistory}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding TripHistory}" Spacing="0" Margin="0,-1,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <VerticalStackLayout Spacing="0">
                                <BoxView Style="{StaticResource RowDividerStyle}" />
                                <Label Text="{Binding .}" TextColor="{DynamicResource TextColor}" FontSize="12.5" Padding="14,10" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
