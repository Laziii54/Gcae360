<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    x:Class="CarScanner.Views.FuelPage"
    x:DataType="vm:FuelViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="საწვავის ხარჯი">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">
            <Label Text="საწვავის ხარჯი" Style="{StaticResource PageTitleStyle}" />

            <!-- Fuel / hybrid / electric -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                <Button Text="ბენზინი" Command="{Binding SetModeCommand}" CommandParameter="Fuel" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="18" HeightRequest="38" MinimumHeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="5,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsFuelMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="1" Text="ჰიბრიდი / Plug-in" Command="{Binding SetModeCommand}" CommandParameter="Hybrid" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="18" HeightRequest="38" MinimumHeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="5,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsHybridMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button Grid.Column="2" Text="ელექტრო" Command="{Binding SetModeCommand}" CommandParameter="Electric" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="18" HeightRequest="38" MinimumHeightRequest="38" FontSize="12" FontAttributes="Bold" Padding="5,0">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding IsElectricMode}" Value="True">
                            <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BorderColor" Value="{DynamicResource Primary}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- A trip that was cut short (app closed / crashed) can be saved or discarded -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12" IsVisible="{Binding HasInterruptedTrip}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding InterruptedTripText}" TextColor="{DynamicResource TextColor}" FontSize="13" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <Button Text="შენახვა" Command="{Binding SaveInterruptedTripCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="42" />
                        <Button Grid.Column="1" Text="გაუქმება" Command="{Binding DiscardInterruptedTripCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.2" CornerRadius="12" HeightRequest="42" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Trip summary after Stop -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12" IsVisible="{Binding IsTripSummaryVisible}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="0">
                            <Label Text="მოგზაურობა შენახულია" TextColor="{DynamicResource TextColor}" FontSize="16" FontAttributes="Bold" />
                            <Label AutomationId="DynamicTextTripSummaryTitle" Text="{Binding TripSummaryTitle}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                        </VerticalStackLayout>
                        <controls:IconButton Grid.Column="1" Kind="close" Plain="True" Tint="{DynamicResource SubTextColor}" Command="{Binding CloseTripSummaryCommand}" WidthRequest="36" HeightRequest="36" IconSize="16" SemanticProperties.Description="Close" />
                    </Grid>
                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center">
                        <Label Text="ამ მოგზაურობამ დაჯდა" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />
                        <Label AutomationId="DynamicTextTripSummaryCost" Text="{Binding TripSummaryCostText}" TextColor="{DynamicResource TextColor}" FontSize="30" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label AutomationId="DynamicTextTripSummaryCostDetail" Text="{Binding TripSummaryCostDetail}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowTripSummaryComparison}">
                        <Label Text="იგივე გზა ჩვეულებრივ ბენზინიან მანქანაზე" TextColor="{DynamicResource SubTextColor}" FontSize="12" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8">
                            <Label Text="შენ" TextColor="{DynamicResource SubTextColor}" FontSize="12" VerticalOptions="Center" />
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SummaryYouStar}" /><ColumnDefinition Width="{Binding SummaryYouRest}" /></Grid.ColumnDefinitions>
                                <BoxView Color="#1E8A4C" HeightRequest="12" CornerRadius="6" />
                            </Grid>
                            <Label Grid.Column="2" AutomationId="DynamicTextSummaryYou" Text="{Binding SummaryYouText}" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" />
                        </Grid>
                        <Grid ColumnDefinitions="70,*,Auto" ColumnSpacing="8">
                            <Label Text="ბენზინზე" TextColor="{DynamicResource SubTextColor}" FontSize="12" VerticalOptions="Center" />
                            <Grid Grid.Column="1" VerticalOptions="Center">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding SummaryPetrolStar}" /><ColumnDefinition Width="{Binding SummaryPetrolRest}" /></Grid.ColumnDefinitions>
                                <BoxView Color="#D0701F" HeightRequest="12" CornerRadius="6" />
                            </Grid>
                            <Label Grid.Column="2" AutomationId="DynamicTextSummaryPetrol" Text="{Binding SummaryPetrolText}" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" />
                        </Grid>
                        <Label AutomationId="DynamicTextSummarySaving" Text="{Binding SummarySavingText}" TextColor="{DynamicResource OkText}" FontSize="12" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding TripSummaryRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TripSummaryRow">
                                <VerticalStackLayout Spacing="0">
                                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,7">
                                        <Label AutomationId="DynamicTextSummaryRowTitle" Text="{Binding Title}" TextColor="{DynamicResource SubTextColor}" FontSize="12.5" VerticalOptions="Center" />
                                        <Label Grid.Column="1" AutomationId="DynamicTextSummaryRowValue" Text="{Binding Value}" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button Text="ახალი მოგზაურობა" Command="{Binding StartNewTripCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- Fuel headline (petrol / diesel) -->
            <Border Style="{StaticResource ListCardStyle}" Padding="16,14" IsVisible="{Binding IsFuelMode}">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="{Binding HeadLeftCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                        <Label AutomationId="DynamicTextFuelInstant" Text="{Binding HeadLeftValue}" TextColor="{DynamicResource TextColor}" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="0">
                        <Label Text="{Binding HeadRightCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                        <Label AutomationId="DynamicTextFuelAverage" Text="{Binding HeadRightValue}" TextColor="{DynamicResource TextColor}" FontSize="26" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Electric / plug-in hero: battery ring + live state -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12" IsVisible="{Binding ShowEnergy}">
                <Grid ColumnDefinitions="92,*" ColumnSpacing="14">
                    <Grid WidthRequest="92" HeightRequest="92" VerticalOptions="Center">
                        <controls:RingGaugeView Progress="{Binding SocProgress}" RingColor="{Binding SocRingColor}" TrackColor="{DynamicResource BorderColor}" Thickness="9" />
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="0">
                            <Label AutomationId="DynamicTextSocBig" Text="{Binding SocBigText}" TextColor="{DynamicResource TextColor}" FontSize="21" FontAttributes="Bold" HorizontalTextAlignment="Center">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSensorGraphCommand}" CommandParameter="soc" /></Label.GestureRecognizers></Label>
                            <Label AutomationId="DynamicTextRange" Text="{Binding RangeText}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                        <Border IsVisible="{Binding ShowDriveBadge}" BackgroundColor="{Binding DriveBadgeBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="10,4" HorizontalOptions="Start">
                            <Label AutomationId="DynamicTextDriveBadge" Text="{Binding DriveBadgeText}" TextColor="{Binding DriveBadgeColor}" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <HorizontalStackLayout Spacing="5">
                            <Label AutomationId="DynamicTextHeroValue" Text="{Binding HeroValueText}" TextColor="{Binding HeroValueColor}" FontSize="26" FontAttributes="Bold" VerticalOptions="End">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSensorGraphCommand}" CommandParameter="power" /></Label.GestureRecognizers></Label>
                            <Label AutomationId="DynamicTextHeroUnit" Text="{Binding HeroUnitText}" TextColor="{DynamicResource SubTextColor}" FontSize="12" FontAttributes="Bold" VerticalOptions="End" Margin="0,0,0,4" />
                        </HorizontalStackLayout>
                        <VerticalStackLayout Spacing="2" IsVisible="{Binding ShowHeroPowerBar}">
                            <controls:PowerBarView PowerKw="{Binding PowerKw}" HeightRequest="10" TrackColor="{DynamicResource BorderColor}" MarkColor="{DynamicResource SubTextColor}" />
                            <Grid ColumnDefinitions="*,*">
                                <Label Text="დამუხტვა" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                                <Label Grid.Column="1" Text="ხარჯი" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="End" />
                            </Grid>
                        </VerticalStackLayout>
                        <Label AutomationId="DynamicTextHeroHint" Text="{Binding HeroHintText}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Power of the last minutes -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,10" IsVisible="{Binding ShowPower}">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label AutomationId="DynamicTextPowerHistoryCaption" Text="{Binding PowerHistoryCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="kW" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                    </Grid>
                    <controls:PowerHistoryView Samples="{Binding PowerHistory}" HeightRequest="{Binding PowerHistoryHeightRequest}" LineColor="{DynamicResource BorderColor}">
                        <controls:PowerHistoryView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding TogglePowerHistoryCommand}" />
                        </controls:PowerHistoryView.GestureRecognizers>
                    </controls:PowerHistoryView>
                    <Grid ColumnDefinitions="*,*">
                        <Label Text="ხარჯი" TextColor="{DynamicResource WarnTitle}" FontSize="12" />
                        <Label Grid.Column="1" Text="დამუხტვა" TextColor="{DynamicResource OkText}" FontSize="12" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Distance / time / cost (every mode) -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Border Style="{StaticResource ListCardStyle}" Padding="8,9">
                    <VerticalStackLayout Spacing="1">
                        <Label AutomationId="DynamicTextTripDistance" Text="{Binding TripDistanceText}" TextColor="{DynamicResource TextColor}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding DistanceCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource ListCardStyle}" Padding="8,9">
                    <VerticalStackLayout Spacing="1">
                        <Label AutomationId="DynamicTextTripDuration" Text="{Binding TripDurationText}" TextColor="{DynamicResource TextColor}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding DurationCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ListCardStyle}" Padding="8,9">
                    <VerticalStackLayout Spacing="1">
                        <Label AutomationId="DynamicTextTripCost" Text="{Binding TripCostTotalText}" TextColor="{DynamicResource TextColor}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding CostCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label AutomationId="DynamicTextFuelStatus" Text="{Binding Status}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <Button Text="{Binding StartButtonText}" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="48" />
                <Button Grid.Column="1" Text="პაუზა" Command="{Binding PauseCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" />
                <Button Grid.Column="2" Text="გაჩერება" Command="{Binding StopCommand}" BackgroundColor="#C2372B" TextColor="White" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" />
            </Grid>

            <!-- Energy of this trip: used / recovered / net (Electric only — Hybrid already has the drive-split card below) -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12" IsVisible="{Binding ShowEnergyCard}">
                <VerticalStackLayout Spacing="0">
                    <Label AutomationId="DynamicTextEnergyCardCaption" Text="{Binding EnergyCardCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" FontAttributes="Bold" Margin="0,0,0,6" />
                    <Grid IsVisible="{Binding ShowEnergyBar}" HeightRequest="8" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ConsumedStar}" /><ColumnDefinition Width="{Binding RegenStar}" /></Grid.ColumnDefinitions>
                        <BoxView Color="#D0701F" CornerRadius="4,0,0,4" />
                        <BoxView Grid.Column="1" Color="#1E8A4C" CornerRadius="0,4,4,0" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,8">
                        <BoxView Color="#D0701F" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextEnergyUsedCaption" Text="{Binding EnergyUsedCaption}" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="2" AutomationId="DynamicTextEnergyUsed" Text="{Binding EnergyUsedText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Padding="0,8">
                        <BoxView Color="#1E8A4C" WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextEnergyRegenCaption" Text="{Binding EnergyRegenCaption}" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="2" AutomationId="DynamicTextEnergyRegen" Text="{Binding EnergyRegenText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,8">
                        <Label AutomationId="DynamicTextNetEnergyCaption" Text="{Binding NetEnergyCaption}" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextNetEnergy" Text="{Binding NetEnergyText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,8">
                        <Label AutomationId="DynamicTextEnergyPerKmCaption" Text="{Binding EnergyPerKmCaption}" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextEnergyPerKm" Text="{Binding EnergyPerKmText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Label IsVisible="False" AutomationId="DynamicTextEnergyNote" Text="{Binding EnergyNoteText}" TextColor="{DynamicResource SubTextColor}" FontSize="12" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Plug-in: electric / engine split -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12" IsVisible="{Binding ShowDriveSplit}">
                <VerticalStackLayout Spacing="0">
                    <Label AutomationId="DynamicTextSplitCaption" Text="{Binding SplitCaption}" TextColor="{DynamicResource SubTextColor}" FontSize="12" FontAttributes="Bold" Margin="0,0,0,6" />
                    <Grid HeightRequest="22" Margin="0,0,0,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ElectricShareStar}" /><ColumnDefinition Width="{Binding EngineShareStar}" /></Grid.ColumnDefinitions>
                        <Border BackgroundColor="#1E8A4C" StrokeThickness="0" StrokeShape="RoundRectangle 6,0,6,0">
                            <Label AutomationId="DynamicTextElectricShare" Text="{Binding ElectricShareText}" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#D0701F" StrokeThickness="0" StrokeShape="RoundRectangle 0,6,0,6">
                            <Label AutomationId="DynamicTextEngineShare" Text="{Binding EngineShareText}" TextColor="White" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8">
                        <Label Text="ელექტრო" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextElectricSplit" Text="{Binding ElectricSplitText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8">
                        <Label Text="ბენზინი" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextEngineSplit" Text="{Binding EngineSplitText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8">
                        <Label Text="საშუალო ბენზინი, მთელ გზაზე" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextSplitFuelAverage" Text="{Binding SplitFuelAverageText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Battery: SoC, V/A, capacity, price -->
            <Label Text="ბატარეა" Style="{StaticResource SectionCaptionStyle}" IsVisible="{Binding ShowEnergy}" />
            <Border Style="{StaticResource ListCardStyle}" Padding="14,4" IsVisible="{Binding ShowEnergy}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8">
                        <Label Text="დაწყებისას → ახლა" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextSocStartNow" Text="{Binding SocStartNowText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,8">
                        <Label Text="ძაბვა · დენი" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Label Grid.Column="1" AutomationId="DynamicTextVoltageCurrent" Text="{Binding VoltageCurrentText}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" HorizontalTextAlignment="End">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSensorGraphCommand}" CommandParameter="voltage" /></Label.GestureRecognizers></Label>
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,2">
                        <Label Text="ბატარეის ტევადობა (kWh)" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding BatteryCapacityText}" Keyboard="Numeric" Placeholder="12" WidthRequest="90" HorizontalTextAlignment="End" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,2">
                        <Label Text="ფასი 1 kWh (₾)" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding ElectricityPriceText}" Keyboard="Numeric" Placeholder="0.30" WidthRequest="90" HorizontalTextAlignment="End" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="0,2" IsVisible="{Binding ShowFuel}">
                        <Label Text="ფასი 1 ლ ბენზინი (₾)" TextColor="{DynamicResource TextColor}" FontSize="13" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding FuelPriceText}" Keyboard="Numeric" Placeholder="3.00" WidthRequest="90" HorizontalTextAlignment="End" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                    </Grid>
                    <Button Text="{Binding FlipSignText}" Command="{Binding FlipEnergySignCommand}" IsVisible="False" AutomationId="DynamicTextFlipSign" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" Padding="0" HeightRequest="36" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- What this car reports + where the data comes from -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,10" IsVisible="False">
                <VerticalStackLayout Spacing="0">
                    <Label Text="რას კითხულობს ეს მანქანა" TextColor="{DynamicResource SubTextColor}" FontSize="12" FontAttributes="Bold" Margin="0,0,0,4" />
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding EnergyCapabilities}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:EnergyCapabilityRow">
                                <Grid ColumnDefinitions="18,*,Auto" ColumnSpacing="8" Padding="0,6">
                                    <controls:Icon Kind="{Binding Mark}" Tint="{Binding MarkColor}" WidthRequest="14" HeightRequest="14" VerticalOptions="Center" HorizontalOptions="Start" />
                                    <Label Grid.Column="1" AutomationId="DynamicTextCapabilityTitle" Text="{Binding Title}" TextColor="{DynamicResource TextColor}" FontSize="12.5" VerticalOptions="Center" />
                                    <Label Grid.Column="2" AutomationId="DynamicTextCapabilityDetail" Text="{Binding Detail}" TextColor="{DynamicResource SubTextColor}" FontSize="12" VerticalOptions="Center" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Label AutomationId="DynamicTextEnergySourceTitle" Text="{Binding EnergySourceTitle}" TextColor="{Binding EnergySourceColor}" FontSize="12.5" FontAttributes="Bold" Margin="0,8,0,2" />
                    <Label AutomationId="DynamicTextEnergySource" Text="{Binding EnergySourceText}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                    <!-- Technical energy log: hidden from users (kept for support builds). -->
                    <Button Text="ლოგის კოპირება" Command="{Binding CopyEnergyLogCommand}" IsVisible="False" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="10" HeightRequest="36" FontSize="12" HorizontalOptions="Start" Padding="12,0" Margin="0,6,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Trip analytics -->
            <Label Text="Trip Analytics" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,18 L20,18 M6,18 C6,12 9,9 12,9 C15,9 18,12 18,18 M12,9 L12,5 M9,5 L15,5" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მანძილი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelDistance" Text="{Binding Distance}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" IsVisible="{Binding ShowFuel}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13" IsVisible="{Binding ShowFuel}">
                        <Path Data="M5,20 L5,5 L13,5 L13,20 Z M5,11 L13,11 M13,8 L17,11 L17,17 C17,19 19,19 19,17 L19,9" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="დახარჯული საწვავი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelUsed" Text="{Binding FuelUsed}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" IsVisible="{Binding ShowFuel}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13" IsVisible="{Binding ShowFuel}">
                        <Path Data="M12,4 C12,4 6,11 6,15 C6,18 9,20 12,20 C15,20 18,18 18,15 C18,11 12,4 12,4 Z" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="Fuel Rate" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelRate" Text="{Binding FuelRate}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSensorGraphCommand}" CommandParameter="fuelRate" /></Label.GestureRecognizers></Label>
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" IsVisible="{Binding ShowFuel}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13" IsVisible="{Binding ShowFuel}">
                        <Path Data="M7,3 L17,3 L17,21 L7,21 Z M7,13 L17,13" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="საწვავის დონე" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelLevel" Text="{Binding FuelLevel}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                            <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenSensorGraphCommand}" CommandParameter="fuelLevel" /></Label.GestureRecognizers></Label>
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 M12,8 L12,12 L15,14" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მოძრაობის დრო" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelMoving" Text="{Binding MovingTime}" TextColor="{DynamicResource TextColor}" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,16 A8,8 0 1 1 20,16 M12,16 L16,10" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მაქსიმალური სიჩქარე" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" AutomationId="DynamicTextFuelMaxSpeed" Text="{Binding MaximumSpeed}" TextColor="{DynamicResource TextColor}" FontSize="14" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Saved trips (fuel, hybrid and electric): collapsed by default, tap to open.
                 The list itself can hold hundreds of trips, so once open it scrolls inside
                 a capped-height box instead of pushing the rest of the page down. -->
            <Grid ColumnDefinitions="*,Auto">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleTripHistoryCommand}" />
                </Grid.GestureRecognizers>
                <Label Text="მოგზაურობების ისტორია" Style="{StaticResource SectionCaptionStyle}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding TripHistoryToggleText}" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
            <Label Text="{Binding TripHistorySummary}" TextColor="{DynamicResource SubTextColor}" FontSize="12" LineBreakMode="WordWrap">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleTripHistoryCommand}" />
                </Label.GestureRecognizers>
            </Label>
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding ShowTripHistoryList}" Padding="0">
                <ScrollView Orientation="Vertical" MaximumHeightRequest="360">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding TripHistory}" Spacing="0" Margin="0,-1,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <VerticalStackLayout Spacing="0">
                                    <BoxView Style="{StaticResource RowDividerStyle}" />
                                    <Label Text="{Binding .}" TextColor="{DynamicResource TextColor}" FontSize="12.5" Padding="14,10" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
