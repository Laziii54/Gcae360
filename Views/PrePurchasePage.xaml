<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:m="clr-namespace:CarScanner.Models"
    x:Class="CarScanner.Views.PrePurchasePage"
    x:DataType="vm:PrePurchaseViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="ყიდვისწინა შემოწმება">

    <ContentPage.Resources>
        <!-- Key/value row inside a list card: divider on top (the card header sits above the first one) -->
        <DataTemplate x:Key="RowTemplate" x:DataType="m:PrePurchaseRow">
            <VerticalStackLayout Spacing="0">
                <BoxView Style="{StaticResource RowDividerStyle}" Margin="14,0,0,0" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="14,11">
                    <Label AutomationId="DynamicTextPrePurchaseRowLabel" Text="{Binding Label}"
                           TextColor="{DynamicResource TextColor}" FontSize="13" LineBreakMode="WordWrap" VerticalOptions="Center" />
                    <Label Grid.Column="1" AutomationId="DynamicTextPrePurchaseRowValue" Text="{Binding Value}"
                           TextColor="{Binding Color}" FontSize="13" FontAttributes="Bold" HorizontalTextAlignment="End"
                           MaximumWidthRequest="200" LineBreakMode="WordWrap" VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </DataTemplate>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

            <!-- Title + PRO -->
            <VerticalStackLayout Spacing="2">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label AutomationId="DynamicTextPrePurchaseTitle" Text="{Binding PageTitle}"
                           Style="{StaticResource PageTitleStyle}" VerticalOptions="Center" />
                    <Border Grid.Column="1" Style="{StaticResource ProBadgeStyle}">
                        <Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" />
                    </Border>
                </Grid>
                <Label Text="მანქანის სრული შემოწმება ყიდვამდე — ერთი ღილაკით"
                       TextColor="{DynamicResource SubTextColor}" FontSize="12" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- ============ BEFORE THE CHECK ============ -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsIdle}">
                <Border Style="{StaticResource ListCardStyle}">
                    <VerticalStackLayout Spacing="0">
                        <Label Text="ჩართე კონტაქტი ან ძრავი" TextColor="{DynamicResource TextColor}"
                               FontSize="14" FontAttributes="Bold" Padding="14,12" />
                        <BoxView Style="{StaticResource RowDividerStyle}" Margin="14,0,0,0" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,11">
                            <Label Text="მანქანა" TextColor="{DynamicResource SubTextColor}" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="1" AutomationId="DynamicTextPrePurchaseVehicle" Text="{Binding VehicleName}"
                                   TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold"
                                   HorizontalTextAlignment="End" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" Margin="14,0,0,0" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,11">
                            <Label Text="VIN" TextColor="{DynamicResource SubTextColor}" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="1" AutomationId="DynamicTextPrePurchaseVin" Text="{Binding VinText}"
                                   TextColor="{DynamicResource TextColor}" FontSize="12" FontFamily="monospace"
                                   HorizontalTextAlignment="End" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" Margin="14,0,0,0" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,11">
                            <Label Text="ადაპტერი" TextColor="{DynamicResource SubTextColor}" FontSize="13" VerticalOptions="Center" />
                            <Label Grid.Column="1" AutomationId="DynamicTextPrePurchaseAdapter" Text="{Binding AdapterText}"
                                   TextColor="{Binding AdapterColor}" FontSize="13" FontAttributes="Bold"
                                   HorizontalTextAlignment="End" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="რას შეამოწმებს" Style="{StaticResource SectionCaptionStyle}" />
                <Border Style="{StaticResource ListCardStyle}">
                    <VerticalStackLayout Spacing="0">
                        <Grid Padding="14,11">
                            <Label Text="შეცდომები ყველა მოდულში (ძრავი, ABS, აირბაგი…)" Style="{StaticResource RowTitleStyle}" FontSize="13" LineBreakMode="WordWrap" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="14,11">
                            <Label Text="მოდულები, ვერსიები და ნომრები" Style="{StaticResource RowTitleStyle}" FontSize="13" LineBreakMode="WordWrap" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="14,11">
                            <Label Text="გარბენის შედარება მოდულებს შორის" Style="{StaticResource RowTitleStyle}" FontSize="13" LineBreakMode="WordWrap" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="14,11">
                            <Label Text="ძრავის და სენსორების ცოცხალი მონაცემები" Style="{StaticResource RowTitleStyle}" FontSize="13" LineBreakMode="WordWrap" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="14,11">
                            <Label Text="ბატარეა და დამუხტვა" Style="{StaticResource RowTitleStyle}" FontSize="13" LineBreakMode="WordWrap" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="14,11">
                            <Label Text="მზადყოფნა ტექდათვალიერებისთვის" Style="{StaticResource RowTitleStyle}" FontSize="13" LineBreakMode="WordWrap" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="14,11">
                            <Label Text="VIN ისტორია (ავარიები, აუქციონი)" Style="{StaticResource RowTitleStyle}" FontSize="13" LineBreakMode="WordWrap" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid Padding="14,11">
                            <Label Text="0–100 (არასავალდებულო)" Style="{StaticResource RowTitleStyle}" FontSize="13" LineBreakMode="WordWrap" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button AutomationId="DynamicTextPrePurchaseStart" Text="{Binding StartButtonText}"
                        Command="{Binding StartCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="52" CornerRadius="12" />
                <Label Text="დაახლოებით 1–2 წუთი · მანქანაში არაფერი იცვლება"
                       TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <!-- ============ DURING THE CHECK ============ -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsRunning}">
                <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Label AutomationId="DynamicTextPrePurchaseRunning" Text="{Binding RunningTitle}"
                                   TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold"
                                   LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <Label Grid.Column="1" AutomationId="DynamicTextPrePurchasePercent"
                                   Text="{Binding Percent, StringFormat='{0}%'}" TextColor="{DynamicResource TextColor}"
                                   FontSize="26" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar Progress="{Binding PercentFraction}" ProgressColor="{DynamicResource Primary}" HeightRequest="5" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <ActivityIndicator IsRunning="{Binding IsRunning}" Color="{DynamicResource Primary}" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                            <Label Grid.Column="1" AutomationId="DynamicTextPrePurchaseDetail" Text="{Binding ProgressDetail}"
                                   TextColor="{DynamicResource SubTextColor}" FontSize="12" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Steps}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:PrePurchaseStep">
                                <Grid ColumnDefinitions="18,*" ColumnSpacing="8">
                                    <controls:Icon Kind="{Binding Mark}" Tint="{Binding Color}" WidthRequest="14" HeightRequest="14" VerticalOptions="Start" Margin="0,2,0,0" />
                                    <Label Grid.Column="1" AutomationId="DynamicTextPrePurchaseStep" Text="{Binding Text}"
                                           TextColor="{Binding Color}" FontSize="13" LineBreakMode="WordWrap" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Button AutomationId="DynamicTextPrePurchaseStop" Text="{Binding StopButtonText}" Command="{Binding StopCommand}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}"
                        BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12"
                        FontAttributes="Bold" HeightRequest="48" />
            </VerticalStackLayout>

            <!-- ============ RESULT ============ -->
            <VerticalStackLayout Spacing="12" IsVisible="{Binding HasResult}">
                <!-- Score · verdict · summary -->
                <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4" VerticalOptions="Center" HorizontalOptions="Center">
                            <Label AutomationId="DynamicTextPrePurchaseScore" Text="{Binding Score}"
                                   TextColor="{DynamicResource TextColor}" FontSize="30" FontAttributes="Bold"
                                   HorizontalOptions="Center" />
                            <BoxView HeightRequest="4" WidthRequest="36" CornerRadius="2" Color="{Binding ScoreColor}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label AutomationId="DynamicTextPrePurchaseVerdict" Text="{Binding Verdict}"
                                   TextColor="{Binding ScoreColor}" FontSize="16" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <Label AutomationId="DynamicTextPrePurchaseSummary" Text="{Binding Summary}"
                                   TextColor="{DynamicResource SubTextColor}" FontSize="12" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Faults -->
                <Border Style="{StaticResource ListCardStyle}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12">
                            <Path Data="M12,4 L21,20 L3,20 Z M12,10 L12,14 M12,17 L12,17.5" Style="{StaticResource RowIconStyle}" />
                            <Label Grid.Column="1" Text="შეცდომები" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="2" Padding="8,2" StrokeThickness="1" Stroke="{Binding FaultCountColor}"
                                    StrokeShape="RoundRectangle 6" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Label AutomationId="DynamicTextPrePurchaseFaultCount" Text="{Binding FaultCountText}"
                                       TextColor="{Binding FaultCountColor}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Faults}"
                                             BindableLayout.ItemTemplate="{StaticResource RowTemplate}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Mileage -->
                <Border Style="{StaticResource ListCardStyle}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12">
                            <Path Data="M4,19 L20,19 M6,19 L6,10 M12,19 L12,5 M18,19 L18,13" Style="{StaticResource RowIconStyle}" />
                            <Label Grid.Column="1" Text="გარბენი" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                            <Border Grid.Column="2" Padding="8,2" StrokeThickness="1" Stroke="{Binding MileageBadgeColor}"
                                    StrokeShape="RoundRectangle 6" BackgroundColor="Transparent" VerticalOptions="Center">
                                <Label AutomationId="DynamicTextPrePurchaseMileageBadge" Text="{Binding MileageBadge}"
                                       TextColor="{Binding MileageBadgeColor}" FontSize="12" FontAttributes="Bold" />
                            </Border>
                        </Grid>
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding MileageRows}"
                                             BindableLayout.ItemTemplate="{StaticResource RowTemplate}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Condition -->
                <Border Style="{StaticResource ListCardStyle}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,12">
                            <Path Data="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 M12,8 L12,12 L15,14" Style="{StaticResource RowIconStyle}" />
                            <Label Grid.Column="1" Text="მდგომარეობა" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding ConditionRows}"
                                             BindableLayout.ItemTemplate="{StaticResource RowTemplate}" />
                    </VerticalStackLayout>
                </Border>

                <Button AutomationId="DynamicTextPrePurchasePdf" Text="{Binding PdfButtonText}" Command="{Binding ExportPdfCommand}"
                        Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="50" />
                <Button AutomationId="DynamicTextPrePurchaseAi" Text="{Binding AiButtonText}" Command="{Binding OpenAiCommand}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}"
                        BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" FontAttributes="Bold" HeightRequest="48" />
                <Button AutomationId="DynamicTextPrePurchaseAcceleration" Text="{Binding AccelerationButtonText}"
                        Command="{Binding OpenAccelerationCommand}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}"
                        BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" FontAttributes="Bold" HeightRequest="48" />
                <Button AutomationId="DynamicTextPrePurchaseAgain" Text="{Binding AgainButtonText}" Command="{Binding AgainCommand}"
                        BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0" HeightRequest="44" />
            </VerticalStackLayout>

            <Label AutomationId="DynamicTextPrePurchaseError" Text="{Binding ErrorText}" IsVisible="{Binding HasError}"
                   TextColor="#B3361F" FontSize="12" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
