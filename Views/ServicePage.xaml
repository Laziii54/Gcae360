<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    x:Class="CarScanner.Views.ServicePage"
    x:DataType="vm:ServiceViewModel"
    x:Name="ServiceRoot"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding PageTitleText}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header: title · refresh -->
        <Grid Grid.Row="0" Padding="16,12,16,6" ColumnDefinitions="*,Auto" ColumnSpacing="10" BackgroundColor="{DynamicResource PageBg}">
            <Label AutomationId="DynamicTextService1" Text="{Binding HeaderTitleText}" Style="{StaticResource PageTitleStyle}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
            <Button Grid.Column="1" AutomationId="DynamicTextServiceRefresh" Text="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Padding="14,0" HeightRequest="36" MinimumHeightRequest="36" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" VerticalOptions="Center" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsPullRefreshing}" Command="{Binding PullRefreshCommand}" RefreshColor="{DynamicResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="16,6,16,32" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" HorizontalOptions="Center" />

                <!-- Oil: the value from the car and one reset button -->
                <Border IsVisible="{Binding HasOilResetCard}" Style="{StaticResource ListCardStyle}" Padding="16,14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding OilCardTitle}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                            <Label Grid.Column="1" Text="{Binding OilSourceText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" />
                        </Grid>
                        <HorizontalStackLayout Spacing="10">
                            <Label AutomationId="DynamicTextServiceResetState" Text="{Binding OilLifeValueText}" FontSize="28" FontAttributes="Bold" TextColor="{Binding OilLifeColor}" VerticalOptions="Center" />
                            <Label IsVisible="{Binding HasOilDue}" Text="{Binding OilDueText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <ProgressBar Progress="{Binding OilLifeFraction}" ProgressColor="{Binding OilLifeColor}" HeightRequest="6" />
                        <!-- The reset to 100% goes through the checked write (speed, voltage, read-back) and is shown only when the car has a reviewed reset; the 50% button needs separate evidence that this car accepts a chosen value. -->
                        <Grid IsVisible="{Binding CanResetOilLife}" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Border Grid.ColumnSpan="{Binding OilResetFullColumnSpan}" BackgroundColor="#1D5BD6" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,6" MinimumHeightRequest="48" IsEnabled="{Binding CanPressOilReset}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResetOilLifeFullCommand}" />
                                </Border.GestureRecognizers>
                                <Label AutomationId="DynamicTextServiceResetFull" Text="{Binding ResetFullButtonText}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="WordWrap" />
                            </Border>
                            <Border Grid.Column="1" IsVisible="{Binding CanSetOilLifeHalf}" BackgroundColor="Transparent" Stroke="{DynamicResource Primary}" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="8,6" MinimumHeightRequest="48" IsEnabled="{Binding CanPressOilReset}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResetOilLifeHalfCommand}" />
                                </Border.GestureRecognizers>
                                <Label AutomationId="DynamicTextServiceResetHalf" Text="{Binding ResetHalfButtonText}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="WordWrap" />
                            </Border>
                        </Grid>
                        <!-- No reset button for this car: say why, instead of showing nothing. -->
                        <Label AutomationId="DynamicTextServiceResetUnavailable" IsVisible="{Binding ShowOilResetUnavailable}" Text="{Binding OilResetUnavailableText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        <HorizontalStackLayout IsVisible="{Binding IsOilResetRunning}" Spacing="8" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsOilResetRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                            <Label AutomationId="DynamicTextServiceResetProgress" Text="{Binding OilResetStatusText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label AutomationId="DynamicTextServiceResetStatus" IsVisible="{Binding IsOilResetIdle}" Text="{Binding OilResetStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding OilResetStatusColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Reminders: one short row per item -->
                <Label Text="{Binding RemindersTitle}" Style="{StaticResource SectionCaptionStyle}" />
                <Button IsVisible="{Binding ShowPartsSetup}" Text="{Binding PartsSetupText}" Command="{Binding OpenMaintenanceSetupCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource Primary}" BorderWidth="1.5" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" />
                <Border Style="{StaticResource ListCardStyle}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MaintenanceParts}" Spacing="0" Margin="0,-1,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaintenancePartRow">
                                <VerticalStackLayout Spacing="0">
                                    <BoxView Style="{StaticResource RowDividerStyle}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="14,11">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding x:DataType=vm:ServiceViewModel, Source={RelativeSource AncestorType={x:Type vm:ServiceViewModel}}, Path=OpenMaintenancePartCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Path Data="{Binding IconGeometry}" Style="{StaticResource RowIconStyle}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label AutomationId="DynamicTextServicePartName" Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                            <Label AutomationId="DynamicTextServicePartValue" Text="{Binding DueText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" BackgroundColor="{Binding PillBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="9,3" MaximumWidthRequest="100" VerticalOptions="Center">
                                            <Label Text="{Binding PillText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding PillColor}" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />
                                        </Border>
                                        <controls:Icon Grid.Column="3" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Service reminders (oil service · Service B · brake fluid …). Only what the car returns. -->
                <Border IsVisible="{Binding HasServiceReminders}" Style="{StaticResource ListCardStyle}">
                    <!-- Each row draws its divider on top; the -1 margin tucks the first one under the card edge. -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ServiceReminders}" Spacing="0" Margin="0,-1,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceReminderRow">
                                <VerticalStackLayout Spacing="0">
                                    <BoxView Style="{StaticResource RowDividerStyle}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="14,12">
                                        <Path Data="M9,3 L15,3 M12,3 L12,6 M5,14 A7,7 0 1 0 19,14 A7,7 0 1 0 5,14 M12,10 L12,14 L15,16" Style="{StaticResource RowIconStyle}" />
                                        <Label Grid.Column="1" AutomationId="DynamicTextServiceReminderTitle" Text="{Binding Title}" FontSize="14" TextColor="{DynamicResource TextColor}" VerticalTextAlignment="Center" LineBreakMode="WordWrap" />
                                        <Label Grid.Column="2" AutomationId="DynamicTextServiceReminderValue" Text="{Binding ValueText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding ValueColor}" VerticalTextAlignment="Center" HorizontalTextAlignment="End" LineBreakMode="WordWrap" MaximumWidthRequest="130" />
                                        <Button Grid.Column="3" AutomationId="DynamicTextServiceReminderReset" IsVisible="{Binding CanReset}" Text="{Binding ResetButtonText}" Command="{Binding x:DataType=vm:ServiceViewModel, Source={RelativeSource AncestorType={x:Type vm:ServiceViewModel}}, Path=ResetReminderCommand}" CommandParameter="{Binding .}" Padding="12,0" HeightRequest="30" MinimumHeightRequest="30" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="15" VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" AutomationId="DynamicTextServiceReminderManual" IsVisible="{Binding HasManualHint}" Text="{Binding ManualHint}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout IsVisible="{Binding IsReminderResetRunning}" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsReminderResetRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                </HorizontalStackLayout>
                <Label AutomationId="DynamicTextServiceReminderStatus" IsVisible="{Binding HasReminderStatus}" Text="{Binding ReminderStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding ReminderStatusColor}" LineBreakMode="WordWrap" Margin="4,0" />

                <!-- Odometer: one line, tap "Change" to correct it -->
                <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                    <Label AutomationId="DynamicTextServiceOdometer" Text="{Binding OdometerLineText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding ChangeOdometerText}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditOdometerCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Car without any service value: one short line only -->
                <Label AutomationId="DynamicTextService9" IsVisible="{Binding ShowNoServiceContent}" Text="{Binding NoServiceContentText}" HorizontalTextAlignment="Center" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="0,20,0,0" />

            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
