<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.ServicePage"
    x:DataType="vm:ServiceViewModel"
    x:Name="ServiceRoot"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding PageTitleText}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header: title · refresh -->
        <Grid Grid.Row="0" Padding="16,12,16,6" ColumnDefinitions="*,Auto" ColumnSpacing="10" BackgroundColor="{DynamicResource PageBg}">
            <Label AutomationId="DynamicTextService1" Text="{Binding HeaderTitleText}" Style="{StaticResource PageTitleStyle}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
            <Button Grid.Column="1" AutomationId="DynamicTextServiceRefresh" Text="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Padding="14,0" HeightRequest="36" MinimumHeightRequest="36" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,6,16,32" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" HorizontalOptions="Center" />

                <!-- Oil life: percentage · full · half · warning -->
                <Border IsVisible="{Binding HasOilResetCard}" Style="{StaticResource ListCardStyle}" Padding="14,12">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="0">
                            <Label AutomationId="DynamicTextServiceResetStateLabel" Text="{Binding CurrentStateText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                            <Label AutomationId="DynamicTextServiceResetState" Text="{Binding OilLifeValueText}" FontSize="30" FontAttributes="Bold" TextColor="{Binding OilLifeColor}" />
                        </VerticalStackLayout>

                        <ProgressBar Progress="{Binding OilLifeFraction}" ProgressColor="{Binding OilLifeColor}" HeightRequest="5" />

                        <Button AutomationId="DynamicTextServiceResetFull" Text="{Binding ResetFullButtonText}" Command="{Binding ResetOilLifeFullCommand}" IsEnabled="{Binding CanPressOilReset}" IsVisible="{Binding CanResetOilLife}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" FontSize="14" CornerRadius="12" />
                        <Button AutomationId="DynamicTextServiceResetHalf" Text="{Binding ResetHalfButtonText}" Command="{Binding ResetOilLifeHalfCommand}" IsEnabled="{Binding CanPressOilReset}" IsVisible="{Binding CanResetOilLife}" HeightRequest="48" FontSize="14" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" />

                        <!-- Reset progress / result (only while or after pressing a button) -->
                        <HorizontalStackLayout IsVisible="{Binding IsOilResetRunning}" Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsOilResetRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                            <Label AutomationId="DynamicTextServiceResetProgress" Text="{Binding OilResetStatusText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label AutomationId="DynamicTextServiceResetStatus" IsVisible="{Binding IsOilResetIdle}" Text="{Binding OilResetStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding OilResetStatusColor}" LineBreakMode="WordWrap" />
                        <Label AutomationId="DynamicTextServiceManualReset" IsVisible="{Binding HasOilManualReset}" Text="{Binding OilManualResetText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />

                        <Border Padding="10,8" BackgroundColor="Transparent" Stroke="#C98A1A" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                            <Label AutomationId="DynamicTextServiceResetWarning" Text="{Binding ServiceResetWarningText}" FontSize="11" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- GM oil life search (read-only): shown for GM cars while oil life is not found -->
                <Border IsVisible="{Binding ShowOilDiscovery}" Style="{StaticResource ListCardStyle}" Padding="14,12">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Path Data="M3,10 A7,7 0 1 0 17,10 A7,7 0 1 0 3,10 M15.5,15.5 L21,21" Style="{StaticResource RowIconStyle}" />
                            <Label Grid.Column="1" AutomationId="DynamicTextServiceDiscoveryTitle" Text="{Binding DiscoveryTitleText}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalTextAlignment="Center" LineBreakMode="WordWrap" />
                        </Grid>
                        <Label AutomationId="DynamicTextServiceDiscoveryHint" Text="{Binding DiscoveryHintText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        <Border Padding="12,0" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" IsEnabled="{Binding IsDiscoveryIdle}">
                            <Entry AutomationId="DynamicTextServiceDiscoveryPercent" Text="{Binding DashboardOilPercentText}" Placeholder="{Binding DiscoveryPlaceholderText}" Keyboard="Numeric" MaxLength="3" FontSize="15" TextColor="{DynamicResource TextColor}" PlaceholderColor="{DynamicResource SubTextColor}" HeightRequest="46" />
                        </Border>
                        <Button AutomationId="DynamicTextServiceDiscoveryDeep" Text="{Binding DiscoveryDeepButtonText}" Command="{Binding RunDeepOilDiscoveryCommand}" IsVisible="{Binding IsDiscoveryIdle}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" FontSize="14" CornerRadius="12" />
                        <HorizontalStackLayout IsVisible="{Binding IsDiscoveryRunning}" Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsDiscoveryRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                            <Label AutomationId="DynamicTextServiceDiscoveryProgress" Text="{Binding DiscoveryProgressText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Button AutomationId="DynamicTextServiceDiscoveryStop" Text="{Binding DiscoveryCancelText}" Command="{Binding CancelOilDiscoveryCommand}" IsVisible="{Binding IsDiscoveryRunning}" HeightRequest="44" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" />
                        <Label AutomationId="DynamicTextServiceDiscoveryResult" IsVisible="{Binding HasDiscoveryResult}" Text="{Binding DiscoveryResultText}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                        <Button AutomationId="DynamicTextServiceDiscoveryCopy" Text="{Binding DiscoveryCopyText}" Command="{Binding CopyDiscoveryReportCommand}" IsVisible="{Binding HasDiscoveryReport}" HeightRequest="36" MinimumHeightRequest="36" Padding="0" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderWidth="0" HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <!-- App oil reminder: every car that does not report its own oil service -->
                <Border IsVisible="{Binding ShowAppOilReminder}" Style="{StaticResource ListCardStyle}" Padding="14,12">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="0">
                            <Label AutomationId="DynamicTextServiceAppOilTitle" Text="{Binding AppOilTitleText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                            <Label AutomationId="DynamicTextServiceAppOilValue" Text="{Binding AppOilValueText}" FontSize="28" FontAttributes="Bold" TextColor="{Binding AppOilColor}" />
                        </VerticalStackLayout>

                        <ProgressBar IsVisible="{Binding IsAppOilStarted}" Progress="{Binding AppOilFraction}" ProgressColor="{Binding AppOilColor}" HeightRequest="5" />

                        <Button AutomationId="DynamicTextServiceAppOilButton" Text="{Binding AppOilButtonText}" Command="{Binding MarkOilChangedCommand}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" FontSize="14" CornerRadius="12" />

                        <Label AutomationId="DynamicTextServiceAppOilHint" Text="{Binding AppOilHintText}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />

                        <Border Padding="10,8" BackgroundColor="Transparent" Stroke="#C98A1A" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                            <Label AutomationId="DynamicTextServiceAppOilWarning" Text="{Binding ServiceResetWarningText}" FontSize="11" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- Service reminders (oil service · Service B · brake fluid …). Only what the car returns. -->
                <Border IsVisible="{Binding HasServiceReminders}" Style="{StaticResource ListCardStyle}">
                    <!-- Each row draws its divider on top; the -1 margin tucks the first one under the card edge. -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ServiceReminders}" Spacing="0" Margin="0,-1,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceReminderRow">
                                <VerticalStackLayout Spacing="0">
                                    <BoxView Style="{StaticResource RowDividerStyle}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="14,12">
                                        <Path Data="M14,4 L20,10 L11,19 L5,19 L5,13 Z" Style="{StaticResource RowIconStyle}" />
                                        <Label Grid.Column="1" AutomationId="DynamicTextServiceReminderTitle" Text="{Binding Title}" FontSize="14" TextColor="{DynamicResource TextColor}" VerticalTextAlignment="Center" LineBreakMode="WordWrap" />
                                        <Label Grid.Column="2" AutomationId="DynamicTextServiceReminderValue" Text="{Binding ValueText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding ValueColor}" VerticalTextAlignment="Center" HorizontalTextAlignment="End" />
                                        <Button Grid.Column="3" AutomationId="DynamicTextServiceReminderReset" IsVisible="{Binding CanReset}" Text="{Binding ResetButtonText}" Command="{Binding Source={x:Reference ServiceRoot}, Path=BindingContext.ResetReminderCommand}" CommandParameter="{Binding .}" Padding="10,0" HeightRequest="32" MinimumHeightRequest="32" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="10" VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" AutomationId="DynamicTextServiceReminderManual" IsVisible="{Binding HasManualHint}" Text="{Binding ManualHint}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout IsVisible="{Binding IsReminderResetRunning}" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsReminderResetRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                </HorizontalStackLayout>
                <Label AutomationId="DynamicTextServiceReminderStatus" IsVisible="{Binding HasReminderStatus}" Text="{Binding ReminderStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding ReminderStatusColor}" LineBreakMode="WordWrap" Margin="4,0" />

                <!-- Car without any service value: one short line only -->
                <Label AutomationId="DynamicTextService9" IsVisible="{Binding ShowNoServiceContent}" Text="{Binding NoServiceContentText}" HorizontalTextAlignment="Center" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="0,20,0,0" />

                <!-- Read-only evidence package for adding exact reset profiles later. -->
                <Border Style="{StaticResource ListCardStyle}" Padding="14,12" Margin="0,8,0,0">
                    <VerticalStackLayout Spacing="10">
                        <Label AutomationId="DynamicTextServiceValidationTitle" Text="{Binding ValidationCaptureTitleText}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                        <Label AutomationId="DynamicTextServiceValidationSubtitle" Text="{Binding ValidationCaptureSubtitleText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        <Button AutomationId="DynamicTextServiceValidationCapture" Text="{Binding ValidationCaptureButtonText}" Command="{Binding CaptureOemDataCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" FontSize="13" CornerRadius="12" />
                        <HorizontalStackLayout IsVisible="{Binding IsValidationCaptureRunning}" Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsValidationCaptureRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                            <Label Text="{Binding ValidationCaptureStatusText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label AutomationId="DynamicTextServiceValidationStatus" IsVisible="{Binding HasValidationCaptureStatus}" Text="{Binding ValidationCaptureStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
