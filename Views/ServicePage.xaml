<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    x:Class="CarScanner.Views.ServicePage"
    x:DataType="vm:ServiceViewModel"
    x:Name="ServiceRoot"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding PageTitleText}">

    <Grid RowDefinitions="Auto,*">
        <!-- Header: title · refresh -->
        <Grid Grid.Row="0" Padding="16,12,16,6" ColumnDefinitions="*,Auto" ColumnSpacing="10" BackgroundColor="{DynamicResource PageBg}">
            <Label AutomationId="DynamicTextService1" Text="{Binding HeaderTitleText}" Style="{StaticResource PageTitleStyle}" VerticalTextAlignment="Center" LineBreakMode="TailTruncation" />
            <Button Grid.Column="1" AutomationId="DynamicTextServiceRefresh" Text="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Padding="14,0" HeightRequest="36" MinimumHeightRequest="36" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" VerticalOptions="Center" />
        </Grid>

        <RefreshView Grid.Row="1" IsRefreshing="{Binding IsPullRefreshing}" Command="{Binding PullRefreshCommand}" RefreshColor="{DynamicResource Primary}">
        <ScrollView>
            <VerticalStackLayout Padding="16,6,16,32" Spacing="12">
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" HorizontalOptions="Center" />

                <!-- Oil: the value from the car and one reset button -->
                <Border IsVisible="{Binding HasOilResetCard}" Style="{StaticResource ListCardStyle}" Padding="16,14">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding OilCardTitle}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                            <Label Grid.Column="1" Text="{Binding OilSourceText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" />
                        </Grid>
                        <HorizontalStackLayout Spacing="10">
                            <Label AutomationId="DynamicTextServiceResetState" Text="{Binding OilLifeValueText}" FontSize="28" FontAttributes="Bold" TextColor="{Binding OilLifeColor}" VerticalOptions="Center" />
                            <Label IsVisible="{Binding HasOilDue}" Text="{Binding OilDueText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <ProgressBar Progress="{Binding OilLifeFraction}" ProgressColor="{Binding OilLifeColor}" HeightRequest="6" />
                        <!-- Both targets go through the same checked write-back (speed, voltage, read-back); shown only when the car supports the reset. -->
                        <Grid IsVisible="{Binding CanResetOilLife}" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Border BackgroundColor="#1D5BD6" StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="8,6" MinimumHeightRequest="48" IsEnabled="{Binding CanPressOilReset}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResetOilLifeFullCommand}" />
                                </Border.GestureRecognizers>
                                <Label AutomationId="DynamicTextServiceResetFull" Text="{Binding ResetFullButtonText}" FontSize="13" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="WordWrap" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="Transparent" Stroke="{DynamicResource Primary}" StrokeThickness="1.5" StrokeShape="RoundRectangle 12" Padding="8,6" MinimumHeightRequest="48" IsEnabled="{Binding CanPressOilReset}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResetOilLifeHalfCommand}" />
                                </Border.GestureRecognizers>
                                <Label AutomationId="DynamicTextServiceResetHalf" Text="{Binding ResetHalfButtonText}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Primary}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" HorizontalOptions="Center" VerticalOptions="Center" LineBreakMode="WordWrap" />
                            </Border>
                        </Grid>
                        <!-- No reset button for this car: say why, instead of showing nothing. -->
                        <Label AutomationId="DynamicTextServiceResetUnavailable" IsVisible="{Binding ShowOilResetUnavailable}" Text="{Binding OilResetUnavailableText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        <HorizontalStackLayout IsVisible="{Binding IsOilResetRunning}" Spacing="8" HorizontalOptions="Center">
                            <ActivityIndicator IsRunning="{Binding IsOilResetRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                            <Label AutomationId="DynamicTextServiceResetProgress" Text="{Binding OilResetStatusText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Label AutomationId="DynamicTextServiceResetStatus" IsVisible="{Binding IsOilResetIdle}" Text="{Binding OilResetStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding OilResetStatusColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <!-- Reminders: one short row per item -->
                <Label Text="{Binding RemindersTitle}" Style="{StaticResource SectionCaptionStyle}" />
                <Button IsVisible="{Binding ShowPartsSetup}" Text="{Binding PartsSetupText}" Command="{Binding OpenMaintenanceSetupCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource Primary}" BorderWidth="1.5" CornerRadius="12" HeightRequest="44" FontSize="13" FontAttributes="Bold" />
                <Border Style="{StaticResource ListCardStyle}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MaintenanceParts}" Spacing="0" Margin="0,-1,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MaintenancePartRow">
                                <VerticalStackLayout Spacing="0">
                                    <BoxView Style="{StaticResource RowDividerStyle}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" Padding="14,11">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding x:DataType=vm:ServiceViewModel, Source={RelativeSource AncestorType={x:Type vm:ServiceViewModel}}, Path=OpenMaintenancePartCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Path Data="{Binding IconGeometry}" Style="{StaticResource RowIconStyle}" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                            <Label AutomationId="DynamicTextServicePartName" Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                            <Label AutomationId="DynamicTextServicePartValue" Text="{Binding DueText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="2" BackgroundColor="{Binding PillBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="9,3" MaximumWidthRequest="100" VerticalOptions="Center">
                                            <Label Text="{Binding PillText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding PillColor}" LineBreakMode="WordWrap" HorizontalTextAlignment="Center" />
                                        </Border>
                                        <controls:Icon Grid.Column="3" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <!-- Service reminders (oil service · Service B · brake fluid …). Only what the car returns. -->
                <Border IsVisible="{Binding HasServiceReminders}" Style="{StaticResource ListCardStyle}">
                    <!-- Each row draws its divider on top; the -1 margin tucks the first one under the card edge. -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ServiceReminders}" Spacing="0" Margin="0,-1,0,0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceReminderRow">
                                <VerticalStackLayout Spacing="0">
                                    <BoxView Style="{StaticResource RowDividerStyle}" />
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="4" Padding="14,12">
                                        <Path Data="M9,3 L15,3 M12,3 L12,6 M5,14 A7,7 0 1 0 19,14 A7,7 0 1 0 5,14 M12,10 L12,14 L15,16" Style="{StaticResource RowIconStyle}" />
                                        <Label Grid.Column="1" AutomationId="DynamicTextServiceReminderTitle" Text="{Binding Title}" FontSize="14" TextColor="{DynamicResource TextColor}" VerticalTextAlignment="Center" LineBreakMode="WordWrap" />
                                        <Label Grid.Column="2" AutomationId="DynamicTextServiceReminderValue" Text="{Binding ValueText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding ValueColor}" VerticalTextAlignment="Center" HorizontalTextAlignment="End" LineBreakMode="WordWrap" MaximumWidthRequest="130" />
                                        <Button Grid.Column="3" AutomationId="DynamicTextServiceReminderReset" IsVisible="{Binding CanReset}" Text="{Binding ResetButtonText}" Command="{Binding x:DataType=vm:ServiceViewModel, Source={RelativeSource AncestorType={x:Type vm:ServiceViewModel}}, Path=ResetReminderCommand}" CommandParameter="{Binding .}" Padding="12,0" HeightRequest="30" MinimumHeightRequest="30" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="15" VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" AutomationId="DynamicTextServiceReminderManual" IsVisible="{Binding HasManualHint}" Text="{Binding ManualHint}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                    </Grid>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <HorizontalStackLayout IsVisible="{Binding IsReminderResetRunning}" Spacing="8">
                    <ActivityIndicator IsRunning="{Binding IsReminderResetRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                </HorizontalStackLayout>
                <Label AutomationId="DynamicTextServiceReminderStatus" IsVisible="{Binding HasReminderStatus}" Text="{Binding ReminderStatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding ReminderStatusColor}" LineBreakMode="WordWrap" Margin="4,0" />

                <!-- Procedures: vehicle · search · categories · list with honest compatibility status -->
                <Label Text="{Binding ProceduresTitleText}" Style="{StaticResource SectionCaptionStyle}" Margin="0,6,0,0" />

                <Border Style="{StaticResource ListCardStyle}" Padding="16,12">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{Binding VehicleLineText}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                        <Label IsVisible="{Binding HasVehicleDetail}" Text="{Binding VehicleDetailText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        <Label IsVisible="{Binding HasVehicleMissing}" Text="{Binding VehicleMissingText}" FontSize="12" TextColor="#C98A1A" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border Padding="12,0" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Path Data="M3,10 A7,7 0 1 0 17,10 A7,7 0 1 0 3,10 M15.5,15.5 L21,21" Style="{StaticResource RowIconStyle}" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding ProcedureSearchText}" Placeholder="{Binding ProcedureSearchPlaceholder}" FontSize="14" TextColor="{DynamicResource TextColor}" PlaceholderColor="{DynamicResource SubTextColor}" BackgroundColor="Transparent" ReturnType="Search" />
                        <controls:IconButton Grid.Column="2" Kind="close" Plain="True" Tint="{DynamicResource SubTextColor}" IsVisible="{Binding HasProcedureSearch}" Command="{Binding ClearProcedureSearchCommand}" WidthRequest="36" HeightRequest="36" IconSize="14" SemanticProperties.Description="Clear" />
                    </Grid>
                </Border>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" IsVisible="{Binding ShowKindChips}">
                    <HorizontalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding KindChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ServiceKindChip">
                                <Border BackgroundColor="{Binding BackgroundColor}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="12,6">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding x:DataType=vm:ServiceViewModel, Source={RelativeSource AncestorType={x:Type vm:ServiceViewModel}}, Path=SelectKindCommand}" CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{Binding Title}" FontSize="12" FontAttributes="Bold" TextColor="{Binding TextColorValue}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </ScrollView>

                <ActivityIndicator IsRunning="{Binding IsLoadingProcedures}" IsVisible="{Binding IsLoadingProcedures}" Color="{DynamicResource Primary}" HorizontalOptions="Center" />
                <Label IsVisible="{Binding HasProcedureError}" Text="{Binding ProcedureErrorText}" FontSize="12" FontAttributes="Bold" TextColor="#B3361F" LineBreakMode="WordWrap" />
                <Label IsVisible="{Binding HasProcedureEmpty}" Text="{Binding ProcedureEmptyText}" HorizontalTextAlignment="Center" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="8,4" />

                <ScrollView MaximumHeightRequest="520">
                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding ProcedureRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:ServiceProcedureRow">
                            <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                                <VerticalStackLayout Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding x:DataType=vm:ServiceViewModel, Source={RelativeSource AncestorType={x:Type vm:ServiceViewModel}}, Path=ToggleProcedureCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <VerticalStackLayout Spacing="3">
                                            <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Subtitle}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                            <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center" Margin="0,2,0,0">
                                                <Border BackgroundColor="{Binding StatusBackground}" StrokeThickness="0" StrokeShape="RoundRectangle 9" Padding="9,3" Margin="0,0,6,4">
                                                    <Label Text="{Binding StatusText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                                </Border>
                                                <Border BackgroundColor="Transparent" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 9" Padding="8,2" Margin="0,0,6,4">
                                                    <Label Text="{Binding MethodText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                                                </Border>
                                                <Border BackgroundColor="Transparent" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 9" Padding="8,2" Margin="0,0,0,4">
                                                    <Label Text="{Binding KindText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                                                </Border>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                        <controls:Icon Grid.Column="1" Kind="{Binding ChevronKind}" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" VerticalOptions="Start" />
                                    </Grid>

                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="8">
                                        <BoxView Style="{StaticResource RowDividerStyle}" />
                                        <Label Text="{Binding MethodDetailText}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                        <Label IsVisible="{Binding HasReasons}" Text="{Binding ReasonsText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                        <Label IsVisible="{Binding HasMissing}" Text="{Binding MissingText}" FontSize="12" TextColor="#C98A1A" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding PrerequisitesText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                        <Label IsVisible="{Binding HasSteps}" Text="{Binding StepsText}" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding ExpectedText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                        <Label Text="{Binding VerificationText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding VerificationColor}" LineBreakMode="WordWrap" />
                                        <Label IsVisible="{Binding HasSource}" Text="{Binding SourceText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                        <Button IsVisible="{Binding CanRunAutomatic}" Text="{Binding RunButtonText}" Command="{Binding x:DataType=vm:ServiceViewModel, Source={RelativeSource AncestorType={x:Type vm:ServiceViewModel}}, Path=RunProcedureCommand}" CommandParameter="{Binding .}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="44" CornerRadius="12" />
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
                </ScrollView>

                <!-- Odometer: one line, tap "Change" to correct it -->
                <Grid ColumnDefinitions="*,Auto" Padding="4,0">
                    <Label AutomationId="DynamicTextServiceOdometer" Text="{Binding OdometerLineText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding ChangeOdometerText}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding EditOdometerCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <!-- Car without any service value: one short line only -->
                <Label AutomationId="DynamicTextService9" IsVisible="{Binding ShowNoServiceContent}" Text="{Binding NoServiceContentText}" HorizontalTextAlignment="Center" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="0,20,0,0" />

                <!-- Help: menu guide · search · recorder -->
                <Label Text="{Binding HelpTitle}" Style="{StaticResource SectionCaptionStyle}" Margin="0,6,0,0" />
                <Border Style="{StaticResource ListCardStyle}">
                    <VerticalStackLayout Spacing="0">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12" AutomationId="DynamicTextServiceHelpMenu">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleMenuGuideCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Data="M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M12,11 L12,16 M12,8 L12,8.01" Style="{StaticResource RowIconStyle}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding HelpMenuTitle}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding HelpMenuText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <controls:Icon Grid.Column="2" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                        </Grid>
                        <Label IsVisible="{Binding ShowMenuGuide}" Text="{Binding MenuGuideText}" FontSize="12" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="14,0,14,12" />
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12" AutomationId="DynamicTextServiceHelpSearch">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleSearchCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Data="M3,10 A7,7 0 1 0 17,10 A7,7 0 1 0 3,10 M15.5,15.5 L21,21" Style="{StaticResource RowIconStyle}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding HelpSearchTitle}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding HelpSearchText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <controls:Icon Grid.Column="2" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                        </Grid>
                        <VerticalStackLayout IsVisible="{Binding ShowSearch}" Padding="14,0,14,14" Spacing="10">
                        <Label AutomationId="DynamicTextServiceDiscoveryHint" Text="{Binding DiscoveryHintText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        <Border Padding="12,0" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" IsEnabled="{Binding IsDiscoveryIdle}">
                            <Entry AutomationId="DynamicTextServiceDiscoveryPercent" Text="{Binding DashboardOilPercentText}" Placeholder="{Binding DiscoveryPlaceholderText}" Keyboard="Numeric" MaxLength="3" FontSize="15" TextColor="{DynamicResource TextColor}" PlaceholderColor="{DynamicResource SubTextColor}" HeightRequest="46" />
                        </Border>
                        <Button AutomationId="DynamicTextServiceDiscoveryDeep" Text="{Binding DiscoveryDeepButtonText}" Command="{Binding RunDeepOilDiscoveryCommand}" IsVisible="{Binding IsDiscoveryIdle}" Style="{StaticResource PrimaryButtonStyle}" HeightRequest="48" FontSize="14" CornerRadius="12" />
                        <HorizontalStackLayout IsVisible="{Binding IsDiscoveryRunning}" Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsDiscoveryRunning}" HeightRequest="16" WidthRequest="16" Color="{DynamicResource Primary}" />
                            <Label AutomationId="DynamicTextServiceDiscoveryProgress" Text="{Binding DiscoveryProgressText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" VerticalTextAlignment="Center" />
                        </HorizontalStackLayout>
                        <Button AutomationId="DynamicTextServiceDiscoveryStop" Text="{Binding DiscoveryCancelText}" Command="{Binding CancelOilDiscoveryCommand}" IsVisible="{Binding IsDiscoveryRunning}" HeightRequest="44" FontSize="13" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" />
                        <!-- Every value that answered during the search (= equals the dashboard). -->
                        <VerticalStackLayout IsVisible="{Binding HasSearchHits}" Spacing="6" BindableLayout.ItemsSource="{Binding SearchHits}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:ServiceSearchHitRow">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSearchHitTapped" />
                                        </Grid.GestureRecognizers>
                                        <controls:Icon Kind="{Binding Mark}" Tint="{Binding MarkColor}" WidthRequest="15" HeightRequest="15" VerticalOptions="Start" Margin="0,2,0,0" />
                                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                                            <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                            <Label Text="{Binding Detail}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label AutomationId="DynamicTextServiceDiscoveryResult" IsVisible="{Binding HasDiscoveryResult}" Text="{Binding DiscoveryResultText}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                        <Button AutomationId="DynamicTextServiceDiscoveryCopy" Text="{Binding DiscoveryCopyText}" Command="{Binding CopyDiscoveryReportCommand}" IsVisible="False" HeightRequest="36" MinimumHeightRequest="36" Padding="0" FontSize="12" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderWidth="0" HorizontalOptions="Start" />
                        </VerticalStackLayout>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12" AutomationId="DynamicTextServiceHelpRecorder">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenResetRecorderCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Data="M12,4 A8,8 0 1 0 12,20 A8,8 0 1 0 12,4 M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9" Style="{StaticResource RowIconStyle}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding HelpRecorderTitle}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                <Label Text="{Binding HelpRecorderText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <controls:Icon Grid.Column="2" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDividerStyle}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,12">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenPassiveCanCommand}" />
                            </Grid.GestureRecognizers>
                            <Path Data="M3,12 L7,12 L9,6 L13,18 L15,12 L21,12" Style="{StaticResource RowIconStyle}" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="CAN მოსმენა (მხოლოდ კითხვა)" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                <Label Text="მანქანის საკუთარი შეტყობინებები, opendbc-სთან შედარებით" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                            <controls:Icon Grid.Column="2" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
