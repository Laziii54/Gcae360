<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:m="clr-namespace:CarScanner.Models"
    x:Class="CarScanner.Views.Mode05Page"
    x:DataType="vm:Mode05ViewModel"
    Title="Mode 05"
    BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">
            <VerticalStackLayout Spacing="3">
                <Label Text="{Binding PageHeadingText}" Style="{StaticResource PageTitleStyle}" />
                <Label Text="{Binding PageSubtitleText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
            </VerticalStackLayout>

            <Button Text="{Binding RefreshButtonText}" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" />

            <!-- Scan status -->
            <Border Style="{StaticResource ListCardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="7">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding ScanColor}" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding ScanState}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" LineBreakMode="WordWrap" />
                        <Label Grid.Column="2" Text="{Binding ScanPercent, StringFormat='{0}%'}" FontSize="14" FontAttributes="Bold" TextColor="{Binding ScanColor}" VerticalOptions="Center" />
                    </Grid>
                    <ProgressBar Progress="{Binding ScanProgress}" ProgressColor="{Binding ScanColor}" BackgroundColor="{DynamicResource DividerColor}" />
                    <Label Text="{Binding ScanDetail}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding RawStatus}" FontSize="11" FontFamily="monospace" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Results -->
            <Label Text="{Binding ResultsCaptionText}" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Tests}" Spacing="0" Margin="0,-1,0,0">
                    <BindableLayout.EmptyView>
                        <Label Text="{Binding EmptyText}" FontSize="13" TextColor="{DynamicResource SubTextColor}" Padding="14,14" LineBreakMode="WordWrap" />
                    </BindableLayout.EmptyView>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:Mode05MonitorResult">
                            <VerticalStackLayout Spacing="0">
                                <BoxView Style="{StaticResource RowDividerStyle}" Margin="14,0,0,0" />
                                <VerticalStackLayout Spacing="3" Padding="14,13">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Label Text="{Binding Identifier}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                        <Label Grid.Column="1" Text="{Binding StatusText}" FontSize="13" FontAttributes="Bold" TextColor="{Binding StatusColor}" />
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                        <Label Text="{Binding ActualText}" FontSize="13" TextColor="{DynamicResource TextColor}" />
                                        <Label Grid.Column="1" Text="{Binding LimitText}" FontSize="12" HorizontalTextAlignment="End" TextColor="{DynamicResource SubTextColor}" />
                                    </Grid>
                                    <Label Text="{Binding RawStatus}" FontSize="11" TextColor="{DynamicResource SubTextColor}" />
                                    <Label Text="{Binding DefinitionNote}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding FooterText}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="4,0" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{Binding ScanColor}" Margin="0,6" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
