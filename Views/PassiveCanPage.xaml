<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.PassiveCanPage"
    x:DataType="vm:PassiveCanViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding PageTitle}">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

            <Border Style="{StaticResource ListCardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="6">
                    <Label Text="{Binding IntroTitle}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding IntroText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Button Text="{Binding StartText}" Command="{Binding StartCommand}" HeightRequest="48" CornerRadius="14" FontAttributes="Bold" />

            <Label Text="{Binding StatusMessage}" IsVisible="{Binding IsListening}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalOptions="Center" />

            <Border IsVisible="{Binding HasResult}" Style="{StaticResource ListCardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding ResultTitle}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding ResultText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    <VerticalStackLayout IsVisible="{Binding HasSignals}" Spacing="2">
                        <Label Text="{Binding NoticeText}" FontSize="12" FontAttributes="Bold" TextColor="#B06A00" LineBreakMode="WordWrap" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Signals}" Spacing="2">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding .}" FontSize="12" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
