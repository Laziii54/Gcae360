<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:models="clr-namespace:CarScanner.Models"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    x:Class="CarScanner.Views.SensorsPage"
    x:DataType="vm:SensorsViewModel"
    Title="ყველა სენსორი"
    BackgroundColor="{DynamicResource PageBg}">
    <Grid>
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">
            <Label Text="ყველა სენსორი" Style="{StaticResource PageTitleStyle}" />

            <Button Text="დაწყება" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="50" />
            <Label Text="განახლებისთვის დააჭირე ღილაკს" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />

            <!-- Scan progress -->
            <Border IsVisible="{Binding IsBusy}" Style="{StaticResource ListCardStyle}" Padding="14,12">
                <VerticalStackLayout Spacing="8">
                    <Label AutomationId="DynamicTextSensorProgress" Text="{Binding ScanProgressText}" TextColor="{DynamicResource TextColor}" FontSize="12" LineBreakMode="TailTruncation" />
                    <ProgressBar Progress="{Binding ScanProgress}" ProgressColor="{DynamicResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Sensors: one list card, key/value rows -->
            <Border Style="{StaticResource ListCardStyle}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Sensors.Count}" Value="0">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Sensors}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:SensorValue">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="1" Padding="14,11">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSensorTapped" />
                                    </Grid.GestureRecognizers>
                                    <Path Grid.Column="3" Grid.RowSpan="3" IsVisible="{Binding CanGraph}" Data="M4,19 L20,19 M4,19 L4,5 M7,15 L11,10 L14,13 L19,7" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" WidthRequest="15" HeightRequest="15" VerticalOptions="Center" />
                                    <Path Grid.RowSpan="3" Data="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 M12,8 L12,12 L15,14" Style="{StaticResource RowIconStyle}">
                                        <Path.Triggers>
                                            <DataTrigger TargetType="Path" Binding="{Binding LevelKey}" Value="ok">
                                                <Setter Property="Stroke" Value="#1F8A4C" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Path" Binding="{Binding LevelKey}" Value="warn">
                                                <Setter Property="Stroke" Value="#D0701F" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Path" Binding="{Binding LevelKey}" Value="crit">
                                                <Setter Property="Stroke" Value="#B3361F" />
                                            </DataTrigger>
                                        </Path.Triggers>
                                    </Path>
                                    <Label AutomationId="DynamicTextSensorName" Grid.Column="1" Text="{Binding Name}" TextColor="{DynamicResource TextColor}" FontSize="14" VerticalOptions="Center" LineBreakMode="WordWrap" />
                                    <Label AutomationId="DynamicTextSensorValue" Grid.Column="2" Text="{Binding Value}" TextColor="{DynamicResource TextColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="170">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding LevelKey}" Value="ok">
                                                <Setter Property="TextColor" Value="#1F8A4C" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding LevelKey}" Value="warn">
                                                <Setter Property="TextColor" Value="#D0701F" />
                                            </DataTrigger>
                                            <DataTrigger TargetType="Label" Binding="{Binding LevelKey}" Value="crit">
                                                <Setter Property="TextColor" Value="#B3361F" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label AutomationId="DynamicTextSensorPid" IsVisible="False" Grid.Row="1" Grid.Column="1" Text="{Binding Pid, StringFormat='PID 01{0:X2}'}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                                    <Label AutomationId="DynamicTextSensorUnit" Grid.Row="1" Grid.Column="2" Text="{Binding Unit}" TextColor="{DynamicResource SubTextColor}" FontSize="11" HorizontalTextAlignment="End" LineBreakMode="WordWrap" MaximumWidthRequest="170" />
                                    <Label AutomationId="DynamicTextSensorStatus" Grid.Row="1" Grid.Column="1" Text="{Binding StatusText}" IsVisible="{Binding HasStatus}" TextColor="{Binding StatusColor}" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" />
                                </Grid>
                                <BoxView Style="{StaticResource RowDividerStyle}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
    <!-- Tap a sensor value: its live graph slides up as a sheet. -->
    <controls:SensorGraphSheet x:Name="GraphSheet" />
    </Grid>
</ContentPage>
