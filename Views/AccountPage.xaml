<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CarScanner.Views.AccountPage"
    BackgroundColor="{DynamicResource PageBg}"
    Title="OBD360">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">

            <Label x:Name="TitleLabel" Style="{StaticResource PageTitleStyle}" />
            <Label x:Name="SubtitleLabel" FontSize="13" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />

            <!-- Signed in -->
            <Border x:Name="SignedInCard" Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 C4,17 8,15 12,15 C16,15 20,17 20,21" Style="{StaticResource RowIconStyle}" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label x:Name="SignedInAsLabel" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                            <Label x:Name="EmailValueLabel" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="0" />
                    <Button x:Name="LogoutButton" Clicked="OnLogoutClicked"
                            BackgroundColor="Transparent" TextColor="#B3361F" BorderWidth="0"
                            CornerRadius="0" HeightRequest="46" FontSize="14" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Change password: only when signed in (also forced after a temporary password) -->
            <Border x:Name="ChangePasswordCard" Style="{StaticResource ListCardStyle}" Padding="14,12">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="ChangePasswordHintLabel" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" IsVisible="False" />
                    <Button x:Name="ChangePasswordButton" Clicked="OnChangePasswordClicked"
                            BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}"
                            BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" HeightRequest="44" FontSize="14" FontAttributes="Bold" />
                    <VerticalStackLayout x:Name="ChangePasswordForm" Spacing="6" IsVisible="False">
                        <Label x:Name="CurrentPasswordLabel" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" />
                        <Entry x:Name="CurrentPasswordEntry" IsPassword="True" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" FontSize="14" />
                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                        <Label x:Name="NewPasswordLabel" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" Margin="0,8,0,0" />
                        <Entry x:Name="NewPasswordEntry" IsPassword="True" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" FontSize="14" />
                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                        <Label x:Name="RepeatPasswordLabel" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" Margin="0,8,0,0" />
                        <Entry x:Name="RepeatPasswordEntry" IsPassword="True" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" FontSize="14" />
                        <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                        <Label x:Name="NewPasswordHintLabel" FontSize="12" TextColor="{DynamicResource SubTextColor}" Margin="0,2,0,0" />
                        <Button x:Name="SavePasswordButton" Clicked="OnSavePasswordClicked" Margin="0,10,0,0"
                                Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" />
                        <Button x:Name="CancelPasswordButton" Clicked="OnCancelPasswordClicked"
                                BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0"
                                HorizontalOptions="Center" HeightRequest="38" FontSize="13" Padding="8,0" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Email verification: status and "verify" for the signed-in account (shown only when the server can send email) -->
            <Border x:Name="VerifyCard" Style="{StaticResource ListCardStyle}" Padding="14,12" IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="VerifyStatusLabel" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    <Button x:Name="VerifyEmailButton" Clicked="OnVerifyEmailClicked"
                            Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="44" FontSize="14" />
                </VerticalStackLayout>
            </Border>

            <!-- Delete account (App Store 5.1.1(v)): only when signed in -->
            <Border x:Name="DeleteCard" Style="{StaticResource ListCardStyle}" Padding="14,12">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="DeleteHintLabel" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    <Button x:Name="DeleteAccountButton" Clicked="OnDeleteAccountClicked"
                            BackgroundColor="Transparent" TextColor="#B3361F"
                            BorderColor="#B3361F" BorderWidth="1.5" CornerRadius="12" HeightRequest="44" FontSize="14" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- Sign in / create account -->
            <Border x:Name="FormCard" Style="{StaticResource ListCardStyle}" Padding="14,12">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="EmailLabel" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" />
                    <Entry x:Name="EmailEntry" Keyboard="Email" IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                           TextColor="{DynamicResource TextColor}" PlaceholderColor="{DynamicResource SubTextColor}"
                           BackgroundColor="Transparent" FontSize="14"
                           Placeholder="name@gmail.com" />
                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                    <Label x:Name="PasswordLabel" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" Margin="0,8,0,0" />
                    <Entry x:Name="PasswordEntry" IsPassword="True" TextColor="{DynamicResource TextColor}" BackgroundColor="Transparent" FontSize="14" />
                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                    <Label x:Name="PasswordHintLabel" FontSize="12" TextColor="{DynamicResource SubTextColor}" Margin="0,2,0,0" />

                    <Button x:Name="LoginButton" Clicked="OnLoginClicked" Margin="0,10,0,0"
                            Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" />
                    <Button x:Name="RegisterButton" Clicked="OnRegisterClicked"
                            BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}"
                            BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" />
                    <Button x:Name="ForgotPasswordButton" Clicked="OnForgotPasswordClicked"
                            BackgroundColor="Transparent" TextColor="{DynamicResource SubTextColor}" BorderWidth="0"
                            HorizontalOptions="Center" HeightRequest="38" FontSize="13" Padding="8,0" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False" Color="{DynamicResource Primary}" />
            <Label x:Name="StatusLabel" FontSize="13" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
