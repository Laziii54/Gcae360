<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:m="clr-namespace:CarScanner.Models"
    x:Class="CarScanner.Views.ModuleScanPage"
    x:DataType="vm:ModuleScanViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="შეცდომების სკანი">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

            <!-- "Trouble code scan" before a scan, "2 faults" after it -->
            <Label AutomationId="DynamicTextFaultSummaryTitle" Text="{Binding FaultSummaryTitle}" Style="{StaticResource PageTitleStyle}" />

            <Button Text="{Binding ScanButtonText}" Command="{Binding ScanCommand}" IsEnabled="{Binding IsNotBusy}"
                    Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="50" />

            <!-- Progress while scanning / clearing -->
            <Border IsVisible="{Binding IsBusy}" Style="{StaticResource ListCardStyle}" Padding="14,12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label AutomationId="DynamicTextModuleScanStatus" Text="{Binding Status}" TextColor="{DynamicResource TextColor}" FontSize="12" LineBreakMode="TailTruncation" />
                        <Label Grid.Column="1" AutomationId="DynamicTextModuleScanPercent" Text="{Binding ScanProgress, StringFormat='{0}%'}"
                               TextColor="{DynamicResource Primary}" FontAttributes="Bold" FontSize="12" />
                    </Grid>
                    <ProgressBar Progress="{Binding ScanProgressFraction}" ProgressColor="{DynamicResource Primary}" />
                </VerticalStackLayout>
            </Border>

            <!-- Result of the last clear: cleared / came back / refused, per module -->
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasClearResults}">
                <VerticalStackLayout Spacing="0" Padding="14,10">
                    <Label AutomationId="DynamicTextClearResultsTitle" Text="{Binding ClearResultsTitle}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" Margin="0,0,0,4" />
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding ClearResults}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ClearResultRow">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,7">
                                    <BoxView WidthRequest="9" HeightRequest="9" CornerRadius="4.5" Color="{Binding DotColor}" VerticalOptions="Start" Margin="0,5,0,0" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label AutomationId="DynamicTextClearResultTitle" Text="{Binding Title}" FontSize="13.5" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                        <Label AutomationId="DynamicTextClearResultDetail" Text="{Binding Detail}" Style="{StaticResource ReportMetaStyle}" FontSize="12.5" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Trouble codes: one list card, one row per code (empty message / "all clear" when there are none) -->
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding ModuleFaults}">
                    <BindableLayout.EmptyView>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,14">
                            <Path Data="M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 M8,12.5 L11,15.5 L16,9.5" Style="{StaticResource RowIconStyle}" Stroke="#1F8A4C" VerticalOptions="Start" />
                            <Label Grid.Column="1" AutomationId="DynamicTextModuleFaultEmpty" Text="{Binding ModuleFaultEmptyMessage}"
                                   TextColor="{DynamicResource TextColor}" FontSize="14" VerticalOptions="Center" />
                        </Grid>
                    </BindableLayout.EmptyView>

                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:ModuleFaultItem">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="5,*" ColumnSpacing="0">
                                    <BoxView Color="{Binding DotColor}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="4" Padding="14,12,14,12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Code}" Style="{StaticResource ReportCodeStyle}" VerticalOptions="Center" />
                                            <Border Grid.Column="1" BackgroundColor="{DynamicResource PageBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1"
                                                    StrokeShape="RoundRectangle 10" Padding="9,3" VerticalOptions="Center">
                                                <Label Text="{Binding Status}" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                            </Border>
                                        </Grid>
                                        <Label Text="{Binding Description}" TextColor="{DynamicResource TextColor}" FontSize="14" />
                                        <Label Text="{Binding EcuName}" Style="{StaticResource ReportMetaStyle}" FontSize="11.5" IsVisible="{Binding HasEcuName}" />

                                        <VerticalStackLayout Spacing="1" IsVisible="{Binding HasCauses}" Margin="0,6,0,0">
                                            <Label AutomationId="DynamicTextFaultCausesHeader" Text="{Binding CausesHeader}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                            <Label AutomationId="DynamicTextFaultCauses" Text="{Binding CausesText}" Style="{StaticResource ReportMetaStyle}" FontSize="12.5" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Spacing="1" IsVisible="{Binding HasChecks}" Margin="0,4,0,0">
                                            <Label AutomationId="DynamicTextFaultChecksHeader" Text="{Binding ChecksHeader}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                            <Label AutomationId="DynamicTextFaultChecks" Text="{Binding ChecksText}" Style="{StaticResource ReportMetaStyle}" FontSize="12.5" />
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Grid>
                                <BoxView HeightRequest="1" Color="{DynamicResource BorderColor}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- Repair cost estimate for the found codes (same as before) -->
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasFaults}" IsEnabled="{Binding IsNotBusy}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenRepairCostsCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                    <Path Data="M12,3 L12,21 M16,7 C16,5 14,4.5 12,4.5 C9.5,4.5 8,5.8 8,7.5 C8,11 16,9.5 16,13.5 C16,15.5 14.5,16.5 12,16.5 C9.5,16.5 8,15.5 8,14" Style="{StaticResource RowIconStyle}" />
                    <Label Grid.Column="1" AutomationId="DynamicTextRepairCostButton" Text="{Binding RepairCostButtonText}" Style="{StaticResource RowTitleStyle}" />
                    <Label Grid.Column="2" Text="›" FontSize="22" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <!-- Clear the codes: only offered when there is something to clear -->
            <Button Text="{Binding ClearDtcButtonText}" Command="{Binding ClearDtcCommand}" IsEnabled="{Binding IsNotBusy}" IsVisible="{Binding HasFaults}"
                    BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}"
                    BorderWidth="1" CornerRadius="12" HeightRequest="46" FontSize="13" FontAttributes="Bold" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
