<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.CustomsCalculatorPage"
    x:DataType="vm:CustomsCalculatorViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding PageTitle}">

    <ContentPage.Resources>
        <!-- Small caption above every field. -->
        <Style x:Key="FieldLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{DynamicResource SubTextColor}" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>

        <!-- Rounded input box. -->
        <Style x:Key="InputBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource PageBg}" />
            <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HeightRequest" Value="48" />
        </Style>

        <Style x:Key="InputEntry" TargetType="Entry">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="Keyboard" Value="Numeric" />
            <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
            <Setter Property="PlaceholderColor" Value="{DynamicResource SubTextColor}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource CardBg}" />
            <Setter Property="Stroke" Value="{DynamicResource BorderColor}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            <Setter Property="Padding" Value="16,14,16,16" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="Label">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{DynamicResource TextColor}" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <!-- Selectable chip (fuel, steering, currency, engine size). -->
        <DataTemplate x:Key="ChipTemplate" x:DataType="vm:CustomsChip">
            <Border Padding="14,0" HeightRequest="42" Margin="0,0,8,8" StrokeThickness="1.5"
                    StrokeShape="RoundRectangle 21"
                    BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TapCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Label Text="{Binding Text}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"
                           TextColor="{DynamicResource TextColor}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Label Text="{Binding SubText}" IsVisible="{Binding HasSubText}" FontSize="11" VerticalOptions="Center"
                           TextColor="{DynamicResource SubTextColor}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="#DCE6FF" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </HorizontalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">

        <!-- ===== Always-visible live total ===== -->
        <Border Grid.Row="0" Margin="12,8,12,4" Padding="18,14" StrokeThickness="0"
                StrokeShape="RoundRectangle 18" BackgroundColor="#0F1B33">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                <Label Text="{Binding TotalCaption}" FontSize="12" TextColor="#9FB3D9" />
                <Label Grid.Row="1" Text="{Binding TotalText}" FontSize="30" FontAttributes="Bold" TextColor="White"
                       IsVisible="{Binding HasResult}" />
                <Label Grid.Row="1" Text="—" FontSize="30" FontAttributes="Bold" TextColor="#4B5D80"
                       IsVisible="{Binding HasResult, Converter={StaticResource InverseBoolConverter}}" />
                <Label Grid.Row="2" Text="{Binding TotalForeignText}" FontSize="13" TextColor="#9FB3D9" />

                <VerticalStackLayout Grid.Column="1" Grid.RowSpan="3" VerticalOptions="Center" Spacing="6"
                                     IsVisible="{Binding HasResult}">
                    <Label Text="{Binding ExciseCaption}" FontSize="11" TextColor="#9FB3D9" HorizontalOptions="End" />
                    <Label Text="{Binding ExciseText}" FontSize="18" FontAttributes="Bold" TextColor="#7FB0FF" HorizontalOptions="End" />
                    <Border Padding="8,3" StrokeThickness="0" StrokeShape="RoundRectangle 8" BackgroundColor="#1E3A2B"
                            HorizontalOptions="End">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding AgeIsYoung}" Value="False">
                                <Setter Property="BackgroundColor" Value="#4A2A12" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{Binding AgeBadgeText}" FontSize="11" FontAttributes="Bold" TextColor="#86EFAC">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding AgeIsYoung}" Value="False">
                                    <Setter Property="TextColor" Value="#FDBA74" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="12,8,12,32" Spacing="12">

                <VerticalStackLayout Spacing="2" Margin="4,4,4,0">
                    <Label Text="{Binding PageTitle}" Style="{StaticResource PageTitleStyle}" />
                    <Label Text="{Binding PageSubtitle}" FontSize="13" TextColor="{DynamicResource SubTextColor}" />
                </VerticalStackLayout>

                <!-- ===== Car ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="{Binding CarSection}" Style="{StaticResource SectionHeader}" Margin="0" />

                        <VerticalStackLayout>
                            <Label Text="{Binding YearLabel}" Style="{StaticResource FieldLabel}" />
                            <Grid ColumnDefinitions="48,*,48" ColumnSpacing="8">
                                <Button Text="−" Command="{Binding YearMinusCommand}" FontSize="22" Padding="0"
                                        HeightRequest="48" CornerRadius="10" BorderWidth="1"
                                        BorderColor="{DynamicResource BorderColor}" BackgroundColor="{DynamicResource PageBg}"
                                        TextColor="{DynamicResource TextColor}" />
                                <Border Grid.Column="1" Style="{StaticResource InputBox}">
                                    <Entry Text="{Binding YearText}" Placeholder="2020" MaxLength="4"
                                           HorizontalTextAlignment="Center" Style="{StaticResource InputEntry}" />
                                </Border>
                                <Button Grid.Column="2" Text="+" Command="{Binding YearPlusCommand}" FontSize="22" Padding="0"
                                        HeightRequest="48" CornerRadius="10" BorderWidth="1"
                                        BorderColor="{DynamicResource BorderColor}" BackgroundColor="{DynamicResource PageBg}"
                                        TextColor="{DynamicResource TextColor}" />
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="{Binding FuelLabel}" Style="{StaticResource FieldLabel}" />
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding FuelChips}"
                                        BindableLayout.ItemTemplate="{StaticResource ChipTemplate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout IsVisible="{Binding IsEngineVisible}">
                            <Label Text="{Binding EngineLabel}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBox}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Entry Text="{Binding EngineText}" Placeholder="2.0" MaxLength="5" Style="{StaticResource InputEntry}" />
                                    <Label Grid.Column="1" Text="L / cm³" FontSize="12" VerticalOptions="Center"
                                           TextColor="{DynamicResource SubTextColor}" />
                                </Grid>
                            </Border>
                            <Label Text="{Binding EngineHint}" FontSize="11" TextColor="{DynamicResource SubTextColor}" Margin="2,4,0,8" />
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding EngineChips}"
                                        BindableLayout.ItemTemplate="{StaticResource ChipTemplate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="{Binding SteeringLabel}" Style="{StaticResource FieldLabel}" />
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding SteeringChips}"
                                        BindableLayout.ItemTemplate="{StaticResource ChipTemplate}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Purchase and shipping ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding CostsSection}" Style="{StaticResource SectionHeader}" Margin="0" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout>
                            <Label Text="{Binding CurrencyLabel}" Style="{StaticResource FieldLabel}" />
                            <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CurrencyChips}"
                                        BindableLayout.ItemTemplate="{StaticResource ChipTemplate}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout>
                            <Label Text="{Binding PriceLabel}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBox}">
                                <Entry Text="{Binding PriceText}" Placeholder="9000" Style="{StaticResource InputEntry}" />
                            </Border>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout>
                                <Label Text="{Binding AuctionLabel}" Style="{StaticResource FieldLabel}" LineBreakMode="TailTruncation" />
                                <Border Style="{StaticResource InputBox}">
                                    <Entry Text="{Binding AuctionText}" Placeholder="700" Style="{StaticResource InputEntry}" />
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="{Binding ShippingLabel}" Style="{StaticResource FieldLabel}" LineBreakMode="TailTruncation" />
                                <Border Style="{StaticResource InputBox}">
                                    <Entry Text="{Binding ShippingText}" Placeholder="1800" Style="{StaticResource InputEntry}" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout>
                            <Label Text="{Binding RateLabel}" Style="{StaticResource FieldLabel}" />
                            <Border Style="{StaticResource InputBox}">
                                <Entry Text="{Binding RateText}" Placeholder="2.70" Style="{StaticResource InputEntry}" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== In Georgia ===== -->
                <Border Style="{StaticResource SectionCard}">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding LocalSection}" Style="{StaticResource SectionHeader}" Margin="0,0,0,6" />
                        <Label Text="{Binding LocalCostsLabel}" Style="{StaticResource FieldLabel}" />
                        <Border Style="{StaticResource InputBox}">
                            <Entry Text="{Binding LocalCostsText}" Placeholder="0" Style="{StaticResource InputEntry}" />
                        </Border>
                        <Label Text="{Binding LocalCostsHint}" FontSize="11" TextColor="{DynamicResource SubTextColor}" Margin="2,0,0,0" />
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Waiting for input ===== -->
                <Border Style="{StaticResource SectionCard}" IsVisible="{Binding HasResult, Converter={StaticResource InverseBoolConverter}}">
                    <Label Text="{Binding PlaceholderText}" FontSize="14" TextColor="{DynamicResource SubTextColor}"
                           HorizontalTextAlignment="Center" Margin="0,6" />
                </Border>

                <!-- ===== Breakdown ===== -->
                <Border Style="{StaticResource SectionCard}" IsVisible="{Binding HasResult}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding BreakdownCaption}" Style="{StaticResource SectionHeader}" Margin="0" />
                            <Label Grid.Column="1" Text="{Binding TaxesText}" FontSize="12" FontAttributes="Bold"
                                   TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                        </Grid>
                        <Label Text="{Binding CarSummaryText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" Margin="0,-6,0,0" />

                        <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Rows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:CustomsCostRow">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <HorizontalStackLayout Spacing="8">
                                                <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding BarColor}" VerticalOptions="Center" />
                                                <Label Text="{Binding Title}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                            </HorizontalStackLayout>
                                            <Label Grid.Column="1" Text="{Binding Amount}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                        </Grid>
                                        <ProgressBar Progress="{Binding Share}" ProgressColor="{Binding BarColor}" HeightRequest="6" />
                                        <Label Text="{Binding Detail}" IsVisible="{Binding HasDetail}" FontSize="11.5"
                                               TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border IsVisible="{Binding HasPriceHint}" Padding="12,10" StrokeThickness="0"
                                StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource PageBg}">
                            <Label Text="{Binding PriceHintText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Hints (age limit, right-hand drive, hybrid relief) ===== -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasResult}" BindableLayout.ItemsSource="{Binding Hints}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CustomsHint">
                            <Border Padding="12,10" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{DynamicResource InfoBg}" Stroke="{DynamicResource InfoStroke}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsWarning}" Value="True">
                                        <Setter Property="BackgroundColor" Value="#FFF6E8" />
                                        <Setter Property="Stroke" Value="#F6D49B" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                    <Border WidthRequest="22" HeightRequest="22" StrokeThickness="0" StrokeShape="RoundRectangle 11"
                                            BackgroundColor="#1D5BD6" VerticalOptions="Start">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsWarning}" Value="True">
                                                <Setter Property="BackgroundColor" Value="#D97706" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Icon}" FontSize="12" FontAttributes="Bold" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="1" Text="{Binding Text}" FontSize="13" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Label Text="{Binding NoteText}" FontSize="11.5" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="4,4,4,0" />
                <Label Text="{Binding RulesText}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="4,0" />
                <Button Text="{Binding OfficialText}" Command="{Binding OpenOfficialCommand}" BackgroundColor="Transparent"
                        TextColor="{DynamicResource Primary}" BorderWidth="0" FontAttributes="Bold" FontSize="13"
                        HorizontalOptions="Start" Padding="4,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
