<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.MileagePage"
    x:DataType="vm:MileageViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="გარბენის გადამოწმება">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">
            <Label Text="გარბენის გადამოწმება" Style="{StaticResource PageTitleStyle}" />

            <!-- Result -->
            <Border Style="{StaticResource ListCardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="შედეგი" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                    <Label AutomationId="DynamicTextMileageResult" Text="{Binding Result}" TextColor="{DynamicResource TextColor}" FontSize="26" FontAttributes="Bold" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- Vehicle -->
            <Border Style="{StaticResource ListCardStyle}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                    <Path Data="M3,17 L3,12 L5.5,6.5 L18.5,6.5 L21,12 L21,17 Z M3,12 L21,12 M7,17 L7,20 M17,17 L17,20" Style="{StaticResource RowIconStyle}" />
                    <Label Grid.Column="1" Text="VIN" Style="{StaticResource RowTitleStyle}" />
                    <Label Grid.Column="2" AutomationId="DynamicTextMileageVin" Text="{Binding Vin}" TextColor="{DynamicResource SubTextColor}" FontSize="13" FontFamily="monospace" VerticalOptions="Center" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                </Grid>
            </Border>

            <Button Text="გარბენის შემოწმება" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="52" Margin="0,4,0,0" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
