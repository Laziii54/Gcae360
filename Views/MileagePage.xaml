<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.MileagePage"
    x:DataType="vm:MileageViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

            <!-- The car -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Ellipse WidthRequest="9" HeightRequest="9" Fill="#22A35A" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="{Binding VehicleTitle}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                        <Label AutomationId="DynamicTextMileageVin" Text="{Binding Vin}" FontSize="11" FontFamily="monospace" TextColor="{DynamicResource SubTextColor}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Before the check: what it does -->
            <Border IsVisible="{Binding IsIntro}" Style="{StaticResource ListCardStyle}" Padding="18,22">
                <VerticalStackLayout Spacing="8">
                    <Path Data="M4,17 A9,9 0 1 1 20,17 M12,13 L16,8" Stroke="{DynamicResource Primary}" StrokeThickness="2.2" StrokeLineCap="Round" Aspect="Uniform" WidthRequest="40" HeightRequest="30" HorizontalOptions="Center" />
                    <Label Text="{Binding IntroTitle}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                    <Label Text="{Binding IntroText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- After the check: the answer on top -->
            <Border IsVisible="{Binding HasResult}" Padding="16,14" BackgroundColor="{Binding ResultBackground}" Stroke="{Binding CardStroke}" StrokeThickness="1" StrokeShape="RoundRectangle 14">
                <VerticalStackLayout Spacing="4">
                    <Label AutomationId="DynamicTextMileageStatus" Text="{Binding ResultTitle}" FontSize="17" FontAttributes="Bold" TextColor="{Binding ResultTitleColor}" LineBreakMode="WordWrap" />
                    <Label AutomationId="DynamicTextMileageResult" Text="{Binding ResultValue}" FontSize="26" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    <Label Text="{Binding VerdictNote}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <!-- One row per module -->
            <Border IsVisible="{Binding HasModules}" Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Modules}" Spacing="0" Margin="0,-1,0,0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:MileageModuleRow">
                            <VerticalStackLayout Spacing="0" BackgroundColor="{Binding RowBackground}">
                                <BoxView Style="{StaticResource RowDividerStyle}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Padding="14,12">
                                    <Label Text="{Binding Name}" FontSize="14" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding ValueText}" FontSize="14" FontAttributes="Bold" TextColor="{Binding ValueColor}" HorizontalTextAlignment="End" VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>


            <!-- Odometer finder: when this model's odometer place is not known yet -->
            <Border IsVisible="{Binding ShowFinder}" Style="{StaticResource ListCardStyle}" Padding="14,12">
                <VerticalStackLayout Spacing="8">
                    <Label AutomationId="DynamicTextFinderTitle" Text="{Binding FinderTitle}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    <Label AutomationId="DynamicTextFinderText" Text="{Binding FinderText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="10,0" BackgroundColor="{DynamicResource PageBg}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry Text="{Binding DashboardMileage}" Placeholder="{Binding DashboardPlaceholder}" Keyboard="Numeric" FontSize="15" TextColor="{DynamicResource TextColor}" />
                                <Label Grid.Column="1" AutomationId="DynamicTextFinderUnit" Text="{Binding DashboardUnit}" FontSize="13" TextColor="{DynamicResource SubTextColor}" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Text="{Binding FinderButtonText}" Command="{Binding SearchOdometerCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="10" HeightRequest="44" Padding="16,0" />
                    </Grid>
                    <ProgressBar IsVisible="{Binding IsFinding}" Progress="{Binding FinderProgress}" ProgressColor="{DynamicResource Primary}" />
                    <Label AutomationId="DynamicTextFinderStatus" Text="{Binding FinderStatus}" IsVisible="{Binding HasFinderStatus}" FontSize="12" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    <VerticalStackLayout IsVisible="{Binding HasFinderMatches}" Spacing="0" BindableLayout.ItemsSource="{Binding FinderMatches}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:OdometerMatchRow">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Padding="0,6">
                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label AutomationId="DynamicTextFinderMatch" Text="{Binding Title}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                                        <Label AutomationId="DynamicTextFinderMatchDetail" Text="{Binding Detail}" FontSize="11" FontFamily="monospace" TextColor="{DynamicResource SubTextColor}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Button IsVisible="{Binding HasFinderMatches}" Text="{Binding SaveFoundText}" Command="{Binding SaveFoundCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="10" HeightRequest="44" />
                </VerticalStackLayout>
            </Border>

            <!-- One button: filled before the check, outlined after it -->
            <Button IsVisible="{Binding HasResult, Converter={StaticResource InverseBoolConverter}}" Text="{Binding CheckButtonText}" Command="{Binding CheckCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="52" />
            <Button IsVisible="{Binding HasResult}" Text="{Binding CheckButtonText}" Command="{Binding CheckCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.2" />
            <Label IsVisible="{Binding IsIntro}" Text="{Binding IntroHint}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" />
            <Label AutomationId="DynamicTextMileageProgress" Text="{Binding StatusMessage}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

            <!-- Technical log -->
            <Button IsVisible="False" Text="{Binding LogToggleText}" Command="{Binding ToggleLogCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center" HeightRequest="36" />
            <Border IsVisible="False" Style="{StaticResource ListCardStyle}" Padding="12,10">
                <VerticalStackLayout Spacing="6">
                    <Label AutomationId="DynamicTextMileageLog" Text="{Binding Log}" FontSize="11" FontFamily="monospace" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    <Button Text="{Binding CopyLogText}" Command="{Binding CopyLogCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" HorizontalOptions="Start" HeightRequest="34" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
