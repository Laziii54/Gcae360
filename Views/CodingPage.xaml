<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.CodingPage"
    x:DataType="vm:CodingViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="კოდირება">

    <ScrollView>
        <VerticalStackLayout Padding="14,10,14,34" Spacing="8">
            <Label Text="კოდირება" Style="{StaticResource PageTitleStyle}" />
            <Label AutomationId="DynamicTextCodingVehicle" Text="{Binding VehicleText}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />

            <!-- Safety -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12" BackgroundColor="{DynamicResource WarnBg}" Stroke="{DynamicResource WarnStroke}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="⚠ როგორ ვიცავთ მანქანას" TextColor="{DynamicResource WarnTitle}" FontSize="14" FontAttributes="Bold" />
                    <Label Text="• ჯერ ყოველთვის სრული სარეზერვო ასლი იქმნება." TextColor="{DynamicResource WarnText}" FontSize="12" />
                    <Label Text="• იცვლება მხოლოდ ის, რაც ზუსტად ამ მოდელზე, წელზე და მოდულზეა შემოწმებული." TextColor="{DynamicResource WarnText}" FontSize="12" />
                    <Label Text="• მანქანა უნდა იდგეს, ძრავი გამორთული, აკუმულატორი 12.2 V-ზე მეტი." TextColor="{DynamicResource WarnText}" FontSize="12" />
                    <Label Text="• ჩაწერის შემდეგ მნიშვნელობა მოწმდება; შეუსაბამობისას ძველი ავტომატურად ბრუნდება." TextColor="{DynamicResource WarnText}" FontSize="12" />
                    <Label Text="• ნებისმიერი ცვლილება ისტორიიდან ერთი შეხებით ბრუნდება." TextColor="{DynamicResource WarnText}" FontSize="12" />
                </VerticalStackLayout>
            </Border>

            <!-- Progress -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,10" IsVisible="{Binding IsBusy}">
                <VerticalStackLayout Spacing="6">
                    <ProgressBar Progress="{Binding Progress}" ProgressColor="{DynamicResource Primary}" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label AutomationId="DynamicTextCodingProgress" Text="{Binding ProgressText}" TextColor="{DynamicResource TextColor}" FontSize="12" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="გაჩერება" Command="{Binding CancelCommand}" BackgroundColor="Transparent" TextColor="#C2372B" FontAttributes="Bold" FontSize="12" Padding="4,0" HeightRequest="44" MinimumHeightRequest="44" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label AutomationId="DynamicTextCodingResult" Text="{Binding ProgressText}" TextColor="{DynamicResource SubTextColor}" FontSize="12">
                <Label.Triggers>
                    <DataTrigger TargetType="Label" Binding="{Binding IsBusy}" Value="True">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- Settings for this car -->
            <Label Text="ამ მანქანის პარამეტრები" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12" IsVisible="{Binding HasNoOptions}">
                <VerticalStackLayout Spacing="5">
                    <Label Text="ამ მანქანისთვის შემოწმებული პარამეტრი ჯერ არ არის." TextColor="{DynamicResource TextColor}" FontSize="13.5" FontAttributes="Bold" />
                    <Label Text="ჩვენ არ ვწერთ არაფერს, რაც ზუსტად თქვენს მოდელზე არ არის გამოცდილი — ეს იცავს მოდულებს დაზიანებისგან. ასე დაგვეხმარებით დამატებაში:" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                    <Label Text="1. შექმენით სარეზერვო ასლი ქვემოთ." TextColor="{DynamicResource TextColor}" FontSize="12" />
                    <Label Text="2. შეცვალეთ პარამეტრი მანქანის მენიუდან ან სერვისში." TextColor="{DynamicResource TextColor}" FontSize="12" />
                    <Label Text="3. შექმენით მეორე ასლი და მონიშნეთ ორივე — ნახავთ, ზუსტად რა შეიცვალა." TextColor="{DynamicResource TextColor}" FontSize="12" />
                    <Label Text="4. გაგვიზიარეთ ორივე ასლი — შემოწმების შემდეგ პარამეტრი აქ გამოჩნდება." TextColor="{DynamicResource TextColor}" FontSize="12" />
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasOptions}">
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Options}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CodingOptionRow">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label AutomationId="DynamicTextCodingOptionTitle" Text="{Binding Title}" TextColor="{DynamicResource TextColor}" FontSize="14" FontAttributes="Bold" />
                                        <Label AutomationId="DynamicTextCodingOptionDescription" Text="{Binding Description}" TextColor="{DynamicResource SubTextColor}" FontSize="11.5" />
                                        <Label AutomationId="DynamicTextCodingOptionCurrent" Text="{Binding CurrentText}" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="წაკითხვა" Command="{Binding ReadOptionCommand, x:DataType=vm:CodingViewModel, Source={RelativeSource AncestorType={x:Type vm:CodingViewModel}}}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" Padding="4,0" HeightRequest="44" MinimumHeightRequest="44" VerticalOptions="Center" />
                                    <Button Grid.Column="2" Text="{Binding ChangeButtonText, x:DataType=vm:CodingViewModel, Source={RelativeSource AncestorType={x:Type vm:CodingViewModel}}}" Command="{Binding ChangeOptionCommand, x:DataType=vm:CodingViewModel, Source={RelativeSource AncestorType={x:Type vm:CodingViewModel}}}" CommandParameter="{Binding .}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="10" FontSize="12" Padding="10,0" HeightRequest="44" MinimumHeightRequest="44" VerticalOptions="Center" />
                                </Grid>
                                <BoxView Style="{StaticResource RowDividerStyle}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- Backups -->
            <Label Text="სარეზერვო ასლები" Style="{StaticResource SectionCaptionStyle}" />
            <Button Text="სრული სარეზერვო ასლის შექმნა" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" HeightRequest="46" />
            <Label Text="მხოლოდ კითხულობს ყველა მოდულს — მანქანაზე არაფერი იცვლება. შედარებისთვის შეეხეთ ორ ასლს." TextColor="{DynamicResource SubTextColor}" FontSize="11" />
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasBackups}">
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Backups}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CodingBackupRow">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Padding="12,9">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleCompareCommand, x:DataType=vm:CodingViewModel, Source={RelativeSource AncestorType={x:Type vm:CodingViewModel}}}" CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Label Text="○" TextColor="{DynamicResource SubTextColor}" FontSize="18" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Text" Value="●" />
                                                <Setter Property="TextColor" Value="{DynamicResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                        <Label AutomationId="DynamicTextCodingBackupTitle" Text="{Binding Title}" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" />
                                        <Label AutomationId="DynamicTextCodingBackupDetail" Text="{Binding Detail}" TextColor="{DynamicResource SubTextColor}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="2" Text="გაზიარება" Command="{Binding ShareBackupCommand, x:DataType=vm:CodingViewModel, Source={RelativeSource AncestorType={x:Type vm:CodingViewModel}}}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" Padding="4,0" HeightRequest="44" MinimumHeightRequest="44" VerticalOptions="Center" />
                                    <Button Grid.Column="3" Text="✕" Command="{Binding DeleteBackupCommand, x:DataType=vm:CodingViewModel, Source={RelativeSource AncestorType={x:Type vm:CodingViewModel}}}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#C2372B" FontSize="13" Padding="4,0" HeightRequest="44" MinimumHeightRequest="44" WidthRequest="44" VerticalOptions="Center" />
                                </Grid>
                                <BoxView Style="{StaticResource RowDividerStyle}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- Compare -->
            <Label AutomationId="DynamicTextCodingCompare" Text="{Binding CompareText}" IsVisible="{Binding HasCompareText}" TextColor="{DynamicResource TextColor}" FontSize="12.5" FontAttributes="Bold" />
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasDifferences}">
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding Differences}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CodingDiffRow">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" Padding="12,8">
                                    <VerticalStackLayout Spacing="1">
                                        <Label AutomationId="DynamicTextCodingDiffModule" Text="{Binding Module}" TextColor="{DynamicResource TextColor}" FontSize="12.5" FontAttributes="Bold" />
                                        <Label AutomationId="DynamicTextCodingDiffLocation" Text="{Binding Location}" TextColor="{DynamicResource SubTextColor}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" AutomationId="DynamicTextCodingDiffChange" Text="{Binding Change}" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" FontFamily="monospace" VerticalOptions="Center" />
                                </Grid>
                                <BoxView Style="{StaticResource RowDividerStyle}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- History -->
            <Label Text="ცვლილებების ისტორია" Style="{StaticResource SectionCaptionStyle}" IsVisible="{Binding HasHistory}" />
            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasHistory}">
                <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding HistoryRows}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:CodingHistoryRow">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="*,Auto" Padding="12,9" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="1">
                                        <Label AutomationId="DynamicTextCodingHistoryTitle" Text="{Binding Title}" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" />
                                        <Label AutomationId="DynamicTextCodingHistoryDetail" Text="{Binding Detail}" TextColor="{DynamicResource SubTextColor}" FontSize="11" />
                                    </VerticalStackLayout>
                                    <Button Grid.Column="1" Text="აღდგენა" IsVisible="{Binding CanRestore}" Command="{Binding RestoreCommand, x:DataType=vm:CodingViewModel, Source={RelativeSource AncestorType={x:Type vm:CodingViewModel}}}" CommandParameter="{Binding .}" BackgroundColor="Transparent" TextColor="#C2372B" FontSize="12" FontAttributes="Bold" Padding="4,0" HeightRequest="44" MinimumHeightRequest="44" VerticalOptions="Center" />
                                </Grid>
                                <BoxView Style="{StaticResource RowDividerStyle}" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
