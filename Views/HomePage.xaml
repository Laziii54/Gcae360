<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.HomePage"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="Georgian Car Scanner">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

            <!-- Top bar: back to start (OBD2 / VIN) · brand · PRO · language · account -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="8">
                <Border WidthRequest="30" HeightRequest="34" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center" SemanticProperties.Description="Back">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackToStartTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M15,5 L8,12 L15,19" Stroke="{DynamicResource Primary}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                </Border>
                <Border Grid.Column="1" WidthRequest="30" HeightRequest="30" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                    <Label Text="G" TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="2" Text="GCar360" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                <Button Grid.Column="3" Text="{Binding ProButtonText}" Command="{Binding GoToProCommand}" BackgroundColor="{DynamicResource ProBadgeBg}" TextColor="{DynamicResource ProBadgeText}" BorderWidth="0" CornerRadius="22" Padding="14,0" HeightRequest="44" MinimumHeightRequest="44" FontAttributes="Bold" FontSize="12" HorizontalOptions="End" VerticalOptions="Center" />
                <Button x:Name="LanguageToggleButton" Grid.Column="4" Text="🇬🇧" Command="{Binding ToggleLanguageCommand}" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="22" Padding="10,0" HeightRequest="44" MinimumHeightRequest="44" MinimumWidthRequest="44" FontSize="12" FontAttributes="Bold" HorizontalOptions="End" />
                <!-- Settings (also on the "All tools" page) -->
                <Border Grid.Column="5" WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 17" VerticalOptions="Center" SemanticProperties.Description="Settings">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                    </Border.GestureRecognizers>
                    <Path Data="M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 M12,2.5 L12,5.5 M12,18.5 L12,21.5 M2.5,12 L5.5,12 M18.5,12 L21.5,12 M5.3,5.3 L7.4,7.4 M16.6,16.6 L18.7,18.7 M5.3,18.7 L7.4,16.6 M16.6,7.4 L18.7,5.3" Stroke="{DynamicResource TextColor}" StrokeThickness="1.7" StrokeLineCap="Round" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                </Border>
                <!-- Account: sign in / register -->
                <Border Grid.Column="6" WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 17" VerticalOptions="Center" SemanticProperties.Description="Account">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAccountTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 C4,17 8,15 12,15 C16,15 20,17 20,21" Stroke="{DynamicResource TextColor}" StrokeThickness="1.7" StrokeLineCap="Round" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                </Border>
            </Grid>

            <!-- Connection -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BeginConnectionCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding StatusColor}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="დაკავშირება" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                        <Label AutomationId="ConnectionStatusLabel" Text="{Binding ConnectionStatus}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" IsVisible="{Binding IsConnected}" Source="{Binding ConnectedBrandImage}" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" IsVisible="False">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Grid>
            </Border>

            <!-- Vehicle -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                <VerticalStackLayout Spacing="4">
                    <Label AutomationId="DynamicTextVehicle" Text="{Binding VehicleName}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label AutomationId="DynamicTextVin" Text="{Binding VinNumber}" FontSize="12" FontFamily="monospace" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        <!-- Copy the VIN (shown only when a real VIN was read) -->
                        <Border x:Name="CopyVinButton" Grid.Column="1" IsVisible="{Binding HasCopyableVin}" Padding="8,3" BackgroundColor="Transparent" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCopyVinTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4" InputTransparent="True">
                                <Path x:Name="CopyVinIcon" Data="M9,9 L20,9 L20,20 L9,20 Z M5,15 L5,4 L16,4" Stroke="{DynamicResource Primary}" StrokeThickness="1.7" StrokeLineJoin="Round" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                <Label x:Name="CopyVinLabel" Text="copy" FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="2" Margin="0,4,0,0">
                        <Label AutomationId="DynamicTextTrimLabel" Text="{Binding TrimLabel}" FontSize="11" TextColor="{DynamicResource SubTextColor}" />
                        <Label AutomationId="DynamicTextTrim" Grid.Column="1" Text="{Binding VehicleTrim}" FontSize="12" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                        <Label AutomationId="DynamicTextFuelLabel" Grid.Row="1" Text="{Binding FuelLabel}" FontSize="11" TextColor="{DynamicResource SubTextColor}" />
                        <Label AutomationId="DynamicTextFuel" Grid.Row="1" Grid.Column="1" Text="{Binding FuelType}" FontSize="12" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                    </Grid>
                    <Button Text="განახლება" Command="{Binding RefreshVehicleIdentityCommand}" IsVisible="{Binding IsConnected}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderWidth="0" Padding="0" HeightRequest="44" MinimumHeightRequest="44" FontSize="12" FontAttributes="Bold" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- AI: ask a question right here (PRO). The send button says "PRO" until PRO is active. -->
            <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsConnected}" Opacity="0.45">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>
                <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="14,3,5,3">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <!-- Chat bubble with a pulse line: "talk about the car" -->
                        <Path Data="M4,5 L20,5 L20,16 L10,16 L6,20 L6,16 L4,16 Z M7,11 L9.5,11 L11.5,8 L13.5,13.5 L15,11 L17,11" Stroke="{DynamicResource Primary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding AiQuestion}" Placeholder="ჰკითხე AI-ს: რა სჭირს მანქანას?" PlaceholderColor="{DynamicResource SubTextColor}" TextColor="{DynamicResource TextColor}" FontSize="14" ReturnType="Send" ReturnCommand="{Binding AskAiCommand}" BackgroundColor="Transparent" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="{Binding AiSendText}" Command="{Binding AskAiCommand}" BackgroundColor="{DynamicResource Primary}" TextColor="White" FontAttributes="Bold" FontSize="13" CornerRadius="18" HeightRequest="36" MinimumHeightRequest="36" MinimumWidthRequest="36" Padding="12,0" BorderWidth="0" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- PRO tiles 2 x 2 -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8" IsEnabled="{Binding IsConnected}" Opacity="0.45">
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </Grid.Triggers>
                <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource ListCardStyle}" Padding="12,11">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToModulesCommand}" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M4,8 L4,4 L8,4 M16,4 L20,4 L20,8 M20,16 L20,20 L16,20 M8,20 L4,20 L4,16 M8,12 L16,12" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Border Style="{StaticResource ProBadgeStyle}" IsVisible="{Binding ShowProBadges}" HorizontalOptions="End" VerticalOptions="Start"><Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" /></Border>
                        <Label Grid.Row="1" Text="მოდულების დიაგნოსტიკა" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="ABS, საჭე, ბატარეა — ცოცხალი მონაცემები" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Grid.Row="0" Style="{StaticResource ListCardStyle}" Padding="12,11">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPrePurchaseTapped" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M5,12 L9,16 L19,6" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Border Style="{StaticResource ProBadgeStyle}" IsVisible="{Binding ShowProBadges}" HorizontalOptions="End" VerticalOptions="Start"><Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" /></Border>
                        <Label Grid.Row="1" Text="ყიდვისწინა შემოწმება" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="მანქანის შეფასება ყიდვამდე" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
                <Border Grid.Column="0" Grid.Row="1" Style="{StaticResource ListCardStyle}" Padding="12,11">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToMileageCommand}" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M4,19 L20,19 M6,19 L6,10 M12,19 L12,5 M18,19 L18,13" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Border Style="{StaticResource ProBadgeStyle}" IsVisible="{Binding ShowProBadges}" HorizontalOptions="End" VerticalOptions="Start"><Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" /></Border>
                        <Label Grid.Row="1" Text="გარბენის გადამოწმება" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="ოდომეტრის შედარება მოდულებთან" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
                <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource ListCardStyle}" Padding="12,11">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToFuelCommand}" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M5,20 L5,5 L13,5 L13,20 Z M5,11 L13,11 M13,8 L17,11 L17,17 C17,19 19,19 19,17 L19,9" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Border Style="{StaticResource ProBadgeStyle}" IsVisible="{Binding ShowProBadges}" HorizontalOptions="End" VerticalOptions="Start"><Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" /></Border>
                        <Label Grid.Row="1" Text="საწვავის ხარჯი" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="რეალური ხარჯი მგზავრობისას" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Features grouped as lists (diagnostics / data / service); rarely used tools fold under "Technical". -->
            <Label Text="დიაგნოსტიკა" Style="{StaticResource SectionCaptionStyle}" Margin="2,6,0,0" />
            <Border Style="{StaticResource ListCardStyle}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid IsEnabled="{Binding IsConnected}" Opacity="0.4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,10" BackgroundColor="Transparent">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToTroubleCodesCommand}" /></Grid.GestureRecognizers>
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Path Data="M12,4 L21,19 L3,19 Z M12,10 L12,14 M12,16.5 L12,16.6" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="შეცდომების სკანი" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                                <Label Text="ძრავის შეცდომები და მათი წაშლა" FontSize="11.5" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="58,0,0,0" />
                    <Grid IsEnabled="{Binding IsConnected}" Opacity="0.4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,10" BackgroundColor="Transparent">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToVehicleHealthCommand}" /></Grid.GestureRecognizers>
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Path Data="M12,20 C5,15 3,11 3,8 C3,5 5,3 8,3 C10,3 11,4 12,6 C13,4 14,3 16,3 C19,3 21,5 21,8 C21,11 19,15 12,20 Z" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="მანქანის ჯანმრთელობა" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                                <Label Text="ქულა და მოკლე შეჯამება" FontSize="11.5" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="58,0,0,0" />
                    <Grid IsEnabled="{Binding IsConnected}" Opacity="0.4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,10" BackgroundColor="Transparent">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToLiveDataCommand}" /></Grid.GestureRecognizers>
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Path Data="M3,12 L7,12 L10,5 L14,19 L17,12 L21,12" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="ცოცხალი მონაცემები" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                                <Label Text="სიჩქარე, ტემპერატურა, ბრუნები" FontSize="11.5" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Label Text="სერვისი" Style="{StaticResource SectionCaptionStyle}" Margin="2,6,0,0" />
            <Border Style="{StaticResource ListCardStyle}" Padding="0">
                <VerticalStackLayout Spacing="0">
                    <Grid IsEnabled="{Binding IsConnected}" Opacity="0.4" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,10" BackgroundColor="Transparent">
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Grid.Triggers>
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToServiceCommand}" /></Grid.GestureRecognizers>
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Path Data="M14,4 L20,10 L11,19 L5,19 L5,13 Z" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="სერვისი" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                                <Label Text="ზეთი, ფილტრები, შეხსენებები" FontSize="11.5" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="58,0,0,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,10" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToDiagnosticReportCommand}" /></Grid.GestureRecognizers>
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Path Data="M6,3 L14,3 L19,8 L19,21 L6,21 Z M14,3 L14,8 L19,8 M9,13 L16,13 M9,17 L16,17" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="ანგარიში" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                                <Label Text="ყველა შემოწმება ერთად · PDF, QR" FontSize="11.5" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="58,0,0,0" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,10" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToVehicleJournalCommand}" /></Grid.GestureRecognizers>
                        <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                            <Path Data="M4,15 L6,9 L18,9 L20,15 L20,19 L4,19 Z M7,19 L7,21 M17,19 L17,21 M7,15 L9,15 M15,15 L17,15" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="მანქანის ანგარიში" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                                <Label Text="გარბენი, მგზავრობები, ECU · ტექსტური ფაილი" FontSize="11.5" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource ListCardStyle}" Padding="0" Margin="0,4,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="12,10" BackgroundColor="Transparent">
                    <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToAllToolsCommand}" /></Grid.GestureRecognizers>
                    <Border WidthRequest="34" HeightRequest="34" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Center">
                        <Path Data="M4,4 L10,4 L10,10 L4,10 Z M14,4 L20,4 L20,10 L14,10 Z M4,14 L10,14 L10,20 L4,20 Z M14,14 L20,14 L20,20 L14,20 Z" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="ყველა ხელსაწყო" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource Primary}" LineBreakMode="TailTruncation" />
                        <Label Text="15 ხელსაწყო · პარამეტრებიც აქ" FontSize="11.5" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                </Grid>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,6" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
