<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.HomePage"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="OBD360">

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

            <!-- Top bar: back to start (OBD2 / VIN) · brand · PRO · language · account -->
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                <Border WidthRequest="24" HeightRequest="34" BackgroundColor="Transparent" StrokeThickness="0" VerticalOptions="Center" SemanticProperties.Description="Back">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackToStartTapped" />
                    </Border.GestureRecognizers>
                    <Path Data="M15,5 L8,12 L15,19" Stroke="{DynamicResource Primary}" StrokeThickness="2.2" StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                </Border>
                <Image Grid.Column="1" Source="obd360_mark.png" WidthRequest="38" HeightRequest="28" Aspect="AspectFit" VerticalOptions="Center" SemanticProperties.Description="OBD360" />
                <Label Grid.Column="2" Text="OBD360" FontSize="17" FontAttributes="Bold" LineBreakMode="NoWrap" MaxLines="1" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                <Button Grid.Column="3" Text="{Binding ProButtonText}" Command="{Binding GoToProCommand}" BackgroundColor="{DynamicResource ProBadgeBg}" TextColor="{DynamicResource ProBadgeText}" BorderWidth="0" CornerRadius="18" Padding="12,0" HeightRequest="36" MinimumHeightRequest="36" MinimumWidthRequest="0" FontAttributes="Bold" FontSize="12" LineBreakMode="NoWrap" HorizontalOptions="End" VerticalOptions="Center" />
                <!-- Language · Settings · Account in one capsule -->
                <Border Grid.Column="4" StrokeShape="RoundRectangle 18" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" BackgroundColor="{DynamicResource CardBg}" Padding="0" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="0">
                        <Button x:Name="LanguageToggleButton" Text="EN" Command="{Binding ToggleLanguageCommand}" SemanticProperties.Description="Language" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderWidth="0" CornerRadius="18" Padding="0" WidthRequest="36" HeightRequest="36" MinimumWidthRequest="36" MinimumHeightRequest="36" FontSize="14" FontAttributes="Bold" />
                        <Border WidthRequest="36" HeightRequest="36" BackgroundColor="Transparent" StrokeThickness="0" SemanticProperties.Description="Settings">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoToSettingsCommand}" />
                            </Border.GestureRecognizers>
                            <Path Data="M19.14,12.94 C19.18,12.64 19.2,12.33 19.2,12 C19.2,11.68 19.18,11.36 19.13,11.06 L21.16,9.48 C21.34,9.34 21.39,9.07 21.28,8.87 L19.36,5.55 C19.24,5.33 18.99,5.26 18.77,5.33 L16.38,6.29 C15.88,5.91 15.35,5.59 14.76,5.35 L14.4,2.81 C14.36,2.57 14.16,2.4 13.92,2.4 L10.08,2.4 C9.84,2.4 9.65,2.57 9.61,2.81 L9.25,5.35 C8.66,5.59 8.12,5.92 7.63,6.29 L5.24,5.33 C5.02,5.25 4.77,5.33 4.65,5.55 L2.74,8.87 C2.62,9.08 2.66,9.34 2.86,9.48 L4.89,11.06 C4.84,11.36 4.8,11.69 4.8,12 C4.8,12.31 4.82,12.64 4.87,12.94 L2.84,14.52 C2.66,14.66 2.61,14.93 2.72,15.13 L4.64,18.45 C4.76,18.67 5.01,18.74 5.23,18.67 L7.62,17.71 C8.12,18.09 8.65,18.41 9.24,18.65 L9.6,21.19 C9.65,21.43 9.84,21.6 10.08,21.6 L13.92,21.6 C14.16,21.6 14.36,21.43 14.39,21.19 L14.75,18.65 C15.34,18.41 15.88,18.09 16.37,17.71 L18.76,18.67 C18.98,18.75 19.23,18.67 19.35,18.45 L21.27,15.13 C21.39,14.91 21.34,14.66 21.15,14.52 L19.14,12.94 Z M12,15.6 C10.02,15.6 8.4,13.98 8.4,12 C8.4,10.02 10.02,8.4 12,8.4 C13.98,8.4 15.6,10.02 15.6,12 C15.6,13.98 13.98,15.6 12,15.6 Z" Fill="{DynamicResource TextColor}" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                        </Border>
                        <Border WidthRequest="36" HeightRequest="36" BackgroundColor="Transparent" StrokeThickness="0" SemanticProperties.Description="Account">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAccountTapped" />
                            </Border.GestureRecognizers>
                            <Path Data="M12,12 A4,4 0 1 0 12,4 A4,4 0 1 0 12,12 M4,21 C4,17 8,15 12,15 C16,15 20,17 20,21" Stroke="{DynamicResource TextColor}" StrokeThickness="1.7" StrokeLineCap="Round" WidthRequest="18" HeightRequest="18" Aspect="Uniform" HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True" />
                        </Border>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Connection -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BeginConnectionCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding StatusColor}" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="დაკავშირება" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                        <Label AutomationId="ConnectionStatusLabel" Text="{Binding ConnectionStatus}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Image Grid.Column="2" IsVisible="{Binding IsConnected}" Source="{Binding ConnectedBrandImage}" WidthRequest="40" HeightRequest="40" Aspect="AspectFit" VerticalOptions="Center" />
                    <controls:Icon Grid.Column="2" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" IsVisible="False">
                        <controls:Icon.Triggers>
                            <DataTrigger TargetType="controls:Icon" Binding="{Binding IsConnected}" Value="False">
                                <Setter Property="IsVisible" Value="True" />
                            </DataTrigger>
                        </controls:Icon.Triggers>
                    </controls:Icon>
                </Grid>
            </Border>

            <!-- Vehicle -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                <VerticalStackLayout Spacing="4">
                    <Label AutomationId="DynamicTextVehicle" Text="{Binding VehicleName}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="TailTruncation" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label AutomationId="DynamicTextVin" Text="{Binding VinNumber}" FontSize="12" FontFamily="monospace" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                        <!-- Copy the VIN (shown only when a real VIN was read) -->
                        <Border x:Name="CopyVinButton" Grid.Column="1" IsVisible="{Binding HasCopyableVin}" Padding="8,3" BackgroundColor="Transparent" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 8" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnCopyVinTapped" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="4" InputTransparent="True">
                                <Path x:Name="CopyVinIcon" Data="M9,9 L20,9 L20,20 L9,20 Z M5,15 L5,4 L16,4" Stroke="{DynamicResource Primary}" StrokeThickness="1.7" StrokeLineJoin="Round" WidthRequest="12" HeightRequest="12" Aspect="Uniform" VerticalOptions="Center" />
                                <Label x:Name="CopyVinLabel" Text="copy" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="2" Margin="0,4,0,0">
                        <Label AutomationId="DynamicTextTrimLabel" Text="{Binding TrimLabel}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                        <Label AutomationId="DynamicTextTrim" Grid.Column="1" Text="{Binding VehicleTrim}" FontSize="12" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                        <Label AutomationId="DynamicTextFuelLabel" Grid.Row="1" Text="{Binding FuelLabel}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                        <Label AutomationId="DynamicTextFuel" Grid.Row="1" Grid.Column="1" Text="{Binding FuelType}" FontSize="12" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="End" LineBreakMode="TailTruncation" />
                    </Grid>
                    <Button Text="განახლება" Command="{Binding RefreshVehicleIdentityCommand}" IsVisible="{Binding IsConnected}" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderWidth="0" Padding="0" HeightRequest="44" MinimumHeightRequest="44" FontSize="12" FontAttributes="Bold" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <!-- AI: ask a question right here (PRO). The send button says "PRO" until PRO is active. -->
            <VerticalStackLayout Spacing="8" IsEnabled="{Binding IsConnected}" Opacity="0.45">
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>
                <Border BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 24" Padding="14,3,5,3">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <!-- Chat bubble with a pulse line: "talk about the car" -->
                        <Path Data="M4,5 L20,5 L20,16 L10,16 L6,20 L6,16 L4,16 Z M7,11 L9.5,11 L11.5,8 L13.5,13.5 L15,11 L17,11" Stroke="{DynamicResource Primary}" StrokeThickness="1.8" StrokeLineCap="Round" StrokeLineJoin="Round" WidthRequest="20" HeightRequest="20" Aspect="Uniform" VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding AiQuestion}" Placeholder="ჰკითხე AI-ს: რა სჭირს მანქანას?" PlaceholderColor="{DynamicResource SubTextColor}" TextColor="{DynamicResource TextColor}" FontSize="14" ReturnType="Send" ReturnCommand="{Binding AskAiCommand}" BackgroundColor="Transparent" VerticalOptions="Center" />
                        <Button Grid.Column="2" Text="PRO" IsVisible="{Binding ShowProBadges}" Command="{Binding AskAiCommand}" BackgroundColor="{DynamicResource Primary}" TextColor="White" FontAttributes="Bold" FontSize="13" CornerRadius="18" HeightRequest="36" MinimumHeightRequest="36" MinimumWidthRequest="36" Padding="12,0" BorderWidth="0" VerticalOptions="Center" />
                        <controls:IconButton Grid.Column="2" IsVisible="{Binding HasProAccess}" Kind="send" Tint="White" BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 18" WidthRequest="36" HeightRequest="36" IconSize="18" Command="{Binding AskAiCommand}" SemanticProperties.Description="Send" VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- PRO tiles 2 x 2 -->
            <controls:FlowGrid Columns="2" ColumnSpacing="8" RowSpacing="8" Opacity="0.45">
                <controls:FlowGrid.Triggers>
                    <DataTrigger TargetType="controls:FlowGrid" Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Opacity" Value="1" />
                    </DataTrigger>
                </controls:FlowGrid.Triggers>
                <Border Style="{StaticResource ListCardStyle}" Padding="12,11">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToModulesCommand}" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M4,8 L4,4 L8,4 M16,4 L20,4 L20,8 M20,16 L20,20 L16,20 M8,20 L4,20 L4,16 M8,12 L16,12" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Border Style="{StaticResource ProBadgeStyle}" IsVisible="{Binding ShowProBadges}" HorizontalOptions="End" VerticalOptions="Start"><Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" /></Border>
                        <Label Grid.Row="1" Text="მოდულების დიაგნოსტიკა" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="ABS, საჭე, ბატარეა — ცოცხალი მონაცემები" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ListCardStyle}" Padding="12,11">
                    <Border.GestureRecognizers><TapGestureRecognizer Tapped="OnPrePurchaseTapped" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M5,12 L9,16 L19,6" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Border Style="{StaticResource ProBadgeStyle}" IsVisible="{Binding ShowProBadges}" HorizontalOptions="End" VerticalOptions="Start"><Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" /></Border>
                        <Label Grid.Row="1" Text="ყიდვისწინა შემოწმება" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="მანქანის შეფასება ყიდვამდე" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ListCardStyle}" Padding="12,11">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToMileageCommand}" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M4,19 L20,19 M6,19 L6,10 M12,19 L12,5 M18,19 L18,13" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Border Style="{StaticResource ProBadgeStyle}" IsVisible="{Binding ShowProBadges}" HorizontalOptions="End" VerticalOptions="Start"><Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" /></Border>
                        <Label Grid.Row="1" Text="გარბენის გადამოწმება" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="ოდომეტრის შედარება მოდულებთან" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ListCardStyle}" Padding="12,11" IsVisible="{Binding IsAdmin}">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToResearchCommand}" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M11,19 A8,8 0 1 1 11,3 A8,8 0 0 1 11,19 M16.65,16.65 L21,21" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Label Grid.Row="1" Text="კვლევა" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="დაუდასტურებელი სიგნალების შემოწმება" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource ListCardStyle}" Padding="12,11">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToFuelCommand}" /></Border.GestureRecognizers>
                    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                        <Path Data="M5,20 L5,5 L13,5 L13,20 Z M5,11 L13,11 M13,8 L17,11 L17,17 C17,19 19,19 19,17 L19,9" Style="{StaticResource RowIconStyle}" Stroke="{DynamicResource Primary}" HorizontalOptions="Start" />
                        <Border Style="{StaticResource ProBadgeStyle}" IsVisible="{Binding ShowProBadges}" HorizontalOptions="End" VerticalOptions="Start"><Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" /></Border>
                        <Label Grid.Row="1" Text="საწვავის ხარჯი" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" Margin="0,4,0,0" />
                        <Label Grid.Row="2" Text="რეალური ხარჯი მგზავრობისას" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>
            </controls:FlowGrid>

            <!-- All tools on the home page: groups of tiles, three per row (the separate "All tools" page is no longer linked). -->
            <Label Text="დიაგნოსტიკა" Style="{StaticResource SectionCaptionStyle}" Margin="2,6,0,0" />
            <controls:FlowGrid Columns="3" ColumnSpacing="8" RowSpacing="8">
                    <Border Style="{StaticResource ListCardStyle}" Padding="6,12,6,10" Opacity="0.4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToTroubleCodesCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                <Path Data="M12,4 L21,19 L3,19 Z M12,10 L12,14 M12,16.5 L12,16.6" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="შეცდომების სკანი" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Start" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="34" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource ListCardStyle}" Padding="6,12,6,10" Opacity="0.4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToVehicleHealthCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                <Path Data="M12,20 C5,15 3,11 3,8 C3,5 5,3 8,3 C10,3 11,4 12,6 C13,4 14,3 16,3 C19,3 21,5 21,8 C21,11 19,15 12,20 Z" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="მანქანის ჯანმრთელობა" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Start" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="34" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource ListCardStyle}" Padding="6,12,6,10" Opacity="0.4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToLiveDataCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                <Path Data="M3,12 L7,12 L10,5 L14,19 L17,12 L21,12" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="ცოცხალი მონაცემები" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Start" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="34" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource ListCardStyle}" Padding="6,12,6,10" Opacity="0.4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToSensorsCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                <Path Data="M10,5 A2,2 0 0 1 14,5 L14,13.5 A4,4 0 1 1 10,13.5 Z M12,9 L12,16.5" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="სენსორები" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Start" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="34" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource ListCardStyle}" Padding="6,12,6,10" Opacity="0.4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToEmissionsCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                <Path Data="M3,11 L11,11 L11,16 L3,16 M13,13.5 A2,2 0 1 0 17,13.5 A2,2 0 1 0 13,13.5 M17.5,8.5 A1.5,1.5 0 1 0 20.5,8.5 A1.5,1.5 0 1 0 17.5,8.5" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="ემისია" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Start" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="34" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Style="{StaticResource ListCardStyle}" Padding="6,12,6,10" Opacity="0.4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToFreezeFrameCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
                                <Path Data="M12,3 L12,21 M5,7.5 L19,16.5 M5,16.5 L19,7.5 M9.5,4.5 L12,7 L14.5,4.5 M9.5,19.5 L12,17 L14.5,19.5" Style="{StaticResource RowIconStyle}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label Text="Freeze Frame" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" HorizontalTextAlignment="Center" VerticalTextAlignment="Start" MaxLines="2" LineBreakMode="TailTruncation" HeightRequest="34" />
                        </VerticalStackLayout>
                    </Border>
            </controls:FlowGrid>
            <Label Text="ტექნიკური" Style="{StaticResource SectionCaptionStyle}" Margin="2,6,0,0" />
            <controls:FlowGrid Columns="3" ColumnSpacing="8" RowSpacing="8">
                    <Border Style="{StaticResource ListCardStyle}" Padding="6,12,6,10" Opacity="0.4">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsConnected}" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToEcuCommand}" /></Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                            <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource PageBg}" StrokeThickness="0" StrokeShape="RoundRectangle 12" HorizontalOptions="Center">
