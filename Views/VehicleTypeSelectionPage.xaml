<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:CarScanner.ViewModels" x:Class="CarScanner.Views.VehicleTypeSelectionPage" x:DataType="vm:VehicleTypeSelectionViewModel" Title="ავტომობილის ტიპი" BackgroundColor="{DynamicResource PageBg}">
    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">
            <VerticalStackLayout Spacing="4">
                <Label Text="აირჩიე ავტომობილის ტიპი" Style="{StaticResource PageTitleStyle}" />
                <Label Text="ერთ აპში მანქანა, მოტოციკლი, სკუტერი და მოპედი." FontSize="13" TextColor="{DynamicResource SubTextColor}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="Car" /></Grid.GestureRecognizers>
                        <Path Data="M3,17 L3,12 L5.5,6.5 L18.5,6.5 L21,12 L21,17 Z M3,12 L21,12 M7,17 L7,20 M17,17 L17,20" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="ავტომობილი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="Motorcycle" /></Grid.GestureRecognizers>
                        <Path Data="M2,16 A3.5,3.5 0 1 0 9,16 A3.5,3.5 0 1 0 2,16 M15,16 A3.5,3.5 0 1 0 22,16 A3.5,3.5 0 1 0 15,16 M5.5,16 L10,10 L15,10 L18.5,16 M13,6 L16,6 L18.5,16 M10,10 L8,7" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მოტოციკლი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="Scooter" /></Grid.GestureRecognizers>
                        <Path Data="M3,17 A2.5,2.5 0 1 0 8,17 A2.5,2.5 0 1 0 3,17 M16,17 A2.5,2.5 0 1 0 21,17 A2.5,2.5 0 1 0 16,17 M8,17 L16,17 M18.5,17 L15,5 L12,5" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="სკუტერი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="Moped" /></Grid.GestureRecognizers>
                        <Path Data="M2,17 A3,3 0 1 0 8,17 A3,3 0 1 0 2,17 M16,17 A3,3 0 1 0 22,17 A3,3 0 1 0 16,17 M8,17 L12,17 L14,11 L19,17 M14,11 L9,11 M16,6 L18,6 L19,17" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="მოპედი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,15" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers><TapGestureRecognizer Command="{Binding SelectCommand}" CommandParameter="Other" /></Grid.GestureRecognizers>
                        <Path Data="M5,12 L5.01,12 M12,12 L12.01,12 M19,12 L19.01,12" Style="{StaticResource RowIconStyle}" StrokeThickness="3" />
                        <Label Grid.Column="1" Text="სხვა მსუბუქი ტრანსპორტი" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="›" Style="{StaticResource RowChevronStyle}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="მოპედისა და მოტოციკლის დიაგნოსტიკა აქტიურდება მხოლოდ იმ შემთხვევაში, თუ კონკრეტული ტრანსპორტის პროტოკოლი/ადაპტერი/ECU პროფილი ვერიფიცირებულია. დაუდასტურებელ შემთხვევაში აპი აჩვენებს მხარდაჭერის სტატუსს და არ შექმნის ფეიკ მონაცემებს." Style="{StaticResource CaptionStyle}" Margin="4,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
