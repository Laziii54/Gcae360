<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="CarScanner.Views.ContactPage"
    BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">

            <Label Text="Contact" Style="{StaticResource PageTitleStyle}" />
            <Label Text="Send a message directly to the developer." FontSize="13" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />

            <!-- Developer e-mail -->
            <Border Style="{StaticResource ListCardStyle}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,13">
                    <Path Data="M3,6 L21,6 L21,18 L3,18 Z M3,6 L12,13 L21,6" Style="{StaticResource RowIconStyle}" />
                    <Label Grid.Column="1" Text="gcar360support@gmail.com" Style="{StaticResource RowTitleStyle}" />
                </Grid>
            </Border>

            <!-- Message form -->
            <Border Style="{StaticResource ListCardStyle}" Padding="14,6">
                <VerticalStackLayout Spacing="0">
                    <Entry
                        x:Name="SubjectEntry"
                        Placeholder="Subject"
                        TextColor="{DynamicResource TextColor}"
                        PlaceholderColor="{DynamicResource SubTextColor}"
                        BackgroundColor="Transparent"
                        FontSize="14" />
                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" Margin="0,4" />
                    <Editor
                        x:Name="MessageEditor"
                        Placeholder="Write your message…"
                        TextColor="{DynamicResource TextColor}"
                        PlaceholderColor="{DynamicResource SubTextColor}"
                        BackgroundColor="Transparent"
                        FontSize="14"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="180" />
                </VerticalStackLayout>
            </Border>

            <Button
                Text="Send Message"
                Clicked="OnSendClicked"
                Style="{StaticResource PrimaryButtonStyle}"
                CornerRadius="12" />

            <Label
                x:Name="StatusLabel"
                TextColor="#1F8A4C"
                FontSize="13"
                HorizontalTextAlignment="Center"
                LineBreakMode="WordWrap" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
