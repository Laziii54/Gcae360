<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:m="clr-namespace:CarScanner.Models"
    x:Class="CarScanner.Views.CapabilityCenterPage"
    x:DataType="vm:CapabilityCenterViewModel"
    x:Name="CapabilityRoot"
    Title="Vehicle Capabilities"
    BackgroundColor="{DynamicResource PageBg}">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="VEHICLE CAPABILITIES" Style="{StaticResource PageTitleStyle}" />
                <Label IsVisible="False" Text="რეალური ECU კავშირის მიხედვით" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
            </VerticalStackLayout>

            <!-- Detection status -->
            <Label Text="DETECTION STATUS" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">

                    <VerticalStackLayout Spacing="8" Padding="14,13">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <BoxView WidthRequest="10" HeightRequest="10" CornerRadius="5" Color="{Binding DetectionColor}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding ConnectionSummary}" FontSize="15" FontAttributes="Bold" TextColor="{Binding DetectionColor}" LineBreakMode="WordWrap" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding DetectionPercent, StringFormat='{0}%'}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                        </Grid>
                        <ProgressBar HeightRequest="5" Progress="{Binding DetectionProgress}" ProgressColor="{Binding DetectionColor}" BackgroundColor="{DynamicResource DividerColor}" />
                        <Label Text="{Binding DetectionStage}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <!-- Vehicle -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M3,17 L3,12 L5.5,6.5 L18.5,6.5 L21,12 L21,17 Z M3,12 L21,12 M7,17 L7,20 M17,17 L17,20" Style="{StaticResource RowIconStyle}" VerticalOptions="Start" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1">
                            <Label Text="VEHICLE" FontSize="11" TextColor="{DynamicResource SubTextColor}" />
                            <Label Text="{Binding VehicleSummary}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                            <Label Text="{Binding VehicleProfileStatus}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />

                    <!-- Adapter -->
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M8,3 L8,8 M16,3 L16,8 M5,8 L19,8 L19,12 C19,16 16,18 12,18 C8,18 5,16 5,12 Z M12,18 L12,21" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="ADAPTER" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="{Binding AdapterSummary}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="WordWrap" />
                    </Grid>
                    <BoxView IsVisible="False" Style="{StaticResource RowDividerStyle}" />

                    <!-- Protocol -->
                    <Grid IsVisible="False" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12" Padding="14,13">
                        <Path Data="M4,7 L20,7 M4,12 L20,12 M4,17 L14,17" Style="{StaticResource RowIconStyle}" />
                        <Label Grid.Column="1" Text="PROTOCOL" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="2" Text="{Binding Protocol}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <Button Text="შემოწმება" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" CornerRadius="12" />

            <!-- Loading -->
            <Border IsVisible="{Binding IsBusy}" Style="{StaticResource ListCardStyle}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <ActivityIndicator IsRunning="{Binding IsBusy}" Color="{Binding DetectionColor}" WidthRequest="22" HeightRequest="22" VerticalOptions="Center" />
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="Vehicle capabilities მოწმდება..." FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                        <Label Text="{Binding DetectionStage}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Universal OBD-II -->
            <VerticalStackLayout Spacing="2" Margin="0,6,0,0">
                <Label Text="Universal OBD-II" Style="{StaticResource SectionCaptionStyle}" />
                <Label IsVisible="False" Text="სტანდარტული OBD-II შესაძლებლობები, რომლებიც ECU-მ რეალურად დაადასტურა" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="4,0,0,0" />
            </VerticalStackLayout>

            <Border Style="{StaticResource ListCardStyle}">
                <!-- Negative top margin hides the first row's top divider under the card edge -->
                <VerticalStackLayout Spacing="0" Margin="0,-1,0,0" BindableLayout.ItemsSource="{Binding Universal}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:DetectedCapability">
                            <VerticalStackLayout Spacing="0">
                                <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="14,12">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="14" TextColor="{DynamicResource TextColor}" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                        <Label IsVisible="False" Text="{Binding Evidence}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding StateText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StateColor}"
                                           HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="105" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- PRO Analytics -->
            <VerticalStackLayout Spacing="2" Margin="0,6,0,0">
                <Label Text="PRO Analytics" Style="{StaticResource SectionCaptionStyle}" />
                <Label IsVisible="False" Text="ფუნქციები ხელმისაწვდომია მხოლოდ მაშინ, როცა საჭირო რეალური telemetry არსებობს" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="4,0,0,0" />
            </VerticalStackLayout>

            <Border Style="{StaticResource ListCardStyle}">
                <!-- Negative top margin hides the first row's top divider under the card edge -->
                <VerticalStackLayout Spacing="0" Margin="0,-1,0,0" BindableLayout.ItemsSource="{Binding Pro}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:DetectedCapability">
                            <VerticalStackLayout Spacing="0">
                                <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="14,12">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="14" TextColor="{DynamicResource TextColor}" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                        <Label IsVisible="False" Text="{Binding Evidence}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding StateText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StateColor}"
                                           HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="105" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <!-- Manufacturer Specific -->
            <VerticalStackLayout Spacing="2" Margin="0,6,0,0">
                <Label Text="Manufacturer Specific" Style="{StaticResource SectionCaptionStyle}" />
                <Label IsVisible="False" Text="ABS, SRS, BCM, Coding და სხვა OEM ფუნქციები მხოლოდ დადასტურებული ECU კავშირისას" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" Margin="4,0,0,0" />
            </VerticalStackLayout>

            <Border Style="{StaticResource ListCardStyle}">
                <!-- Negative top margin hides the first row's top divider under the card edge -->
                <VerticalStackLayout Spacing="0" Margin="0,-1,0,0" BindableLayout.ItemsSource="{Binding Manufacturer}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:DetectedCapability">
                            <VerticalStackLayout Spacing="0">
                                <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="14,12">
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" FontSize="14" TextColor="{DynamicResource TextColor}" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                        <Label IsVisible="False" Text="{Binding Evidence}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding StateText}" FontSize="12" FontAttributes="Bold" TextColor="{Binding StateColor}"
                                           HorizontalTextAlignment="End" VerticalOptions="Center" LineBreakMode="WordWrap" MaximumWidthRequest="105" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>