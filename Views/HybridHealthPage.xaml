<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    x:Class="CarScanner.Views.HybridHealthPage"
    x:DataType="vm:HybridHealthViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="ელექტრო / ჰიბრიდის ჯანმრთელობა">

    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">
            <VerticalStackLayout Spacing="2">
                <Label Text="ელექტრო / ჰიბრიდის ჯანმრთელობა" Style="{StaticResource PageTitleStyle}" />
                <Label Text="{Binding VehicleName}" Style="{StaticResource CaptionStyle}" />
            </VerticalStackLayout>

            <Button Text="HV ბატარეის / BMS შემოწმება" Command="{Binding ScanCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PrimaryButtonStyle}" />

            <Border IsVisible="{Binding IsBusy}" Style="{StaticResource ListCardStyle}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <ActivityIndicator IsRunning="True" />
                    <Label Text="{Binding ScanStage}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ListCardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="HYBRID BATTERY HEALTH SCORE" FontSize="11" TextColor="{DynamicResource SubTextColor}" />
                    <Label Text="{Binding ScoreText}" FontSize="34" FontAttributes="Bold" TextColor="{Binding ScoreColor}" />
                    <Label Text="{Binding RatingText}" FontSize="14" FontAttributes="Bold" TextColor="{Binding ScoreColor}" />
                    <Label Text="ქულა ჩნდება მხოლოდ მანქანიდან მიღებული მონაცემების საფუძველზე." Style="{StaticResource CaptionStyle}" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <Label Text="რეალური მონაცემები" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="14,12" ColumnSpacing="10">
                        <Label Text="უჯრედების ძაბვის სხვაობა" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="1" Text="{Binding CellDeltaText}" FontAttributes="Bold" TextColor="{Binding ScoreColor}" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding CellRangeText}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="14,12" ColumnSpacing="10">
                        <Label Text="ბატარეის ტემპერატურა" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="1" Text="{Binding TemperatureText}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TemperatureRangeText}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDividerStyle}" />
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" Padding="14,12" ColumnSpacing="10">
                        <Label Text="სავარაუდო დარჩენილი სიცოცხლე" Style="{StaticResource RowTitleStyle}" />
                        <Label Grid.Column="1" Text="{Binding RemainingLifeText}" FontAttributes="Bold" />
                        <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding RemainingLifeSource}" Style="{StaticResource CaptionStyle}" Margin="0,3,0,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource ListCardStyle}" Padding="14">
                <VerticalStackLayout Spacing="7">
                    <Label Text="ვალიდაციის სტატუსი" FontSize="13" FontAttributes="Bold" />
                    <Label Text="{Binding ValidationStatus}" FontSize="12" TextColor="#F59E0B" LineBreakMode="WordWrap" />
                    <Label Text="{Binding EvidenceText}" FontSize="10" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Label Text="უსაფრთხოება: იგზავნება მხოლოდ read-only მოთხოვნები. აპი არ აკეთებს HV ბატარეის reset-ს, coding-ს ან actuator test-ს." Style="{StaticResource CaptionStyle}" Margin="4,0" />
            <Label Text="{Binding ScanStage}" IsVisible="{Binding HasResult}" Style="{StaticResource CaptionStyle}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
