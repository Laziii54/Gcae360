<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:m="clr-namespace:CarScanner.Models"
    x:Class="CarScanner.Views.PrePurchaseAiPage"
    x:DataType="vm:PrePurchaseAiViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="AI კონსულტაცია">

    <Grid RowDefinitions="*,Auto">
        <ScrollView x:Name="ChatScroll">
            <VerticalStackLayout Padding="16,12,16,16" Spacing="12">
                <VerticalStackLayout Spacing="2">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label AutomationId="DynamicTextPrePurchaseAiTitle" Text="{Binding PageTitle}"
                               Style="{StaticResource PageTitleStyle}" VerticalOptions="Center" />
                        <Border Grid.Column="1" Style="{StaticResource ProBadgeStyle}">
                            <Label Text="PRO" Style="{StaticResource ProBadgeTextStyle}" />
                        </Border>
                    </Grid>
                    <Label AutomationId="DynamicTextPrePurchaseAiSubtitle" Text="{Binding Subtitle}"
                           TextColor="{DynamicResource SubTextColor}" FontSize="12" LineBreakMode="WordWrap" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Messages}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:PrePurchaseChatMessage">
                            <Grid>
                                <!-- AI: flat card, left aligned -->
                                <Border IsVisible="{Binding IsAi}" Padding="14,12" Margin="0,0,36,0"
                                        Style="{StaticResource ListCardStyle}" HorizontalOptions="Start">
                                    <Label AutomationId="DynamicTextPrePurchaseAiMessage" Text="{Binding Text}"
                                           TextColor="{DynamicResource TextColor}" FontSize="14" LineBreakMode="WordWrap" />
                                </Border>
                                <!-- User: primary bubble, right aligned -->
                                <Border IsVisible="{Binding IsUser}" Padding="14,10" Margin="60,0,0,0"
                                        BackgroundColor="{DynamicResource Primary}" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                        HorizontalOptions="End">
                                    <Label AutomationId="DynamicTextPrePurchaseUserMessage" Text="{Binding Text}"
                                           TextColor="White" FontSize="14" LineBreakMode="WordWrap" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsThinking}" Margin="4,0">
                    <ActivityIndicator IsRunning="{Binding IsThinking}" Color="{DynamicResource Primary}" HeightRequest="18" WidthRequest="18" />
                    <Label AutomationId="DynamicTextPrePurchaseAiThinking" Text="{Binding ThinkingText}"
                           TextColor="{DynamicResource SubTextColor}" FontSize="12" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Composer -->
        <Border Grid.Row="1" Margin="16,6,16,14" Padding="12,4,6,4" Style="{StaticResource ListCardStyle}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Entry Text="{Binding Input}" Placeholder="{Binding Placeholder}"
                       TextColor="{DynamicResource TextColor}" PlaceholderColor="{DynamicResource SubTextColor}"
                       ReturnCommand="{Binding SendCommand}" FontSize="14" VerticalOptions="Center" />
                <Button Grid.Column="1" AutomationId="DynamicTextPrePurchaseAiSend" Text="{Binding SendText}"
                        Command="{Binding SendCommand}" BackgroundColor="{DynamicResource Primary}" TextColor="White"
                        CornerRadius="10" HeightRequest="38" MinimumHeightRequest="38" Padding="14,0" FontSize="13"
                        FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
