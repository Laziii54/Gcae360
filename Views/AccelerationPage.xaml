<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:m="clr-namespace:CarScanner.Models"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    x:Class="CarScanner.Views.AccelerationPage"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="{Binding AccelerationHeadline}">

    <!-- OBD360 title + Performance Video camera (top-right) -->
    <Shell.TitleView>
        <Grid x:Name="PageTitleView" x:DataType="vm:ShellStatusViewModel" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,10,0">
            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                <Label AutomationId="DynamicTextAccelerationShellTitle" Text="OBD360" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                <Label AutomationId="DynamicTextAccelerationShellVehicle" Text="{Binding VehicleTypeText}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
            </VerticalStackLayout>
            <Border x:Name="CameraButton" Grid.Column="1" WidthRequest="38" HeightRequest="38" Padding="7" VerticalOptions="Center"
                    BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                <controls:CameraIconView IconColor="{DynamicResource TextColor}" InputTransparent="True" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCameraTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label AutomationId="DynamicTextAccelerationHeadline" Text="{Binding AccelerationHeadline}" Style="{StaticResource PageTitleStyle}" />
                <Label AutomationId="DynamicTextAccelerationTestLabel" Text="{Binding AccelerationTestLabel}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                <!-- Text set in code-behind (bilingual) -->
                <Label x:Name="SafetyWarningLabel" AutomationId="DynamicTextAccelerationSafetyWarning" TextColor="#F59E0B" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" Margin="0,4,0,0" />
            </VerticalStackLayout>

            <!-- Live speed + RPM / Throttle / OBD status -->
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout Spacing="0" Padding="16,18,16,14" HorizontalOptions="Center">
                        <Label Text="რეალური OBD სიჩქარე" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />
                        <Label AutomationId="DynamicTextAccelerationSpeed" Text="{Binding AccelerationSpeed}" TextColor="{DynamicResource TextColor}" FontSize="56" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label AutomationId="DynamicTextAccelerationSpeedUnit" Text="{Binding AccelerationSpeedUnit}" TextColor="{DynamicResource SubTextColor}" FontSize="13" HorizontalTextAlignment="Center" />
                        <!-- Adapter speed-sample rate: how accurate the timing can be -->
                        <Label AutomationId="DynamicTextAccelerationRate" Text="{Binding AccelerationRateText}" TextColor="{Binding AccelerationRateColor}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" Margin="0,6,0,0" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="14,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="RPM" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" />
                            <Label AutomationId="DynamicTextAccelerationRpm" Text="{Binding AccelerationRpm}" TextColor="{DynamicResource TextColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                            <Label Text="Throttle" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" />
                            <Label AutomationId="DynamicTextAccelerationThrottle" Text="{Binding AccelerationThrottle}" TextColor="{DynamicResource TextColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                            <Label Text="OBD" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" />
                            <Label AutomationId="DynamicTextAccelerationObdStatus" Text="{Binding AccelerationObdStatus}" TextColor="{Binding AccelerationObdStatusColor}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label IsVisible="False" AutomationId="DynamicTextAccelerationSpeedSource" Text="{Binding AccelerationSpeedSource}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" Margin="14,0,14,12" />
                </VerticalStackLayout>
            </Border>

            <!-- Big state: stop → ready, go! → measuring → result -->
            <Border Padding="14,12" BackgroundColor="{DynamicResource CardBg}" Stroke="{Binding AccelerationPhaseBrush}" StrokeThickness="2" StrokeShape="RoundRectangle 12">
                <Label AutomationId="DynamicTextAccelerationPhase" Text="{Binding AccelerationPhaseText}" TextColor="{Binding AccelerationPhaseColor}" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />
            </Border>

            <!-- Splits -->
            <CollectionView ItemsSource="{Binding AccelerationSplitRows}" HeightRequest="62">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:AccelerationSplitDisplay">
                        <Border Style="{StaticResource ListCardStyle}" Padding="10,8" WidthRequest="76">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding Label}" TextColor="{DynamicResource SubTextColor}" FontSize="12" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding TimeText}" TextColor="{DynamicResource TextColor}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Primary actions -->
            <Button
                AutomationId="DynamicTextAccelerationButton"
                Text="{Binding AccelerationButtonText}"
                Command="{Binding StartAccelerationCommand}"
                IsVisible="{Binding IsAccelerationMeasuring, Converter={StaticResource InverseBoolConverter}}"
                BackgroundColor="{DynamicResource TextColor}" TextColor="{DynamicResource PageBg}" FontAttributes="Bold"
                CornerRadius="12"
                HeightRequest="52" />
            <Button
                Text="STOP TEST"
                Command="{Binding CancelAccelerationCommand}"
                IsVisible="{Binding IsAccelerationMeasuring}"
                Style="{StaticResource DangerButtonStyle}"
                CornerRadius="12"
                HeightRequest="52" />

            <!-- Last result -->
            <Label Text="შედეგები" Style="{StaticResource SectionCaptionStyle}" />
            <Border x:Name="ResultCard" Style="{StaticResource ListCardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="ბოლო შედეგი" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                        <Label Grid.Column="1" Text="OBD360" TextColor="{DynamicResource Primary}" FontSize="12" FontAttributes="Bold" />
                    </Grid>
                    <Label AutomationId="DynamicTextAccelerationVehicle" Text="{Binding AccelerationResultVehicle}" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                    <Label AutomationId="DynamicTextAccelerationResult" Text="{Binding AccelerationResult}" TextColor="{DynamicResource TextColor}" FontSize="26" FontAttributes="Bold" />
                    <Label AutomationId="DynamicTextAccelerationStatus" Text="{Binding AccelerationStatus}" TextColor="{DynamicResource SubTextColor}" FontSize="12" LineBreakMode="WordWrap" />
                    <Label AutomationId="DynamicTextAccelerationMetrics" Text="{Binding AccelerationMetrics}" TextColor="{DynamicResource SubTextColor}" FontSize="12" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <!-- Share the result card as a picture -->
            <Button AutomationId="DynamicTextAccelerationShare" Text="{Binding AccelerationShareText}" Clicked="OnShareResultClicked" BackgroundColor="Transparent" TextColor="{DynamicResource Primary}" BorderColor="{DynamicResource Primary}" BorderWidth="1.5" CornerRadius="12" HeightRequest="44" FontAttributes="Bold" />

            <Border Style="{StaticResource ListCardStyle}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToAccelerationHistoryCommand}" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                    <Path Data="M4,12 A8,8 0 1 0 6.3,6.3 M4,5 L4,9 L8,9 M12,8 L12,12 L15,14" Style="{StaticResource RowIconStyle}" />
                    <Label Grid.Column="1" Text="გაზომვების ისტორია" Style="{StaticResource RowTitleStyle}" FontAttributes="Bold" />
                    <controls:Icon Grid.Column="2" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                </Grid>
            </Border>
            <Border Style="{StaticResource ListCardStyle}">
                <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoToAccelerationLeaderboardCommand}" /></Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="14,13">
                    <Path Data="M7,4 L17,4 L17,9 A5,5 0 0 1 7,9 Z M7,6 L4,6 L4,8 A3,3 0 0 0 7,11 M17,6 L20,6 L20,8 A3,3 0 0 1 17,11 M12,14 L12,17 M9,20 L15,20 M10,17 L14,17 L14,20 L10,20 Z" Style="{StaticResource RowIconStyle}" />
                    <Label Grid.Column="1" Text="{Binding AccelerationRankingRowText}" Style="{StaticResource RowTitleStyle}" FontAttributes="Bold" />
                    <controls:Icon Grid.Column="2" Kind="chevron-right" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                </Grid>
            </Border>

            <!-- Graph -->
            <Label Text="Speed vs Time" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}" Padding="12">
                <controls:TelemetryGraphView Samples="{Binding AccelerationGraphSamples}" Pids="{Binding AccelerationGraphPids}" Title="რეალური Vehicle Speed (PID 01 0D)" HeightRequest="180" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
