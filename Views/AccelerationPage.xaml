<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:m="clr-namespace:CarScanner.Models"
    xmlns:controls="clr-namespace:CarScanner.Controls"
    x:Class="CarScanner.Views.AccelerationPage"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="Performance Lab">

    <!-- GCar360 title + Performance Video camera (top-right) -->
    <Shell.TitleView>
        <Grid x:Name="PageTitleView" x:DataType="vm:ShellStatusViewModel" ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,10,0">
            <VerticalStackLayout VerticalOptions="Center" Spacing="0">
                <Label AutomationId="DynamicTextAccelerationShellTitle" Text="GCar360" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                <Label AutomationId="DynamicTextAccelerationShellVehicle" Text="{Binding VehicleTypeText}" TextColor="{DynamicResource SubTextColor}" FontSize="9" />
            </VerticalStackLayout>
            <Border x:Name="CameraButton" Grid.Column="1" WidthRequest="38" HeightRequest="38" Padding="7" VerticalOptions="Center"
                    BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                <controls:CameraIconView IconColor="{DynamicResource TextColor}" InputTransparent="True" />
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCameraTapped" />
                </Border.GestureRecognizers>
            </Border>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout Padding="16,12,16,32" Spacing="12">

            <!-- Header -->
            <VerticalStackLayout Spacing="2">
                <Label Text="PERFORMANCE LAB" Style="{StaticResource PageTitleStyle}" />
                <Label AutomationId="DynamicTextAccelerationTestLabel" Text="{Binding AccelerationTestLabel}" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
            </VerticalStackLayout>

            <!-- Live speed + RPM / Throttle / OBD status -->
            <Border Style="{StaticResource ListCardStyle}">
                <VerticalStackLayout Spacing="0">
                    <VerticalStackLayout Spacing="0" Padding="16,18,16,14" HorizontalOptions="Center">
                        <Label Text="რეალური OBD სიჩქარე" TextColor="{DynamicResource SubTextColor}" FontSize="11" HorizontalTextAlignment="Center" />
                        <Label AutomationId="DynamicTextAccelerationSpeed" Text="{Binding AccelerationSpeed}" TextColor="{DynamicResource TextColor}" FontSize="56" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label AutomationId="DynamicTextAccelerationSpeedUnit" Text="{Binding AccelerationSpeedUnit}" TextColor="{DynamicResource SubTextColor}" FontSize="13" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="14,12">
                        <VerticalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="RPM" FontSize="11" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" />
                            <Label AutomationId="DynamicTextAccelerationRpm" Text="{Binding AccelerationRpm}" TextColor="{DynamicResource TextColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="2">
                            <Label Text="Throttle" FontSize="11" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" />
                            <Label AutomationId="DynamicTextAccelerationThrottle" Text="{Binding AccelerationThrottle}" TextColor="{DynamicResource TextColor}" FontSize="15" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="2">
                            <Label Text="OBD" FontSize="11" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" />
                            <Label AutomationId="DynamicTextAccelerationObdStatus" Text="{Binding AccelerationObdStatus}" TextColor="{Binding AccelerationObdStatusColor}" FontSize="12" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </Grid>

                    <Label AutomationId="DynamicTextAccelerationSpeedSource" Text="{Binding AccelerationSpeedSource}" TextColor="{DynamicResource SubTextColor}" FontSize="11" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" Margin="14,0,14,12" />
                </VerticalStackLayout>
            </Border>

            <!-- Splits -->
            <CollectionView ItemsSource="{Binding AccelerationSplitRows}" HeightRequest="62">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:AccelerationSplitDisplay">
                        <Border Style="{StaticResource ListCardStyle}" Padding="10,8" WidthRequest="76">
                            <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                                <Label Text="{Binding Label}" TextColor="{DynamicResource SubTextColor}" FontSize="11" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding TimeText}" TextColor="{DynamicResource TextColor}" FontSize="16" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Primary actions -->
            <Button
                AutomationId="DynamicTextAccelerationButton"
                Text="{Binding AccelerationButtonText}"
                Command="{Binding StartAccelerationCommand}"
                IsVisible="{Binding IsAccelerationMeasuring, Converter={StaticResource InverseBoolConverter}}"
                Style="{StaticResource PrimaryButtonStyle}"
                CornerRadius="12"
                HeightRequest="52" />
            <Button
                Text="STOP TEST"
                Command="{Binding CancelAccelerationCommand}"
                IsVisible="{Binding IsAccelerationMeasuring}"
                Style="{StaticResource DangerButtonStyle}"
                CornerRadius="12"
                HeightRequest="52" />

            <!-- Last result -->
            <Label Text="შედეგები" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}" Padding="16,14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="ბოლო შედეგი" TextColor="{DynamicResource SubTextColor}" FontSize="12" />
                    <Label AutomationId="DynamicTextAccelerationResult" Text="{Binding AccelerationResult}" TextColor="{DynamicResource TextColor}" FontSize="26" FontAttributes="Bold" />
                    <Label AutomationId="DynamicTextAccelerationStatus" Text="{Binding AccelerationStatus}" TextColor="{DynamicResource SubTextColor}" FontSize="12" LineBreakMode="WordWrap" />
                    <Label AutomationId="DynamicTextAccelerationMetrics" Text="{Binding AccelerationMetrics}" TextColor="{DynamicResource SubTextColor}" FontSize="11" Margin="0,4,0,0" />
                </VerticalStackLayout>
            </Border>

            <Button Text="გაზომვების ისტორია" Command="{Binding GoToAccelerationHistoryCommand}" BackgroundColor="Transparent" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource TextColor}" BorderWidth="1.5" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" />
            <Button Text="0–100 რეიტინგი" Command="{Binding GoToAccelerationLeaderboardCommand}" Style="{StaticResource PrimaryButtonStyle}" />

            <!-- Graph -->
            <Label Text="Speed vs Time" Style="{StaticResource SectionCaptionStyle}" />
            <Border Style="{StaticResource ListCardStyle}" Padding="12">
                <controls:TelemetryGraphView Samples="{Binding AccelerationGraphSamples}" Pids="{Binding AccelerationGraphPids}" Title="რეალური Vehicle Speed (PID 01 0D)" HeightRequest="180" />
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
