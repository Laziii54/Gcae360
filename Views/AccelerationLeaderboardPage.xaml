<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:CarScanner.Controls"
             xmlns:vm="clr-namespace:CarScanner.ViewModels"
             x:Class="CarScanner.Views.AccelerationLeaderboardPage"
             x:DataType="vm:AccelerationLeaderboardViewModel"
             BackgroundColor="{DynamicResource PageBg}"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <!-- Option in the filter sheet. -->
        <DataTemplate x:Key="FilterOptionTemplate" x:DataType="vm:LeaderboardFilterOption">
            <Border Padding="16,0" HeightRequest="42" Margin="0,0,8,8" StrokeThickness="1.5" StrokeShape="RoundRectangle 21"
                    BackgroundColor="{DynamicResource CardBg}" Stroke="{DynamicResource BorderColor}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="{DynamicResource Primary}" />
                        <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                    </DataTrigger>
                </Border.Triggers>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TapCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding Text}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" TextColor="{DynamicResource TextColor}">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="TextColor" Value="White" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16,14,16,32" Spacing="14">

                <!-- Safety notice (Georgian literal, translated by LocalizationService.Apply) -->
                <Label Text="გაზომე მხოლოდ დახურულ ტრასაზე ან ცარიელ, ლეგალურ ადგილას. დაიცავი მოძრაობის წესები."
                       TextColor="#F59E0B" FontSize="12" FontAttributes="Bold" LineBreakMode="WordWrap" />

                <!-- ===== Title + filter () button ===== -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" />
                        <Label Text="{Binding ActiveFilterText}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource Primary}"
                               LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                    <Grid Grid.Column="1" WidthRequest="50" HeightRequest="50" VerticalOptions="Center">
                        <Border StrokeThickness="1" Stroke="{DynamicResource BorderColor}" BackgroundColor="{DynamicResource CardBg}"
                                StrokeShape="RoundRectangle 14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenFiltersCommand}" />
                            </Border.GestureRecognizers>
                            <Path Data="M5,7 L19,7 M5,12 L19,12 M5,17 L19,17" Stroke="{DynamicResource TextColor}" StrokeThickness="2.2"
                                  StrokeLineCap="Round" HorizontalOptions="Center" VerticalOptions="Center" WidthRequest="24" HeightRequest="24" />
                        </Border>
                        <Border IsVisible="{Binding HasActiveFilters}" WidthRequest="20" HeightRequest="20" StrokeThickness="0"
                                StrokeShape="RoundRectangle 10" BackgroundColor="{DynamicResource Primary}"
                                HorizontalOptions="End" VerticalOptions="Start" Margin="0,-6,-6,0" InputTransparent="True">
                            <Label Text="{Binding ActiveFilterCount}" FontSize="12" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>

                <!-- ===== Podium: places 1–3 (white cards, a small cup on each) ===== -->
                <Grid IsVisible="{Binding HasPodium}" ColumnDefinitions="*,1.1*,*" ColumnSpacing="8" VerticalOptions="End">
                    <!-- 2nd -->
                    <Border Grid.Column="0" VerticalOptions="End" Padding="6,12,6,12" StrokeThickness="1"
                            Stroke="{DynamicResource BorderColor}" BackgroundColor="{DynamicResource CardBg}" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Fill">
                            <Path Data="M7,4 L17,4 L17,9 A5,5 0 0 1 7,9 Z M7,6 L4,6 L4,8 A3,3 0 0 0 7,11 M17,6 L20,6 L20,8 A3,3 0 0 1 17,11 M12,14 L12,17 M9,20 L15,20 M10,17 L14,17 L14,20 L10,20 Z"
                                  Stroke="#8A939D" Fill="#DDE2E7" StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" />
                            <controls:AvatarView Name="{Binding Second.UserName}" AvatarUrl="{Binding Second.AvatarUrl}" Size="38" HorizontalOptions="Center" />
                            <Label Text="{Binding Second.UserName}" FontSize="12.5" FontAttributes="Bold" TextColor="{DynamicResource TextColor}"
                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label Text="{Binding Second.VehicleModel}" FontSize="10.5" TextColor="{DynamicResource SubTextColor}"
                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Second.TimeText}" FontSize="19" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding Second.SecondsUnit}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding Second.VerificationText}" IsVisible="{Binding Second.HasVerification}" FontSize="10" FontAttributes="Bold"
                                   TextColor="{Binding Second.VerificationColor}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 1st -->
                    <Border Grid.Column="1" VerticalOptions="End" Padding="6,16,6,14" StrokeThickness="1.5"
                            Stroke="#E8B323" BackgroundColor="{DynamicResource CardBg}" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Fill">
                            <Path Data="M7,4 L17,4 L17,9 A5,5 0 0 1 7,9 Z M7,6 L4,6 L4,8 A3,3 0 0 0 7,11 M17,6 L20,6 L20,8 A3,3 0 0 1 17,11 M12,14 L12,17 M9,20 L15,20 M10,17 L14,17 L14,20 L10,20 Z"
                                  Stroke="#C99A12" Fill="#F6D86B" StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  WidthRequest="30" HeightRequest="30" Aspect="Uniform" HorizontalOptions="Center" />
                            <controls:AvatarView Name="{Binding First.UserName}" AvatarUrl="{Binding First.AvatarUrl}" Size="44" HorizontalOptions="Center" />
                            <Label Text="{Binding First.UserName}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}"
                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label Text="{Binding First.VehicleModel}" FontSize="10.5" TextColor="{DynamicResource SubTextColor}"
                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding First.TimeText}" FontSize="23" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding First.SecondsUnit}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding First.VerificationText}" IsVisible="{Binding First.HasVerification}" FontSize="10" FontAttributes="Bold"
                                   TextColor="{Binding First.VerificationColor}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 3rd -->
                    <Border Grid.Column="2" VerticalOptions="End" Padding="6,12,6,12" StrokeThickness="1"
                            Stroke="{DynamicResource BorderColor}" BackgroundColor="{DynamicResource CardBg}" StrokeShape="RoundRectangle 14">
                        <VerticalStackLayout Spacing="3" HorizontalOptions="Fill">
                            <Path Data="M7,4 L17,4 L17,9 A5,5 0 0 1 7,9 Z M7,6 L4,6 L4,8 A3,3 0 0 0 7,11 M17,6 L20,6 L20,8 A3,3 0 0 1 17,11 M12,14 L12,17 M9,20 L15,20 M10,17 L14,17 L14,20 L10,20 Z"
                                  Stroke="#A8683A" Fill="#E7B48A" StrokeThickness="1.6" StrokeLineCap="Round" StrokeLineJoin="Round"
                                  WidthRequest="24" HeightRequest="24" Aspect="Uniform" HorizontalOptions="Center" />
                            <controls:AvatarView Name="{Binding Third.UserName}" AvatarUrl="{Binding Third.AvatarUrl}" Size="38" HorizontalOptions="Center" />
                            <Label Text="{Binding Third.UserName}" FontSize="12.5" FontAttributes="Bold" TextColor="{DynamicResource TextColor}"
                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                            <Label Text="{Binding Third.VehicleModel}" FontSize="10.5" TextColor="{DynamicResource SubTextColor}"
                                   HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                            <Label HorizontalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding Third.TimeText}" FontSize="19" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                        <Span Text=" " />
                                        <Span Text="{Binding Third.SecondsUnit}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                            <Label Text="{Binding Third.VerificationText}" IsVisible="{Binding Third.HasVerification}" FontSize="10" FontAttributes="Bold"
                                   TextColor="{Binding Third.VerificationColor}" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- ===== My place ===== -->
                <Border IsVisible="{Binding HasMyPlace}" Padding="16,14" BackgroundColor="{DynamicResource CardBg}"
                        Stroke="{DynamicResource Primary}" StrokeThickness="1.5" StrokeShape="RoundRectangle 16">
                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="2">
                        <Border Grid.RowSpan="2" WidthRequest="52" HeightRequest="52" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{DynamicResource Primary}" VerticalOptions="Center">
                            <Label Text="{Binding MyPlaceRank}" FontSize="17" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="{Binding MyPlaceCaption}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" />
                        <Label Grid.Column="2" Text="{Binding MyPlaceTime}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding MyPlaceDetail}" FontSize="12"
                               TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                    </Grid>
                </Border>

                <Button Text="{Binding PublishText}" Command="{Binding PublishLatestCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="{DynamicResource TextColor}" TextColor="{DynamicResource PageBg}" FontAttributes="Bold" FontSize="13" HeightRequest="48" CornerRadius="12" />
                <Button IsVisible="{Binding HasVideoToSend}" Text="{Binding SendVideoText}" Command="{Binding SendVideoCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" BackgroundColor="Transparent"
                        TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1.5"
                        CornerRadius="14" HeightRequest="46" FontAttributes="Bold" FontSize="13" />
                <Border IsVisible="{Binding NeedsVideo}" Padding="12,10" BackgroundColor="{DynamicResource CardBg}" Stroke="#E0B34A"
                        StrokeThickness="1.5" StrokeShape="RoundRectangle 12">
                    <Label Text="{Binding VideoHintText}" FontSize="12" TextColor="{DynamicResource TextColor}" LineBreakMode="WordWrap" />
                </Border>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" />
                <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{DynamicResource SubTextColor}"
                       HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

                <!-- ===== Places 4+ (or all, when fewer than three) ===== -->
                <Label Text="{Binding ResultsCountText}" Style="{StaticResource SectionCaptionStyle}" IsVisible="{Binding HasAnyResult}" />
                <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasRows}">
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccelerationLeaderboardRow">
                                <VerticalStackLayout Spacing="0">
                                    <VerticalStackLayout.Triggers>
                                        <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding IsMine}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ProBadgeBg}" />
                                        </DataTrigger>
                                    </VerticalStackLayout.Triggers>
                                    <Grid ColumnDefinitions="30,40,*,Auto" ColumnSpacing="10" Padding="14,12">
                                        <Label Text="{Binding Rank}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}"
                                               VerticalOptions="Center" HorizontalTextAlignment="Center" />
                                        <controls:AvatarView Grid.Column="1" Name="{Binding UserName}" AvatarUrl="{Binding AvatarUrl}" Size="38" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="2" Spacing="1" VerticalOptions="Center">
                                            <Label Text="{Binding UserName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding VehicleModel}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding VerificationText}" IsVisible="{Binding HasVerification}" FontSize="12"
                                                   FontAttributes="Bold" TextColor="{Binding VerificationColor}" />
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="3" Spacing="1" VerticalOptions="Center">
                                            <Label HorizontalOptions="End">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding TimeText}" FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                                        <Span Text=" " />
                                                        <Span Text="{Binding SecondsUnit}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label Text="{Binding DateText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalOptions="End" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <BoxView Style="{StaticResource RowDividerStyle}" Margin="94,0,0,0" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasAnyResult, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource ListCardStyle}" Padding="16,22">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding EmptyText}" FontSize="13" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- ===== Rules (collapsible) ===== -->
                <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleRulesCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Path Data="M12,3 L20,6 L20,12 C20,17 16.5,20 12,21 C7.5,20 4,17 4,12 L4,6 Z" Style="{StaticResource RowIconStyle}" VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding RulesTitle}" FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                            <controls:Icon Grid.Column="2" Kind="chevron-down" Tint="{DynamicResource SubTextColor}" WidthRequest="14" HeightRequest="14" />
                        </Grid>
                        <Label IsVisible="{Binding IsRulesOpen}" Text="{Binding RulesText}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ===== Filter sheet ===== -->
        <Grid IsVisible="{Binding IsFilterOpen}">
            <BoxView Color="#000000" Opacity="0.45">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseFiltersCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border VerticalOptions="End" Padding="20,10,20,26" StrokeThickness="0" BackgroundColor="{DynamicResource CardBg}"
                    StrokeShape="RoundRectangle 24,24,0,0">
                <VerticalStackLayout Spacing="16">
                    <BoxView WidthRequest="40" HeightRequest="5" CornerRadius="3" Color="{DynamicResource BorderColor}" HorizontalOptions="Center" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{Binding FilterTitle}" FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{Binding ResetText}" Command="{Binding ResetFiltersCommand}" BackgroundColor="Transparent"
                                TextColor="{DynamicResource Primary}" FontAttributes="Bold" FontSize="13" BorderWidth="0" Padding="0" />
                    </Grid>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding TestSectionText}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding TestOptions}" BindableLayout.ItemTemplate="{StaticResource FilterOptionTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding VehicleSectionText}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding VehicleOptions}" BindableLayout.ItemTemplate="{StaticResource FilterOptionTemplate}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="{Binding PeriodSectionText}" FontSize="12" FontAttributes="Bold" TextColor="{DynamicResource SubTextColor}" />
                        <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding PeriodOptions}" BindableLayout.ItemTemplate="{StaticResource FilterOptionTemplate}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding VerifiedOnlyText}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                            <Label Text="{Binding VerifiedOnlyHint}" FontSize="12" TextColor="{DynamicResource SubTextColor}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding VerifiedOnly}" OnColor="{DynamicResource Primary}" VerticalOptions="Center" />
                    </Grid>

                    <Button Text="{Binding ShowResultsText}" Command="{Binding CloseFiltersCommand}" BackgroundColor="{DynamicResource TextColor}" TextColor="{DynamicResource PageBg}" FontAttributes="Bold" HeightRequest="48" CornerRadius="12" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
