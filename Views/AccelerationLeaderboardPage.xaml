<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CarScanner.ViewModels"
             x:Class="CarScanner.Views.AccelerationLeaderboardPage"
             x:DataType="vm:AccelerationLeaderboardViewModel"
             BackgroundColor="{DynamicResource PageBg}"
             Title="{Binding Title}">
    <ScrollView>
        <VerticalStackLayout Padding="16,14,16,32" Spacing="12">
            <Label Text="{Binding Heading}" Style="{StaticResource PageTitleStyle}" />
            <Label Text="{Binding Subtitle}" FontSize="13" TextColor="{DynamicResource SubTextColor}" Margin="2,-7,2,2" />

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="7">
                <Button Text="{Binding AllText}" Command="{Binding ShowAllCommand}" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="12" HeightRequest="44" FontSize="11" Padding="5,0" />
                <Button Grid.Column="1" Text="{Binding MyModelText}" Command="{Binding ShowMyModelCommand}" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="12" HeightRequest="44" FontSize="11" Padding="5,0" />
                <Button Grid.Column="2" Text="{Binding ThisMonthText}" Command="{Binding ShowThisMonthCommand}" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" BorderColor="{DynamicResource BorderColor}" BorderWidth="1" CornerRadius="12" HeightRequest="44" FontSize="11" Padding="5,0" />
            </Grid>

            <Button Text="{Binding PublishText}" Command="{Binding PublishLatestCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" Style="{StaticResource PrimaryButtonStyle}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{DynamicResource Primary}" />
            <Label Text="{Binding StatusMessage}" FontSize="12" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" LineBreakMode="WordWrap" />

            <Border Style="{StaticResource ListCardStyle}" IsVisible="{Binding HasRows}">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccelerationLeaderboardRow">
                            <VerticalStackLayout Spacing="0">
                                <Grid ColumnDefinitions="42,*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="2" Padding="12,11">
                                    <Label Text="{Binding Rank}" Grid.RowSpan="3" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource Primary}" VerticalOptions="Center" />
                                    <Label Grid.Column="1" Text="{Binding UserName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                    <Label Grid.Column="2" Text="{Binding TimeText}" FontSize="17" FontAttributes="Bold" TextColor="{DynamicResource TextColor}" />
                                    <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding VehicleModel}" FontSize="12" TextColor="{DynamicResource SubTextColor}" LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding VerificationText}" FontSize="10" FontAttributes="Bold" TextColor="{Binding VerificationColor}" />
                                    <Label Grid.Row="2" Grid.Column="2" Text="{Binding DateText}" FontSize="10" TextColor="{DynamicResource SubTextColor}" />
                                </Grid>
                                <BoxView Style="{StaticResource RowDividerStyle}" Margin="42,0,0,0" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>

            <Label IsVisible="{Binding HasRows, Converter={StaticResource InverseBoolConverter}}" Text="{Binding EmptyText}" FontSize="13" TextColor="{DynamicResource SubTextColor}" HorizontalTextAlignment="Center" Margin="0,20" />
            <Border Style="{StaticResource ListCardStyle}" Padding="14,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="🛡" FontSize="18" />
                    <Label Grid.Column="1" Text="{Binding RulesText}" FontSize="11" TextColor="{DynamicResource SubTextColor}" LineBreakMode="WordWrap" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
