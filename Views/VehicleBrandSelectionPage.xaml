<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:CarScanner.ViewModels"
    xmlns:m="clr-namespace:CarScanner.Models"
    x:Class="CarScanner.Views.VehicleBrandSelectionPage"
    x:DataType="vm:VehicleBrandSelectionViewModel"
    BackgroundColor="{DynamicResource PageBg}"
    Title="აირჩიე მარკა">

    <Grid Padding="16,14,16,16" RowDefinitions="Auto,Auto,*" RowSpacing="12">
        <Label Text="აირჩიე მარკა" Style="{StaticResource PageTitleStyle}" />

        <Border Grid.Row="1" Style="{StaticResource ListCardStyle}" Padding="4,0">
            <SearchBar Text="{Binding SearchText}" Placeholder="მოძებნე მარკა" BackgroundColor="{DynamicResource CardBg}" TextColor="{DynamicResource TextColor}" PlaceholderColor="{DynamicResource SubTextColor}" CancelButtonColor="{DynamicResource SubTextColor}" />
        </Border>

        <Border Grid.Row="2" Style="{StaticResource ListCardStyle}">
            <CollectionView ItemsSource="{Binding Brands}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:VehicleBrandProfile">
                        <VerticalStackLayout Spacing="0">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Padding="14,14" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding x:DataType=vm:VehicleBrandSelectionViewModel, Source={RelativeSource AncestorType={x:Type vm:VehicleBrandSelectionViewModel}}, Path=SelectBrandCommand}" CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Label Text="{Binding DisplayName}" Style="{StaticResource RowTitleStyle}" FontSize="15" />
                                <Label Grid.Column="1" Text="›" Style="{StaticResource RowChevronStyle}" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource DividerColor}" Margin="14,0,0,0" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Border>
    </Grid>
</ContentPage>
