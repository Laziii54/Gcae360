<?xml version="1.0" encoding="UTF-8" ?>
<Shell x:DataType="vm:ShellStatusViewModel" x:Class="CarScanner.AppShell" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:views="clr-namespace:CarScanner.Views" xmlns:vm="clr-namespace:CarScanner.ViewModels" Shell.FlyoutBehavior="Disabled" BackgroundColor="{DynamicResource PageBg}" Shell.ForegroundColor="{DynamicResource TextColor}" Shell.TitleColor="{DynamicResource TextColor}">
    <Shell.TitleView>
        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="0" Padding="0,0,8,0">
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                <Label Text="GCar360" TextColor="{DynamicResource TextColor}" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                <Label Text="{Binding VehicleTypeText}" TextColor="#94A3B8" FontSize="9" />
            </VerticalStackLayout>
        </Grid>
    </Shell.TitleView>
    <ShellContent Title="GCar360" Shell.NavBarIsVisible="False" ContentTemplate="{DataTemplate views:StartPage}" Route="StartPage" />
    <ShellContent Title="მთავარი" Shell.NavBarIsVisible="False" ContentTemplate="{DataTemplate views:HomePage}" Route="HomePage" />
</Shell>
